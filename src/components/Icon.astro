const d = paths[name] ?? "";
const filled = ["star", "facebook", "instagram", "linkedin", "youtube", "tiktok", "x-twitter", "bluesky", "pinterest", "heart"].includes(name);
// The Instagram glyph is built from nested ring/hole subpaths (rounded-square
// frame, lens circle, flash dot) — needs evenodd or the holes fill solid.
const fillRule = name === "instagram" ? "evenodd" : undefined;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width={filled ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} fill-rule={fillRule}></path>
</svg>
