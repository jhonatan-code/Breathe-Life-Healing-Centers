---
import { primaryNav, site } from "../config/site";
import Icon from "./Icon.astro";

// Logo: white lockup for the dark header bar.
const logo = "/Asset/Logo/White%20Logo.svg";
---

<header class="site-header on-ink" id="site-header">
  <!-- Top bar: the one piece of sitewide messaging (navigation.md §3) -->
  <div class="topbar">
    <div class="container topbar__row">
      <span class="topbar__msg">
        <Icon name="heart" size={15} /> Admissions open 24/7 — answered by people who’ve been there
      </span>
      <a class="topbar__mail" href={site.emailHref}>{site.email}</a>
    </div>
  </div>

  <div class="container header__row">
    <a class="header__logo" href="/" aria-label={`${site.name} — home`}>
      <img src={logo} alt={site.name} width="180" height="44" />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          primaryNav.map((item) =>
            "groups" in item && item.groups ? (
              <li class="nav__item has-mega">
                <button
                  type="button"
                  class="nav__link nav__toggle"
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {item.label}
                  <Icon name="chevronDown" size={16} />
                </button>
                <div class="mega" role="group" aria-label={item.label}>
                  <div class="mega__inner">
                    {item.groups.map((g) => (
                      <div class="mega__group">
                        <p class="mega__heading">{g.heading}</p>
                        <ul>
                          {g.links.map((l) => (
                            <li>
                              <a href={l.href}>{l.label}</a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                    <div class="mega__group mega__group--cta">
                      <a class="mega__all" href={item.href}>
                        All {item.label} <Icon name="arrowRight" size={16} />
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            ) : (
              <li class="nav__item">
                <a class="nav__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <a class="header__phone" href={site.phoneHref}>
      <Icon name="phone" size={18} />
      <span>{site.phoneDisplay}</span>
    </a>

    <button type="button" class="header__burger" id="nav-burger" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
      <span class="sr-only">Menu</span>
    </button>
  </div>

  <!-- Mobile panel -->
  <div class="mobile-nav" id="mobile-nav" hidden>
    <ul>
      {
        primaryNav.map((item) =>
          "groups" in item && item.groups ? (
            <li>
              <details>
                <summary>{item.label}</summary>
                <div class="mobile-nav__sub">
                  {item.groups.map((g) => (
                    <>
                      <p class="mobile-nav__heading">{g.heading}</p>
                      {g.links.map((l) => (
                        <a href={l.href}>{l.label}</a>
                      ))}
                    </>
                  ))}
                  <a class="mobile-nav__all" href={item.href}>All {item.label}</a>
                </div>
              </details>
            </li>
          ) : (
            <li>
              <a class="mobile-nav__top" href={item.href}>
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>
    <a class="btn btn--primary btn--full" href={site.phoneHref} style="margin-top:1rem;">
      <Icon name="phone" size={18} /> Call 24/7 · {site.phoneDisplay}
    </a>
  </div>
</header>

<!-- Persistent mobile contact (navigation.md §2). Body reserves space for it. -->
<div class="mobile-cta" aria-label="Contact Breathe">
  <a class="mobile-cta__call" href={site.phoneHref}>
    <Icon name="phone" size={18} /> Call 24/7
  </a>
  <a class="mobile-cta__form" href="#verify">Verify insurance</a>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface-ink);
    color: var(--color-on-ink);
  }

  .topbar {
    background: rgba(0, 0, 0, 0.22);
    font-size: var(--text-sm);
  }
  .topbar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
    gap: var(--space-4);
  }
  .topbar__msg {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-on-ink);
  }
  .topbar__msg :global(svg) { color: var(--color-seaglass); }
  .topbar__mail { color: var(--color-on-ink-muted); }
  .topbar__mail:hover { color: #fff; text-decoration: underline; }
  @media (max-width: 767px) {
    .topbar__mail { display: none; }
    .topbar__msg { font-size: var(--text-xs); }
  }

  .header__row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 4.75rem;
  }
  .header__logo { flex: none; }
  .header__logo img { height: 42px; width: auto; }

  .nav { margin-inline: auto; }
  .nav__list { display: flex; list-style: none; gap: var(--space-2); }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 0.9rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-on-ink);
    background: none;
    border: 0;
    cursor: pointer;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
  }
  .nav__link:hover,
  .nav__toggle[aria-expanded="true"] {
    background: rgba(255, 255, 255, 0.1);
  }

  .mega {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    translate: -50% 0;
    min-width: 420px;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
    opacity: 0;
    visibility: hidden;
    translate: -50% 8px;
    transition: opacity var(--dur) var(--ease), translate var(--dur) var(--ease), visibility var(--dur);
  }
  .nav__item.is-open .mega {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
  }
  .mega__inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .mega__group--cta { grid-column: 1 / -1; border-top: 1px solid var(--color-border); padding-top: var(--space-3); }
  .mega__heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-soft);
    margin-bottom: var(--space-3);
  }
  .mega ul { list-style: none; display: flex; flex-direction: column; gap: 0.15rem; }
  .mega a {
    display: block;
    padding: 0.4rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .mega a:hover { background: var(--color-accent-tint); color: var(--color-accent); }
  .mega__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--color-accent) !important;
  }

  .header__phone {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    background: var(--color-on-accent);
    color: var(--color-accent);
    font-weight: 700;
    font-size: var(--text-sm);
    border-radius: var(--radius-pill);
    transition: transform var(--dur-fast) var(--ease);
  }
  .header__phone:hover { transform: translateY(-1px); }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .header__burger span:not(.sr-only) {
    display: block;
    height: 2px;
    width: 24px;
    background: #fff;
    border-radius: 2px;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .header__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .header__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-nav {
    background: var(--color-surface-ink-2);
    padding: var(--space-6) var(--space-6) var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .mobile-nav > ul { list-style: none; display: flex; flex-direction: column; }
  .mobile-nav li { border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .mobile-nav summary,
  .mobile-nav__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.95rem 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-on-ink);
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary::after { content: "+"; font-weight: 400; }
  .mobile-nav details[open] summary::after { content: "–"; }
  .mobile-nav__sub { display: flex; flex-direction: column; padding-bottom: 0.75rem; }
  .mobile-nav__heading {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-on-ink-muted);
    margin: 0.75rem 0 0.25rem;
  }
  .mobile-nav__sub a { padding: 0.55rem 0; color: var(--color-on-ink-muted); font-size: var(--text-base); }
  .mobile-nav__sub a:hover { color: #fff; }
  .mobile-nav__all { color: var(--color-seaglass) !important; font-weight: 600; }

  .mobile-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: none;
    gap: 1px;
    background: var(--color-border);
    box-shadow: 0 -4px 16px rgba(20, 24, 28, 0.12);
  }
  .mobile-cta a {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem;
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .mobile-cta__call { background: var(--color-accent); color: #fff; }
  .mobile-cta__form { background: var(--color-surface); color: var(--color-accent); }

  @media (max-width: 1024px) {
    .nav,
    .header__phone { display: none; }
    .header__burger { display: flex; }
    .header__row { min-height: 4rem; }
  }
  @media (max-width: 767px) {
    .mobile-cta { display: flex; }
  }
</style>

<script>
  // Desktop mega-menu: click + hover to open, Escape / outside / focus-out to close.
  // Never hover-only — the toggle is a real button (navigation.md §4).
  const items = Array.from(document.querySelectorAll<HTMLLIElement>(".nav__item.has-mega"));

  function closeAll(except?: Element) {
    items.forEach((li) => {
      if (li === except) return;
      li.classList.remove("is-open");
      li.querySelector(".nav__toggle")?.setAttribute("aria-expanded", "false");
    });
  }

  items.forEach((li) => {
    const toggle = li.querySelector<HTMLButtonElement>(".nav__toggle");
    toggle?.addEventListener("click", () => {
      const open = li.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
      if (open) closeAll(li);
    });
    li.addEventListener("mouseenter", () => {
      closeAll(li);
      li.classList.add("is-open");
      toggle?.setAttribute("aria-expanded", "true");
    });
    li.addEventListener("mouseleave", () => {
      li.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
    li.addEventListener("focusout", (e) => {
      if (!li.contains(e.relatedTarget as Node)) {
        li.classList.remove("is-open");
        toggle?.setAttribute("aria-expanded", "false");
      }
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".nav__item.has-mega")) closeAll();
  });

  // Mobile panel
  const burger = document.getElementById("nav-burger");
  const panel = document.getElementById("mobile-nav");
  burger?.addEventListener("click", () => {
    const open = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!open));
    if (panel) panel.hidden = open;
  });
</script>
