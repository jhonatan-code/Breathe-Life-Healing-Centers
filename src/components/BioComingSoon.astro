---
/**
 * Visitor-facing empty state for team members whose biography isn't
 * available yet on the official site (checked 2026-09-02). Distinct from
 * ClinicalPlaceholder, which is a loud dev-only QA marker never meant to
 * ship — this renders as a normal, polished piece of UI a client or end
 * user can see. `data-placeholder` kept for grep-ability
 * (`grep -rn "TEAM BIO" src/pages`) without visible dev styling.
 */
import Icon from "./Icon.astro";
---

<div data-placeholder="TEAM BIO" style="text-align:center;padding:40px 24px;background:#F7F5F1;border:1px solid #E2DED7;border-radius:16px;">
  <div style="width:44px;height:44px;margin:0 auto 16px;border-radius:999px;background:#E4EEEC;display:flex;align-items:center;justify-content:center;color:#2C5A64;">
    <Icon name="clipboard" size={20} />
  </div>
  <div style="font-family:'Instrument Sans',sans-serif;font-size:19px;font-weight:600;letter-spacing:-0.01em;color:#16293D;margin-bottom:8px;">Biography Coming Soon</div>
  <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#5B6570;margin:0 auto;max-width:44ch;">We're finalizing this team member's biography, check back soon to learn more about their work at Breathe.</p>
</div>
