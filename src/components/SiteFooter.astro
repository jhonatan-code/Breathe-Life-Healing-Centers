---
/**
 * Interior-page footer — same markup/visual treatment as the homepage
 * footer (dark navy→black gradient, accreditation row, socials), but with
 * real section-overview links instead of the homepage's #anchor scroll links.
 *
 * Every link in "Explore" and "Legal" auto-highlights when it's the current
 * page — no per-page prop needed, since `Astro.url.pathname` is available on
 * every page for free. Section-hub links (e.g. "Programs & Levels of Care")
 * stay highlighted anywhere under that section, not just on the hub page
 * itself, via a prefix match; single-page links (Careers, Terms of Use, …)
 * only match exactly.
 */
import Icon from "./Icon.astro";
import { site, socials } from "../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);

const explore = [
  { label: "Programs & Levels of Care", href: "/programs/" },
  { label: "What We Treat", href: "/what-we-treat/" },
  { label: "Signature Services", href: "/signature-services/" },
  { label: "Admissions", href: "/admissions/" },
  { label: "Blog", href: "/blog/" },
  { label: "About Breathe", href: "/about/" },
  { label: "Careers", href: "/about/careers/" },
];

const legal = [
  { label: "Notice of Privacy Practices", href: "/notice-of-privacy-practices/" },
  { label: "Terms of Use", href: "/terms-of-use/" },
  { label: "Confidentiality Form", href: "/confidentiality-form/" },
];

const accreditations: [string, string, string?][] = [
  // Recovery.com badge removed 2026-09-10 — user call: this claim isn't
  // confirmed by any source in the project docs and shouldn't publish as
  // fact until verified.
  ["/Asset/Accreditations/The%20Joint%20Commission.svg", "The Joint Commission National Quality Approval Gold Seal", "https://breathelifehealingcenters.com/joint-commission/"],
  ["/Asset/Accreditations/Legit.svg", "LegitScript Certified", "https://www.legitscript.com/websites/?checker_keywords=breathelifehealingcenters.com"],
  ["/Asset/Accreditations/Fair%20Care.svg", "Fair Care Promise"],
  ["/Asset/Accreditations/DHCS.svg", "Licensed by the California Department of Health Care Services", "https://www.dhcs.ca.gov/provgovpart/Pages/Licensing_and_Certification_Division.aspx"],
];
---

<footer id="footer" style="background:linear-gradient(180deg,#0F1F2E 0%,#0A141D 55%,#000000 100%);color:#DCE6EF;padding:44px 37px 22px;">
  <div style="max-width:1440px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:32px 40px;padding-bottom:28px;border-bottom:1px solid #22405E;">
      <div>
        <a href="/" style="display:inline-block;">
          <img src="/Asset/Logo/White%20Logo.svg" alt="Breathe Life Healing Centers" style="width:172px;display:block;margin-bottom:18px;" />
        </a>
        <div style="font-family:'Instrument Sans',sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.012em;color:#FFFFFF;margin-bottom:12px;">Contact</div>
        <div style="font-size:16px;line-height:1.75;">
          <a class="footer-link" href={site.emailHref} style="color:#DCE6EF;">{site.email}</a><br />
          <a class="footer-link" href={HREF} style="color:#FFFFFF;font-weight:500;">Call 24/7: {PH}</a><br />
          <span style="color:#B9CBDC;">8060 Melrose Avenue, 3rd Floor, Los Angeles, CA 90046</span>
        </div>
      </div>
      <div>
        <div style="font-family:'Instrument Sans',sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.012em;color:#FFFFFF;margin-bottom:12px;">Explore</div>
        <div style="display:grid;gap:7px;font-size:16px;">
          {explore.map((l) => (
            <a
              class="footer-link"
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              style={`color:${isActive(l.href) ? "#FFFFFF" : "#DCE6EF"};font-weight:${isActive(l.href) ? "600" : "400"};`}
            >{l.label}</a>
          ))}
        </div>
      </div>
      <div>
        <div style="font-family:'Instrument Sans',sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.012em;color:#FFFFFF;margin-bottom:12px;">Legal</div>
        <div style="display:grid;gap:7px;font-size:16px;margin-bottom:14px;">
          {legal.map((l) => (
            <a
              class="footer-link"
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              style={`color:${isActive(l.href) ? "#FFFFFF" : "#DCE6EF"};font-weight:${isActive(l.href) ? "600" : "400"};`}
            >{l.label}</a>
          ))}
        </div>
        <p style="font-family:'Instrument Sans',sans-serif;font-size:11px;line-height:1.7;color:#B9CBDC;margin:0;">Licensed by the California DHCS · 190788AP (exp 9/30/2026) · 190788BP (exp 9/30/2027)</p>
      </div>
      <div>
        <div class="footer-follow-label" style="font-family:'Instrument Sans',sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.012em;color:#FFFFFF;margin-bottom:12px;text-align:right;">Follow Us</div>
        <div class="social-icons" style="display:grid;grid-template-columns:repeat(4,38px);gap:10px;justify-content:end;">
          {socials.map((s) => (
            <a class="social-btn" href={s.href} aria-label={s.label} title={s.label} style="display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:#16293D;color:#DCE6EF;">
              <Icon name={s.icon} size={16} />
            </a>
          ))}
        </div>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:24px 40px;padding:24px 0;border-bottom:1px solid #22405E;">
      {accreditations.map(([src, alt, href]) => (
        href ? (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={alt} style="display:block;">
            <img src={src} alt={alt} loading="lazy" style="height:48px;width:auto;display:block;" />
          </a>
        ) : (
          <img src={src} alt={alt} loading="lazy" style="height:48px;width:auto;display:block;" />
        )
      ))}
    </div>
    <div style="padding-top:18px;display:flex;flex-wrap:wrap;gap:10px 24px;align-items:center;justify-content:space-between;font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.08em;color:#B9CBDC;">
      <span>© Copyright {year} Breathe Life Healing Centers. All Rights Reserved.</span>
      <span>LGBTQIA+-affirming treatment · Los Angeles, California</span>
    </div>
  </div>
</footer>
