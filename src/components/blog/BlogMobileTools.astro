---
/**
 * Under 980px, BlogSidebar.astro hides itself entirely. This is what
 * replaces it: a persistent sticky call bar (the single highest-value
 * conversion element stays reachable no matter how far someone scrolls) plus
 * an "Article tools" button that opens a bottom sheet with the same
 * TOC/insurance/reviews content the desktop rail shows. Matches the
 * approved Artifact preview's mobile behavior exactly.
 */
import { insurers, reviews } from '../../data/home';
import { site } from '../../config/site';
const review = reviews[1] ?? reviews[0];
---

<div class="mobile-call-bar">
  <a class="call" href={site.phoneHref}>Call {site.phoneDisplay}</a>
  <button class="tools" id="open-tools" type="button">Article tools</button>
</div>

<div class="tools-sheet" id="tools-sheet">
  <div class="backdrop" id="sheet-backdrop"></div>
  <div class="sheet" role="dialog" aria-modal="true" aria-label="Article tools">
    <button class="sheet-close" id="sheet-close" aria-label="Close">&times;</button>
    <div class="sheet-handle"></div>
    <div class="sheet-body">
      <div class="side-card">
        <h4>Table of Contents</h4>
        <ul class="toc-list" id="toc-list-mobile"></ul>
      </div>
      <div class="side-card">
        <h4>Coverage</h4>
        <div class="mini-ins-wrap">
          <div class="mini-ins-track no-scrollbar">
            {[...insurers, ...insurers, ...insurers, ...insurers].map((i, k) => (
              <div class="mini-ins-logo" aria-hidden={k >= insurers.length ? 'true' : undefined}>
                <img src={i.src} alt={i.name} loading="lazy" style={`height:${Math.round(i.h * 0.6)}px;`} />
              </div>
            ))}
          </div>
        </div>
        <a class="ins-link" href="/insurance-verification/">Verify your insurance &rarr;</a>
      </div>
      {review && (
        <div class="side-card">
          <h4>What families say</h4>
          <div class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="review-quote">&ldquo;{review.quote.slice(0, 180)}{review.quote.length > 180 ? '…' : ''}&rdquo;</p>
          <div class="review-name">{review.name}, Google review</div>
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .mobile-call-bar { display: none; }
  .tools-sheet { position: fixed; inset: 0; z-index: 80; display: none; }
  .tools-sheet.open { display: block; }
  .tools-sheet .backdrop { position: absolute; inset: 0; background: rgba(20,24,28,.5); }
  .tools-sheet .sheet { position: absolute; left: 0; right: 0; bottom: 0; background: #F7F5F1; border-radius: 18px 18px 0 0; max-height: 80vh; overflow-y: auto; padding: 20px 20px 28px; }
  .sheet-handle { width: 40px; height: 4px; background: #E5E1D8; border-radius: 99px; margin: 0 auto 16px; }
  .sheet-close { position: absolute; top: 16px; right: 18px; background: none; border: 0; font-size: 20px; color: #646D76; cursor: pointer; }
  .sheet-body { display: flex; flex-direction: column; gap: 18px; }
  .side-card { background: #fff; border: 1px solid #E5E1D8; border-radius: 14px; padding: 20px; }
  .side-card h4 { font-family: 'Instrument Sans', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #2C5A64; margin: 0 0 14px; }
  .toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; font-family: 'Montserrat', sans-serif; font-size: 13.5px; }
  .toc-list a { text-decoration: none; color: #3A444D; display: block; padding: 3px 0 3px 12px; border-left: 2px solid #E5E1D8; }
  .toc-list a.active { color: #16293D; font-weight: 600; border-left-color: #33679C; }
  .mini-ins-wrap { -webkit-mask-image: linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); mask-image: linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); }
  .mini-ins-track { display: flex; align-items: center; overflow-x: auto; }
  .mini-ins-track.no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
  .mini-ins-track.no-scrollbar::-webkit-scrollbar { display: none; }
  .mini-ins-logo { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; padding: 0 12px; }
  .mini-ins-logo img { width: auto; max-width: 90px; object-fit: contain; }
  .ins-link { display: block; margin-top: 12px; font-family: 'Instrument Sans', sans-serif; font-size: 13px; font-weight: 600; color: #33679C; text-decoration: none; }
  .review-quote { font-family: 'Montserrat', sans-serif; font-size: 13.5px; line-height: 1.6; color: #3A444D; font-style: italic; margin: 0 0 10px; }
  .review-name { font-family: 'Instrument Sans', sans-serif; font-size: 12px; font-weight: 700; color: #14181C; }
  .stars { color: #E0A93A; font-size: 12px; margin-bottom: 8px; }

  @media (max-width: 980px) {
    .mobile-call-bar {
      display: flex; position: sticky; bottom: 0; z-index: 40; background: #fff; border-top: 1px solid #E5E1D8;
      padding: 12px 16px; gap: 10px; align-items: center; box-shadow: 0 -6px 16px rgba(20,24,28,.06);
    }
    .mobile-call-bar a.call { flex: 1; background: #16293D; color: #fff; text-align: center; padding: 12px; border-radius: 9px; font-family: 'Instrument Sans', sans-serif; font-weight: 700; font-size: 14.5px; text-decoration: none; }
    .mobile-call-bar button.tools { background: #F0F5FA; color: #2C5A64; border: 0; border-radius: 9px; padding: 12px 16px; font-family: 'Instrument Sans', sans-serif; font-weight: 700; font-size: 13px; }
  }
</style>

<script>
  const sheet = document.getElementById('tools-sheet');
  document.getElementById('open-tools')?.addEventListener('click', () => sheet?.classList.add('open'));
  document.getElementById('sheet-close')?.addEventListener('click', () => sheet?.classList.remove('open'));
  document.getElementById('sheet-backdrop')?.addEventListener('click', () => sheet?.classList.remove('open'));
</script>
