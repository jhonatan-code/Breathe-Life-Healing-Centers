---
/**
 * Native share intents only — no third-party embed scripts. `url` must be
 * an absolute URL (share intents don't resolve relative ones).
 */
interface Props {
  url: string;
  title: string;
  variant?: 'dark' | 'light';
}
const { url, title, variant = 'dark' } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class={`share-row variant-${variant}`} aria-label="Share this article">
  <a class="share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" title="Share on Facebook" aria-label="Share on Facebook">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.21 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.21 22 17.08 22 12.06Z"/></svg>
  </a>
  <a class="share-btn" href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" title="Share on X" aria-label="Share on X">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.24 2H21l-6.5 7.43L22.2 22h-6.14l-4.8-6.28L5.7 22H3l7-8L2.2 2h6.3l4.34 5.74L18.24 2Zm-1.08 18h1.7L7.9 3.9H6.1L17.16 20Z"/></svg>
  </a>
  <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" title="Share on LinkedIn" aria-label="Share on LinkedIn">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.15 1.46-2.15 2.96V21h-4V9Z"/></svg>
  </a>
  <a class="share-btn" href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer" title="Share on WhatsApp" aria-label="Share on WhatsApp">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.15-4.9-4.34-.14-.19-1.17-1.56-1.17-2.97 0-1.41.74-2.1 1-2.39.26-.29.57-.36.76-.36h.55c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.15.12.32.02.51-.1.19-.15.31-.3.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.44.29.15.46.13.63-.05.17-.19.72-.84.92-1.13.19-.29.38-.24.64-.15.26.1 1.68.79 1.97.93.29.15.48.22.55.34.07.13.07.71-.17 1.39Z"/></svg>
  </a>
  <button class="share-btn copy-link" data-share-url={url} title="Copy link" aria-label="Copy link" type="button">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3.9 12a5.1 5.1 0 0 1 5.1-5.1h3v1.8h-3a3.3 3.3 0 1 0 0 6.6h3V17h-3A5.1 5.1 0 0 1 3.9 12Zm7.2-1h5.8v2h-5.8v-2ZM12 6.9h3a5.1 5.1 0 1 1 0 10.2h-3v-1.8h3a3.3 3.3 0 1 0 0-6.6h-3V6.9Z"/></svg>
  </button>
</div>

<style>
  .share-row { display: flex; gap: 8px; }
  .share-btn {
    width: 34px; height: 34px; border-radius: 999px; display: flex; align-items: center; justify-content: center;
    text-decoration: none; border: 0; cursor: pointer; font: inherit; padding: 0;
  }
  .variant-dark .share-btn { background: rgba(255,255,255,.1); color: #fff; border: 1px solid rgba(255,255,255,.18); }
  .variant-dark .share-btn:hover { background: rgba(255,255,255,.2); }
  .variant-light .share-btn { background: #F0F5FA; color: #2C5A64; border: 1px solid #E5E1D8; }
  .variant-light .share-btn:hover { background: #E4EEF3; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.shareUrl;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const original = btn.innerHTML;
      btn.textContent = '✓';
      setTimeout(() => { btn.innerHTML = original; }, 1400);
    });
  });
</script>
