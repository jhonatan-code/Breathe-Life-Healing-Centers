---
import Button from "./Button.astro";
import { site } from "../config/site";

/**
 * Insurance verification form. Fields and required/optional split follow
 * components.md §11: name, phone, email, DOB required; carrier + member ID
 * optional on purpose; SMS opt-in separate and unchecked.
 *
 * ⚠️ NOT WIRED. forms-ctm.md and privacy-consent.md handling are 🔴 BLOCKED,
 * and where the form may post is gated (PHI / BAA). This renders the UI only —
 * submission is intercepted client-side until Phase 7. Do not point `action`
 * anywhere without the CTM SOP.
 */
const carriers = [
  "Aetna",
  "Anthem Blue Cross",
  "Blue Cross Blue Shield",
  "Cigna",
  "Beacon Health Options",
  "Carelon Behavioral Health",
  "Other / not listed",
];
---

<form class="ivf" data-ctm-pending aria-describedby="ivf-note">
  <div class="ivf__row">
    <label class="ivf__field">
      <span>Full name <em>*</em></span>
      <input type="text" name="name" autocomplete="name" required placeholder="What we’ll call you" />
    </label>
    <label class="ivf__field">
      <span>Phone <em>*</em></span>
      <input type="tel" name="phone" autocomplete="tel" required placeholder="(000) 000-0000" />
    </label>
  </div>

  <div class="ivf__row">
    <label class="ivf__field">
      <span>Email <em>*</em></span>
      <input type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
    </label>
    <label class="ivf__field">
      <span>Date of birth <em>*</em></span>
      <input type="date" name="dob" autocomplete="bday" required />
    </label>
  </div>

  <div class="ivf__row">
    <label class="ivf__field">
      <span>Insurance carrier <i>optional</i></span>
      <select name="carrier">
        <option value="">Select…</option>
        {carriers.map((c) => <option value={c}>{c}</option>)}
      </select>
    </label>
    <label class="ivf__field">
      <span>Member / policy ID <i>optional</i></span>
      <input type="text" name="member_id" placeholder="If you have it to hand" />
    </label>
  </div>

  <label class="ivf__check">
    <input type="checkbox" name="sms_opt_in" value="yes" />
    <span>
      Text me about my verification. Message and data rates may apply; reply STOP to opt out.
      Consent isn’t a condition of treatment.
    </span>
  </label>

  <Button type="submit" full>Verify my insurance</Button>

  <p class="ivf__note" id="ivf-note">
    Everything you share is confidential and reviewed by a real person — not a bot.
    Prefer to talk now? <a href={site.phoneHref}>Call 24/7</a>.
  </p>

  <p class="ivf__status" role="status" hidden></p>
</form>

<style>
  .ivf { display: flex; flex-direction: column; gap: var(--space-4); }
  .ivf__row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .ivf__field { display: flex; flex-direction: column; gap: 0.35rem; }
  .ivf__field > span { font-size: var(--text-sm); font-weight: 600; color: var(--color-text-muted); }
  .ivf__field em { color: var(--color-error); font-style: normal; }
  .ivf__field i { color: var(--color-text-soft); font-style: normal; font-weight: 400; }
  .ivf input,
  .ivf select {
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    min-height: 2.9rem;
  }
  .ivf input:focus-visible,
  .ivf select:focus-visible { border-color: var(--color-accent); outline-offset: 1px; }

  .ivf__check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }
  .ivf__check input { margin-top: 0.15rem; width: 1.1rem; height: 1.1rem; }

  .ivf__note { font-size: var(--text-sm); color: var(--color-text-soft); }
  .ivf__note a { color: var(--color-accent); text-decoration: underline; }
  .ivf__status {
    font-size: var(--text-sm);
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent-tint);
    color: var(--color-accent-hover);
  }

  @media (max-width: 560px) {
    .ivf__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Interim: no verified PHI destination yet (forms-ctm.md is BLOCKED).
  // Keep the data on the client and tell the person to call.
  document.querySelectorAll<HTMLFormElement>("form.ivf[data-ctm-pending]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const status = form.querySelector<HTMLElement>(".ivf__status");
      if (status) {
        status.hidden = false;
        status.textContent =
          "Thanks — online verification isn’t connected yet. Please call 24/7 and our admissions team will verify your benefits right away.";
      }
    });
  });
</script>
