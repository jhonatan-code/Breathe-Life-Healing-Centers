---
/**
 * Closing dark-navy CTA band — same overlay/gradient treatment on every
 * page (that part never changes), but the background PHOTO now varies per
 * page via the optional `background` prop, defaulting to the original
 * shared image so any page that doesn't pass one keeps working unchanged.
 * The primary button defaults to a phone call (`primaryHref` = tel: link,
 * matching every existing page) — override it only when the page's real
 * primary action isn't calling (e.g. /about/careers/'s "Fill Out the
 * Employment Application" pointing at an on-page anchor instead).
 */
import { site } from "../config/site";

interface Props {
  heading: string;
  subhead: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondary?: { label: string; href: string };
  background?: string;
}
const PH = site.phoneDisplay;
const HREF = site.phoneHref;
const { heading, subhead, primaryLabel = `Call Us 24/7: ${PH}`, primaryHref = HREF, secondary, background = "/Asset/Backgrounds/final-cta-bg.jpg" } = Astro.props;

const S = {
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
};
---

<section data-screen-label="Final CTA" style="position:relative;overflow:hidden;background:#16293D;">
  <img src={background} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.42;" />
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(22,41,61,0.84),rgba(22,41,61,0.7));"></div>
  <div style="position:relative;max-width:1180px;margin:0 auto;padding:48px 37px;text-align:center;">
    <div style="width:1px;height:32px;background:#7FB3BC;margin:0 auto 22px;"></div>
    <h2 style="font-size:clamp(28px,3.4vw,48px);line-height:1.08;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 auto 16px;text-wrap:balance;max-width:40ch;">{heading}</h2>
    <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.5;font-weight:300;color:#E6EDF4;margin:0 auto 26px;max-width:78ch;">{subhead}</p>
    <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
      <a class="cta cta--light" href={primaryHref} style={S.ctaWhite}>{primaryLabel}</a>
      {secondary && <a class="cta" href={secondary.href} style={S.ctaGhost}>{secondary.label}</a>}
    </div>
  </div>
</section>
