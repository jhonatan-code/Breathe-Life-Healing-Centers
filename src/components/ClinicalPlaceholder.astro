---
/**
 * Marks a spot where real clinical/YMYL copy belongs but no approved brief
 * exists yet (CLAUDE.md: never invent YMYL content without a brief). Renders
 * loudly in dev so it can't be mistaken for finished copy, and is trivial to
 * grep for later: `grep -rn "APPROVED COPY NEEDED" src/pages`.
 *
 * `kind` only changes the label text shown — swap in whatever's missing:
 * "FAQ CONTENT", "CLINICAL CONTENT", "THERAPY DESCRIPTION", etc.
 */
interface Props {
  kind?: string;
  suffix?: string;
  note?: string;
}
const { kind = "CONTENT", suffix = "APPROVED COPY NEEDED", note } = Astro.props;
---

<div
  data-placeholder={kind}
  style="border:2px dashed #C9862B;background:repeating-linear-gradient(135deg,rgba(201,134,43,0.06),rgba(201,134,43,0.06) 10px,rgba(201,134,43,0.12) 10px,rgba(201,134,43,0.12) 20px);border-radius:10px;padding:18px 20px;font-family:'Instrument Sans',sans-serif;"
>
  <div style="font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A5A1E;">[{kind} — {suffix}]</div>
  {note && <div style="font-family:'Montserrat',Helvetica,sans-serif;font-size:13px;color:#6B5233;margin-top:6px;">{note}</div>}
</div>
