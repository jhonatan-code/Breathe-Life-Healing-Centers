---
/**
 * Button / CTA. One shape sitewide; radius, colour and spacing from tokens.
 * Label says what happens — never "Submit" (design-system.md §7).
 *
 * variant: primary | secondary | ghost   (a defined hierarchy — §7)
 */
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  type?: "button" | "submit";
  class?: string;
  full?: boolean;
}
const { href, variant = "primary", type = "button", class: cls = "", full = false } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class:list={["btn", `btn--${variant}`, full && "btn--full", cls]}
  href={href}
  type={href ? undefined : type}
>
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    --_bg: var(--color-accent);
    --_fg: var(--color-on-accent);
    --_bd: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: 0.85rem 1.6rem;
    border: 1.5px solid var(--_bd);
    border-radius: var(--radius-pill);
    background: var(--_bg);
    color: var(--_fg);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease),
      border-color var(--dur) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .btn:hover { background: var(--color-accent-hover); }
  .btn:active { transform: translateY(1px); }
  .btn--full { width: 100%; }

  .btn--secondary {
    --_bg: transparent;
    --_fg: var(--color-accent);
    --_bd: var(--color-border-strong);
  }
  .btn--secondary:hover {
    --_bg: var(--color-accent-tint);
    background: var(--color-accent-tint);
    border-color: var(--color-accent);
  }

  .btn--ghost {
    --_bg: transparent;
    --_fg: var(--color-accent);
    min-height: auto;
    padding: 0.4rem 0.2rem;
    border-radius: var(--radius-sm);
  }
  .btn--ghost:hover { background: transparent; color: var(--color-accent-hover); text-decoration: underline; }

  /* On dark surfaces */
  :global(.on-ink) .btn--secondary {
    --_fg: var(--color-on-ink);
    --_bd: rgba(255, 255, 255, 0.35);
  }
  :global(.on-ink) .btn--secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }
</style>
