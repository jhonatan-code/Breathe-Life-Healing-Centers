---
/**
 * Client-testimonials carousel — identical on every page. Self-contained:
 * pulls from the shared reviews compilation and Google rating in data/home
 * and config/site, so it needs no props beyond the optional background
 * override below.
 *
 * Card design + review copy sourced from the client-provided Reviews.astro
 * (2026-09-01): real per-reviewer avatar art instead of colored-initial
 * circles, full (untruncated) quotes, updated reviewer set.
 */
import { reviews } from "../data/home";
import { site } from "../config/site";

interface Props {
  background?: string;
}
const { background = "#F0F5FA" } = Astro.props;

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
};
---

<section id="reviews" data-screen-label="Reviews" style={`padding:70px 37px;background:${background};border-top:1px solid #E2DED7;`}>
  <div style="max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:44px;">
      <div style={S.eyebrow}>In their words</div>
      <h2 style={`${S.h2}max-width:30ch;`}>Rated {site.google.rating.toFixed(1)} on Google</h2>
      <div style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px 14px;margin-bottom:10px;">
        <img src="/Asset/Image%20reviews/Google%20Logo.svg" alt="Google" style="height:26px;width:auto;display:block;" />
        <span style="display:flex;gap:2px;" aria-label={`${site.google.rating} out of 5, ${site.google.count} reviews`}>
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" fill="#FFBE5C" width="18" height="18">
              <path d="m12 2 3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2Z" />
            </svg>
          ))}
        </span>
        <span style="font-family:'Instrument Sans',sans-serif;font-size:15px;color:#5B6570;">{site.google.rating.toFixed(1)} · {site.google.count} Google reviews</span>
      </div>
      <p style="font-family:'Instrument Sans',sans-serif;font-size:12px;color:#5B6570;margin:0;">Every journey looks different, yours will be built around exactly what you need.</p>
    </div>

    <div class="reviews-carousel" id="rev-car" role="region" aria-roledescription="carousel" aria-label="Client reviews" tabindex="0" style="position:relative;">
      <button type="button" data-rev="prev" aria-label="Previous review" class="rev-arrow msym" style="position:absolute;left:-6px;top:38%;transform:translateY(-50%);z-index:2;width:52px;height:52px;border:0;border-radius:999px;background:#FFFFFF;color:#4A555F;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 4px rgba(30,42,74,0.10),0 10px 24px rgba(30,42,74,0.16);">chevron_left</button>
      <button type="button" data-rev="next" aria-label="Next review" class="rev-arrow msym" style="position:absolute;right:-6px;top:38%;transform:translateY(-50%);z-index:2;width:52px;height:52px;border:0;border-radius:999px;background:#FFFFFF;color:#4A555F;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 4px rgba(30,42,74,0.10),0 10px 24px rgba(30,42,74,0.16);">chevron_right</button>
      <div style="overflow:hidden;padding:0 34px;">
        <ul class="reviews-carousel-track" id="rev-track">
          {(() => {
            const v = 3;
            const loop = [...reviews.slice(-v), ...reviews, ...reviews.slice(0, v)];
            return loop.map((r, k) => (
              <li class="reviews-slide" aria-hidden={k < v || k >= v + reviews.length ? "true" : undefined} style="position:relative;">
                <div style="position:relative;background:#FFFFFF;border:1px solid #E2DED7;border-radius:16px;padding:24px;box-shadow:0 1px 2px rgba(30,42,74,0.05),0 6px 16px rgba(30,42,74,0.06);">
                  <p class="reviews-quote" style="font-family:'Montserrat',Helvetica,sans-serif;font-size:12px;line-height:19px;color:#3A444D;margin:0;height:128px;overflow-y:auto;">{r.quote}</p>
                  <span aria-hidden="true" style="position:absolute;left:16px;bottom:-9px;width:16px;height:16px;background:#FFFFFF;border-right:1px solid #E2DED7;border-bottom:1px solid #E2DED7;border-radius:0 0 4px 0;transform:rotate(45deg);"></span>
                </div>
                <div style="display:flex;align-items:center;gap:12px;padding:22px 0 0 4px;">
                  <img src={r.avatar} alt={r.name} width="40" height="40" style="width:40px;height:40px;border-radius:999px;flex:0 0 auto;" />
                  <div style="display:grid;gap:3px;">
                    <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;color:#14181C;">{r.name}</div>
                    <div style="display:flex;gap:2px;" aria-label="Five out of five stars">
                      {Array.from({ length: 5 }).map(() => (
                        <svg viewBox="0 0 24 24" fill="#FFBE5C" width="15" height="15">
                          <path d="m12 2 3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2Z" />
                        </svg>
                      ))}
                    </div>
                  </div>
                </div>
              </li>
            ));
          })()}
        </ul>
      </div>
    </div>
    <div id="rev-dots" role="tablist" aria-label="Choose a review" style="display:flex;align-items:center;justify-content:center;gap:9px;margin-top:22px;">
      {reviews.map((_, k) => (
        <button type="button" role="tab" data-dot={k} aria-selected={k === 0 ? "true" : "false"} aria-label={`Go to review ${k + 1}`} style="border:0;padding:6px 3px;cursor:pointer;background:transparent;display:flex;align-items:center;">
          <span style="display:block;width:8px;height:8px;border-radius:999px;background:#C9D2DA;transition:all 320ms cubic-bezier(.4,0,.2,1);"></span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  // ── Reviews carousel (infinite, drag, keyboard, dots) ────────────────────
  (() => {
    const car = document.getElementById("rev-car");
    const track = document.getElementById("rev-track") as HTMLElement | null;
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    if (!car || !track) return;
    const total = dots.length;
    const readVisible = () => {
      const v = parseInt(getComputedStyle(car).getPropertyValue("--visible-cards"), 10);
      return Number.isFinite(v) && v > 0 ? v : 3;
    };
    let visible = readVisible();
    let idx = visible;
    let step = 0;
    const measure = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return;
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      step = first.getBoundingClientRect().width + gap;
    };
    const place = (animate: boolean) => {
      track.style.transition = animate ? "" : "none";
      track.style.transform = `translateX(${-idx * step}px)`;
      if (!animate) { void track.offsetWidth; track.style.transition = ""; }
    };
    const syncDots = () => {
      const real = ((idx - visible) % total + total) % total;
      dots.forEach((d, k) => {
        const on = k === real;
        d.setAttribute("aria-selected", String(on));
        const s = d.firstElementChild as HTMLElement;
        s.style.width = on ? "24px" : "8px";
        s.style.background = on ? "#33679C" : "#C9D2DA";
      });
    };
    const go = (i: number) => { idx = i; place(true); syncDots(); };
    track.addEventListener("transitionend", () => {
      if (idx >= total + visible) { idx -= total; place(false); }
      else if (idx < visible) { idx += total; place(false); }
      syncDots();
    });
    car.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); go(idx - 1); }
      else if (e.key === "ArrowRight") { e.preventDefault(); go(idx + 1); }
    });
    document.querySelector('[data-rev="prev"]')?.addEventListener("click", () => go(idx - 1));
    document.querySelector('[data-rev="next"]')?.addEventListener("click", () => go(idx + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => go(k + visible)));

    // drag
    let drag: { x: number; dx: number } | null = null;
    track.addEventListener("pointerdown", (e) => { drag = { x: e.clientX, dx: 0 }; track.classList.add("is-dragging"); });
    track.addEventListener("pointermove", (e) => {
      if (!drag) return;
      drag.dx = e.clientX - drag.x;
      track.style.transform = `translateX(${-idx * step + drag.dx}px)`;
    });
    const end = () => {
      if (!drag) return;
      const dx = drag.dx; drag = null;
      track.classList.remove("is-dragging");
      const th = (step || 300) * 0.25;
      if (dx <= -th) go(idx + 1);
      else if (dx >= th) go(idx - 1);
      else place(true);
    };
    track.addEventListener("pointerup", end);
    track.addEventListener("pointercancel", end);
    track.addEventListener("pointerleave", end);
    track.addEventListener("dragstart", (e) => e.preventDefault());

    // autoplay — advance every 5s, pause on hover / focus / drag / hidden tab
    if (!window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) {
      let hover = false, focus = false;
      const tick = () => {
        if (!hover && !focus && !track.classList.contains("is-dragging") && !document.hidden) go(idx + 1);
      };
      let timer = window.setInterval(tick, 5000);
      const kick = () => { clearInterval(timer); timer = window.setInterval(tick, 5000); };
      car.addEventListener("mouseenter", () => { hover = true; });
      car.addEventListener("mouseleave", () => { hover = false; kick(); });
      car.addEventListener("focusin", () => { focus = true; });
      car.addEventListener("focusout", () => { focus = false; kick(); });
      car.addEventListener("pointerdown", () => { hover = true; });
      car.addEventListener("pointerup", () => { hover = false; kick(); });
      document.addEventListener("visibilitychange", kick);
    }

    let rz: number;
    addEventListener("resize", () => {
      clearTimeout(rz);
      rz = window.setTimeout(() => {
        const next = readVisible();
        if (next !== visible) { idx = (((idx - visible) % total + total) % total) + next; visible = next; }
        measure(); place(false); syncDots();
      }, 150);
    });
    requestAnimationFrame(() => { measure(); place(false); syncDots(); });
  })();
</script>
