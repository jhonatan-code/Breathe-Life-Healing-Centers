---
/**
 * Homepage insurance section, "Blue Split" (option B from the insurance
 * proposals canvas, approved 2026-10-05): copy + in-network logos on a brand
 * blue half, the verify form open (flat variant) on the white half. Same copy
 * and the same shared `insurers` array as SiteInsurance; the logo marquee is
 * replaced by a static 4×2 panel on desktop. On tablet/phone it stacks, the
 * whole section stays blue, the logos run as an infinite marquee (pauses on
 * hover/hold, tap toggles) and the form sits in a white 10px-radius card.
 */
import { insurers } from "../data/home";
import VerifyInsuranceForm from "./VerifyInsuranceForm.astro";

interface Props {
  heading?: string;
  intro: string;
  /** id for this section's form; must differ from the page's other forms. */
  formId?: string;
}
const {
  heading = "We're in-network with most major insurers",
  intro,
  formId = "verify-insurance",
} = Astro.props;
---

<section id="insurance" class="ins-split" data-screen-label="Insurance" style="display:flex;flex-wrap:wrap;background:#FFFFFF;">
  <div class="ins-split-copy" style="flex:1 1 560px;box-sizing:border-box;padding:96px 80px 96px max(37px,calc((100vw - 1440px) / 2 + 37px));background:#32679C;display:flex;flex-direction:column;gap:18px;">
    <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#C8DAE9;">Cost &amp; coverage</div>
    <h2 style="font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;color:#FFFFFF;margin:0;max-width:15ch;text-wrap:balance;">{heading}</h2>
    <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#DCE6EF;margin:0;max-width:54ch;">{intro}</p>
    <ul class="ins-split-logos ins-grid" style="list-style:none;margin:14px 0 0;padding:10px 14px;background:#FFFFFF;border-radius:16px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));box-shadow:0 18px 40px rgba(4,9,16,0.20);">
      {insurers.map((i) => (
        <li style="height:84px;display:flex;align-items:center;justify-content:center;padding:0 10px;">
          <img src={i.src} alt={i.name} loading="lazy" style={`height:${Math.round(i.h * 0.85)}px;width:auto;max-width:100%;object-fit:contain;`} />
        </li>
      ))}
    </ul>
    {/* Mobile only: the same logos as an infinite marquee (two copies, the
       track slides by exactly one copy). Paused while hovered or held, and a
       tap toggles it paused/running. */}
    <div class="ins-marquee" data-ins-marquee aria-label="In-network insurers">
      <ul class="ins-marquee-track">
        {[...insurers, ...insurers].map((i, k) => (
          <li aria-hidden={k >= insurers.length ? "true" : undefined}>
            <img src={i.src} alt={k >= insurers.length ? "" : i.name} loading="lazy" style={`height:${Math.round(i.h * 0.9)}px;width:auto;max-width:150px;object-fit:contain;display:block;`} />
          </li>
        ))}
      </ul>
    </div>
    <p style="display:flex;align-items:center;gap:10px;margin:4px 0 0;font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;color:#FFFFFF;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto;"><circle cx="12" cy="12" r="10"></circle><path d="M12 11v5M12 8h.01"></path></svg>
      We do not accept Medi-Cal or Medicare.
    </p>
  </div>

  <div class="ins-split-form" style="flex:1 1 480px;box-sizing:border-box;padding:96px max(37px,calc((100vw - 1440px) / 2 + 37px)) 96px 80px;display:flex;align-items:center;">
    <div class="ins-split-card" style="width:100%;max-width:560px;">
      <VerifyInsuranceForm id={formId} variant="flat" />
    </div>
  </div>
</section>

<style>
  .ins-marquee { display: none; }

  @media (max-width: 1024px) {
    /* global mobile layer adds a 20px gutter to every <section>; the two
       halves carry their own gutter, so the blue half stays full-bleed */
    #insurance.ins-split { padding-left: 0 !important; padding-right: 0 !important; background: #32679C !important; }
    /* min-width:0 so the marquee's max-content track can't widen the column */
    .ins-split-copy { padding: 56px 20px 28px !important; flex-basis: 100% !important; min-width: 0; max-width: 100%; }
    /* the whole section stays blue; the form sits in a white card */
    .ins-split-form { padding: 0 20px 56px !important; flex-basis: 100% !important; background: #32679C; }
    .ins-split-card {
      max-width: none !important; background: #FFFFFF; border-radius: 10px;
      padding: 26px 20px; box-sizing: border-box; box-shadow: 0 18px 40px rgba(4, 9, 16, 0.20);
    }

    /* form header: HIPAA badge (50px wide) stacked above the centered title */
    .ins-split-card :global(.ivf-flat-head) { flex-direction: column; gap: 10px !important; text-align: center; }
    .ins-split-card :global(.ivf-flat-head img) { width: 50px !important; height: auto !important; }

    /* logos: the 4x2 grid becomes an infinite marquee */
    .ins-grid { display: none !important; }
    .ins-marquee {
      display: block; width: 100%; max-width: 100%; margin-top: 14px; background: #FFFFFF; border-radius: 16px;
      overflow: hidden; box-shadow: 0 18px 40px rgba(4, 9, 16, 0.20); cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .ins-marquee-track {
      list-style: none; margin: 0; padding: 0; display: flex; align-items: center; width: max-content;
      animation: ins-marquee 26s linear infinite;
    }
    .ins-marquee-track li { flex: 0 0 auto; height: 84px; display: flex; align-items: center; padding: 0 22px; }
    .ins-marquee.is-paused .ins-marquee-track { animation-play-state: paused; }
  }
  /* mouse hover pauses too; gated so a tap's sticky :hover on touch screens
     doesn't keep it paused after the tap toggles it back on */
  @media (max-width: 1024px) and (hover: hover) {
    .ins-marquee:hover .ins-marquee-track { animation-play-state: paused; }
  }
  @keyframes ins-marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ins-marquee { overflow-x: auto; }
    .ins-marquee-track { animation: none; }
  }
  @media (max-width: 640px) {
    .ins-split :global(.ivf-flat-pair) { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  // Insurance marquee (mobile): held finger pauses it; a tap toggles it.
  document.querySelectorAll<HTMLElement>("[data-ins-marquee]").forEach((el) => {
    let held = false;
    let sticky = false;
    const sync = () => el.classList.toggle("is-paused", held || sticky);
    el.addEventListener("pointerdown", () => { held = true; sync(); });
    const release = () => { held = false; sync(); };
    el.addEventListener("pointerup", release);
    el.addEventListener("pointercancel", release);
    el.addEventListener("pointerleave", release);
    el.addEventListener("click", () => { sticky = !sticky; sync(); });
  });
</script>
