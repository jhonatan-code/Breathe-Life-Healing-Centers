---
import { msymChar } from "../../lib/icons";
/**
 * /programs/outpatient-rehab/ — structural/marketing copy only; the core
 * definition line reuses the already-approved `levels` entry ("Outpatient
 * (OP)") from data/home.ts verbatim, rather than inventing new clinical
 * framing.
 *
 * FAQ (below) added per Breathe_Life_Outpatient_Rehab_FAQ.docx (2026-09-11)
 * — sourced by the brief from the live /therapies/outpatient-addiction-rehab/
 * page, confirmed against that page directly, including the real schedule
 * (1-2 to 3-4 days a week) and duration (6-8 weeks) facts. That live page is
 * otherwise clean (no IFS/EMDR/contingency-management mentions), but ends
 * with a leftover, out-of-place line, "Our crystal meth rehab in Los Angeles
 * can help you", that reads like a copy-paste error from another page
 * template. Not carried forward here; flagged for whoever owns the live site.
 *
 * Section-specific redesign (2026-09-11, approved via Artifact review — see
 * CLAUDE.md "## Page structure — fixed shared sections" and "## Design
 * Process"): "Related Programs" is replaced by "The Fork" — a two-path
 * branch (step up to IOP, or pair with Sober Living) instead of a
 * before/current/after ladder like PHP or IOP got. Outpatient has no single
 * "next level of care" to sequence against, so a position strip would
 * misrepresent the relationship; the two real facts already on this page
 * are reframed by *why* someone would go there instead. "Understanding"
 * and "What's Included" were not part of this proposal and are unchanged.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";
import { levels, why } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Outpatient Rehab in Los Angeles | Breathe";
const description =
  "Outpatient rehab in Los Angeles — the most flexible level of care, ideal as a step-down or for ongoing support. LGBTQ+-affirming. In-network with most major insurers. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const level = levels.find((l) => l.title === "Outpatient (OP)")!;

const forYou = [
  "You need the most flexible level of care",
  "You're stepping down after IOP, PHP, or residential treatment",
  "You want to keep working with a clinical team while living independently",
  "You're maintaining long-term recovery with periodic check-ins",
];

const included = [
  { icon: "directions_walk", title: "Flexible scheduling around your life", text: "Sessions set at a pace that fits work, school, or family, however far along you are." },
  { icon: "forum", title: "Ongoing individual therapy", text: "Regular sessions with a clinician who already knows your history." },
  { icon: "history_edu", title: "A clinical team that knows you", text: "Continuity from earlier levels of care, so you're not starting over with someone new." },
  { icon: "tune", title: "A plan that adjusts as you do", text: "Frequency and focus shift over time as your needs change." },
];

// "The Fork" — two real paths from outpatient, framed by why someone would
// go there rather than by sequence position (outpatient has no single
// "next level of care" to sequence against). Same two facts the old
// "Related Programs" cards used, unchanged.
const fork = [
  { prompt: "If you need more support", title: "Step up to IOP", href: "/programs/intensive-outpatient/", text: "A step up in structure for people who need more than standard outpatient care." },
  { prompt: "If you want structured housing", title: "Pair with Sober Living", href: "/programs/sober-living/", text: "A structured living environment that can run alongside outpatient care." },
];

const whyPicks = why.filter(([, , h]) =>
  ["Trauma-Informed Approach", "Your Privacy, Protected", "Staff Who've Lived It"].includes(h)
);

// Verbatim from Breathe_Life_Outpatient_Rehab_FAQ.docx (2026-09-11), sourced
// by that brief from the live /therapies/outpatient-addiction-rehab/ page.
const faqs = [
  { q: "How many days a week is outpatient rehab?", a: "Most clients attend one to four days a week, depending on individual needs, for a few hours each visit." },
  { q: "How long does outpatient rehab typically last?", a: "Most outpatient programs run about six to eight weeks, though this depends on your specific situation and progress." },
  { q: "Do I have to live at the facility?", a: "No. Outpatient rehab is built around living at home while attending scheduled treatment sessions." },
  { q: "What kind of therapy is included?", a: "Both group and individual therapy. Group sessions build communication and relapse prevention skills, sometimes through exercises like role play. Individual sessions focus on identifying triggers, setting healthy boundaries, and addressing what is underneath the substance use." },
  { q: "Is outpatient rehab enough if I haven't had a serious consequence from my substance use yet?", a: "Still having parts of your life intact, like a job or relationships, does not mean support is not worth having. Outpatient rehab is often the right level of care before things get more serious." },
  { q: "What happens after I complete the program?", a: "Many clients continue with a personal therapist and community support groups to maintain their progress." },
  { q: "Is outpatient rehab covered by insurance?", a: "In most cases, yes. We are in-network with most major providers and verify your specific benefits before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

const pageUrl = new URL("/programs/outpatient-rehab/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Programs", item: new URL("/programs/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Outpatient Rehab", item: pageUrl },
      ],
    },
    {
      "@type": "WebPage",
      name: title,
      url: pageUrl,
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/programs/outpatient-rehab/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Programs" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-23-kitchen-common-area.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/programs/" style="color:#7FB3BC;">Programs</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Outpatient Rehab
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Outpatient Rehab. Ongoing Support, Full Independence.</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">{level.text}</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person — no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:30ch;`}>What outpatient rehab looks like</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>Outpatient rehab is the most flexible level of care, ideal as a step-down after more intensive levels — or, for some people, the right place to start. You live at home and keep working with a clinical team on a schedule that fits around the rest of your life.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;max-width:58ch;">It's often paired with sober living for people who want structured housing alongside outpatient support.</p>
        </div>
        <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:30px 30px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Outpatient rehab may be right for you if</div>
          <div style="display:grid;gap:14px;">
            {forYou.map((s) => (
              <div style="display:flex;gap:12px;align-items:flex-start;">
                <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                  <Icon name="check" size={14} />
                </span>
                <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#3A444D;">{s}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT'S INCLUDED  ══════════════ */}
    <section data-screen-label="What's included" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>What's included</div>
          <h2 style={`${S.h2}max-width:24ch;`}>What outpatient rehab includes</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {included.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  THE FORK  ══════════════ */}
    <section data-screen-label="The fork" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1100px;margin:0 auto;">
        <div style="text-align:center;max-width:620px;margin:0 auto 12px;">
          <div style={S.eyebrow}>Where you go from here</div>
          <h2 style={`${S.h2}max-width:20ch;`}>Two ways this can flex</h2>
          <p style={`${S.intro}color:#3A444D;`}>Outpatient is the lightest level of care, not a step toward another one. From here, most people go one of two directions.</p>
        </div>

        <div class="op-fork">
          <div class="op-fork-origin">Outpatient Rehab</div>
          <svg class="op-fork-lines" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 50 0 L 50 8 L 25 8 L 25 20" fill="none" stroke="#33679C" stroke-width="0.6"></path>
            <path d="M 50 0 L 50 8 L 75 8 L 75 20" fill="none" stroke="#2C5A64" stroke-width="0.6"></path>
          </svg>
          <div class="op-fork-cols">
            {fork.map((f, i) => {
              const teal = i === 1;
              return (
                <div class={`op-fork-card${teal ? " teal" : ""}`}>
                  <p class="op-fork-prompt">{f.prompt}</p>
                  <h3 class="op-fork-title">{f.title}</h3>
                  <p class="op-fork-text">{f.text}</p>
                  <a class="op-fork-link" href={f.href}>Learn more <span aria-hidden="true">→</span></a>
                </div>
              );
            })}
          </div>
        </div>

        <p style="text-align:center;font-family:'Montserrat',Helvetica,sans-serif;font-size:13px;font-style:italic;color:#646D76;margin:28px auto 0;max-width:56ch;">Unlike PHP and IOP, outpatient has no single next level of care. These are the two real paths people take from here, not sequence positions.</p>

        <div style="text-align:center;margin-top:32px;">
          <a href="/programs/" style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">See all Programs &amp; Levels of Care <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for outpatient rehab — before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Why choose Breathe for outpatient care</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {whyPicks.map(([icon, color, h, p]) => (
            <div style="padding:32px 30px;">
              <span style={`display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:${color === "#478694" ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};margin-bottom:16px;`}>
                <span class="msym" style={`font-size:24px;color:${color === "#478694" ? "#2C5A64" : "#33679C"};`}>{msymChar(icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{h}</h3>
              <p style={S.card}>{p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews background="#FFFFFF" />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about outpatient rehab"
      intro="Straight answers about schedule, duration, and what comes after."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are You Ready to Take the First Step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure — just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-07-pool-waterfall-grotto.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* ── The Fork — two-path branch, not a sequence ladder ──────────────── */
  .op-fork { position: relative; margin-top: 44px; }
  .op-fork-origin {
    position: relative; z-index: 2; width: fit-content; margin: 0 auto; text-align: center;
    background: #16293D; color: #F3F1EC; font-family: "Instrument Sans", sans-serif; font-weight: 600; font-size: 14px;
    padding: 12px 26px; border-radius: 999px; box-shadow: 0 10px 26px rgba(22,41,61,0.25);
  }
  .op-fork-lines { display: block; width: 100%; height: 60px; margin-top: -1px; }
  .op-fork-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 4vw, 32px); margin-top: -4px; }
  @media (max-width: 720px) { .op-fork-cols { grid-template-columns: 1fr; } .op-fork-lines { display: none; } }
  .op-fork-card {
    background: #FFFFFF; border: 1px solid #E2DED7; border-top: 3px solid #33679C; border-radius: 14px;
    padding: 28px 26px; display: flex; flex-direction: column; gap: 10px;
  }
  .op-fork-card.teal { border-top-color: #2C5A64; }
  .op-fork-prompt { font-family: "Instrument Sans", sans-serif; font-weight: 600; font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #33679C; margin: 0; }
  .op-fork-card.teal .op-fork-prompt { color: #2C5A64; }
  .op-fork-title { font-family: "Instrument Sans", sans-serif; font-weight: 600; font-size: 21px; color: #14181C; }
  .op-fork-text { font-family: "Montserrat", Helvetica, sans-serif; font-size: 14.5px; color: #3A444D; line-height: 1.6; flex: 1; margin: 0; }
  .op-fork-link { font-family: "Instrument Sans", sans-serif; font-weight: 600; font-size: 13.5px; color: #33679C; display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; }
  .op-fork-card.teal .op-fork-link { color: #2C5A64; }
</style>

<script>
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
