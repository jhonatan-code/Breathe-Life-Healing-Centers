---
import { msymChar } from "../../lib/icons";
/**
 * /programs/family-program/ — built from
 * docs/content/Breathe_Life_Family_Program_Brief.docx (full section-by-
 * section copy, already converted to docs/content/_text/). Every heading,
 * body line, and FAQ pair below is the brief's own copy, not invented.
 *
 * The brief consolidates three former URLs (Family Programs hub, 3-Day
 * Family Workshop, Family Class/Family Intensive Services) into one page
 * with three distinct sections, per the brief's own consolidation note.
 *
 * Never assumes blood relationships (CLAUDE.md, and this page's own brand
 * pillar #5) — partners, chosen family, and community are named explicitly
 * throughout, matching the brief.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Family Program | Breathe Life Healing Centers";
const description =
  "Recovery isn't just individual, family heals too. Ongoing family therapy, Family Class, and a 3-Day Family Workshop, with room for chosen family as well as family of origin. LGBTQ+-affirming.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

// "Three ways family shows up here" — verbatim from the brief.
const ways = [
  {
    icon: "family_restroom", title: "Ongoing Family Therapy",
    text: "Woven into the treatment process itself, structured sessions that involve the people who matter, at the pace recovery actually requires.",
    cta: "Learn About Family Therapy", href: "/therapies/",
  },
  {
    icon: "school", title: "Family Class (Intensive Services)",
    text: "Focused, in-depth education and process work for family members who want to understand what their loved one is going through, and what role they can play in it.",
    cta: "Learn About Family Class", href: "/admissions/for-families/",
  },
  {
    icon: "calendar_month", title: "3-Day Family Workshop",
    text: "A structured, immersive weekend for families ready to do deeper work together, not a single session, a real commitment of time built for real change.",
    cta: "Learn About the Family Workshop", href: "/admissions/for-families/",
  },
];

// "What families are saying" — verbatim Google reviews from the brief.
const familyQuotes = [
  { quote: "I attended Breathe's Family Classes and was impressed with that service as well... Lovely, comfortable surroundings, truly excellent staff and very responsive to family members.", name: "Babbi Anderson" },
  { quote: "I believe the Family program here is the best in the world — true authentic healing as a unit!", name: "Elissa" },
  { quote: "My family also had a positive experience during family week and another family member checked in after I left.", name: "Matt Berg" },
];

// "Why choose Breathe for family care" — verbatim from the brief.
const whyFamily = [
  { icon: "diversity_3", title: "No assumptions about who counts", text: "Partners, chosen family, and community are welcomed as fully as blood relatives, because for many of our clients, they're who actually shows up." },
  { icon: "volunteer_activism", title: "Staff who've lived it", text: "Family sessions are led by people who understand estrangement, religious trauma, and rebuilding trust, not just from training, but often from experience." },
  { icon: "join_inner", title: "Woven into treatment, not bolted on", text: "Family work happens alongside the client's individual treatment, not as an afterthought scheduled separately from the real recovery process." },
];

// FAQs — verbatim from the brief.
const faqs = [
  { q: "Does “family” have to mean blood relatives?", a: "No. Partners, chosen family, close friends, and community members are all welcome to participate, we don't require a biological or legal relationship. Related reading: [Chosen Family and Recovery: Why Your Support System Doesn't Have to Be Blood](/blog/chosen-family-and-recovery-why-your-support-system-does-not-have-to-be-blood/)." },
  { q: "What if my loved one's biological family isn't involved, or isn't safe to involve?", a: "That's common, and it doesn't limit access to family programming. Many clients build their family system here around chosen family instead." },
  { q: "What's the difference between Family Class and the Family Workshop?", a: "Family Class is focused, ongoing education and process work. The Family Workshop is a structured 3-day intensive for families ready for a deeper, immersive commitment. Many families do both at different points." },
  { q: "Can family participate remotely if they're not local to Los Angeles?", a: "Reach out to our admissions team to talk through what's available, remote participation options vary by program component." },
  { q: "Is family participation required?", a: "No, but it's strongly encouraged where it's safe and appropriate. Treatment moves forward either way." },
  { q: "Does insurance cover family programming?", a: "In most cases family therapy sessions are covered as part of the overall treatment plan. Our team [verifies your specific benefits](/admissions/insurance/) before you commit to anything." },
];

const pageUrl = new URL("/programs/family-program/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Programs", item: new URL("/programs/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Family Program", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
    {
      "@type": "WebPage",
      name: title,
      url: pageUrl,
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
  ],
};
---

<Layout title={title} description={description} path="/programs/family-program/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Programs" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-04-community-dining-lounge.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/programs/" style="color:#7FB3BC;">Programs</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Family Program
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Family Program in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Whether that's the family you were born into, the one you chose, or both. Our Family Program doesn't assume blood relationships, it makes room for who actually shows up.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  WHY FAMILY, ON OUR TERMS  ══════════════ */}
    <section data-screen-label="Why family, on our terms" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:900px;margin:0 auto;">
        <div style={S.eyebrow}>Why family, on our terms</div>
        <h2 style={`${S.h2}max-width:24ch;margin:0 0 14px;`}>Family, without the assumptions</h2>
        <p style={`${S.intro}margin-bottom:16px;`}>Addiction doesn't happen in isolation, and neither does recovery. But "family" in treatment too often means a narrow, assumed shape, married parents, biological children, a household that looks a certain way.</p>
        <p style={`${S.intro}margin-bottom:22px;`}>That's not how it works here. Partners, chosen family, close friends, and community members are all valid participants in the family system. For a lot of the people we treat, biological family is absent, harmful, or estranged, often because of religious trauma, rejection, or a lack of affirmation. We don't treat that as a gap to work around. We treat it as the reality it is.</p>
        <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-left:3px solid #7FB3BC;border-radius:10px;padding:22px 26px;">
          <p style={`${S.card}font-style:italic;`}>Our own call data includes a family member calling to arrange residential placement for her adult child's partner, not a spouse, not a blood relative. This principle isn't aspirational language; it's already how people are using this program.</p>
        </div>
      </div>
    </section>

    {/* ══════════════  THREE WAYS FAMILY SHOWS UP HERE  ══════════════ */}
    <section data-screen-label="Three ways family shows up" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How it works</div>
          <h2 style={`${S.h2}max-width:28ch;`}>Three ways family shows up here</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {ways.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{c.cta} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT FAMILIES ARE SAYING  ══════════════ */}
    <section data-screen-label="What families are saying" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1200px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>From public Google reviews</div>
          <h2 style={`${S.h2}max-width:26ch;`}>What families are saying</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;">
          {familyQuotes.map((r) => (
            <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-radius:12px;padding:26px 24px;">
              <p style={`${S.card}font-style:italic;margin-bottom:14px;`}>&ldquo;{r.quote}&rdquo;</p>
              <div style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#14181C;">{r.name}, Google review</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  RELATED PROGRAMS  ══════════════ */}
    <section data-screen-label="Related programs" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:900px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Related</div>
        <h2 style={`${S.h2}max-width:26ch;`}>Family work continues throughout treatment</h2>
        <p style={`${S.intro}max-width:70ch;margin-bottom:26px;`}>Family programming runs alongside your loved one's own care, from the first level of treatment through what comes after.</p>
        <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
          <a href="/programs/residential-treatment/" class="link-card" style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid #C9D2DA;border-radius:999px;padding:11px 20px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">Residential Treatment</a>
          <a href="/programs/alumni-program/" class="link-card" style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid #C9D2DA;border-radius:999px;padding:11px 20px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">Alumni Program</a>
        </div>
      </div>
    </section>

    {/* ══════════════  WHY CHOOSE BREATHE FOR FAMILY CARE  ══════════════ */}
    <section data-screen-label="Why Breathe for family care" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why choose Breathe for family care</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#F7F5F1;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {whyFamily.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{msymChar(w.icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews background="linear-gradient(180deg, #F7F5F1 0%, #FFFFFF 100%)" />

    <SiteLocation />

    <SiteFAQ
      heading="Frequently asked questions"
      intro="Straight answers to what families ask us before they decide anything."
      groups={[{ items: faqs }]}
      background="#F7F5F1"
    />

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for family programming, before you commit to anything."
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* New-page placement: after the FAQ, right before the Final CTA. */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are You Ready to Take the First Step, Together?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure, just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-02-shared-bedroom-blue.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
