---
import { msymChar } from "../../lib/icons";
/**
 * /programs/medical-detox/ — structural/marketing copy only (Programs-batch
 * build spec); the core definition line reuses the already-approved `levels`
 * entry ("Detox") from data/home.ts verbatim rather than inventing new
 * clinical framing.
 *
 * FAQ (below) added per Breathe_Life_Medical_Detox_FAQ_v2.docx (2026-09-11)
 * — sourced verbatim by the brief from the live
 * /medical-alcohol-and-drug-detox/ page, confirmed against that page directly.
 * Two things worth flagging from the brief:
 *  - Methadone is deliberately left out of the medication answer. The live
 *    page lists buprenorphine, methadone, and naltrexone; the client profile
 *    confirms MAT here excludes methadone, so only buprenorphine and
 *    naltrexone are named — both real, both on the live page.
 *  - The live page links out to "Experience Recovery" (experiencerecovery.com)
 *    as a partner program. Not referenced in this FAQ — whether that referral
 *    relationship is still current is an open question for the client, not a
 *    copy decision, and isn't resolved by this change.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";
import { levels, why } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Medical Detox in Los Angeles | Breathe";
const description =
  "Medically supervised detox in Los Angeles — a safe, monitored start before residential treatment. LGBTQ+-affirming care. In-network with most major insurers. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const level = levels.find((l) => l.title === "Detox")!;

const forYou = [
  "You want to stop using but you're worried about withdrawal",
  "You've tried to quit before without medical support",
  "You're starting a treatment plan and need a safe first step",
  "You want clinical support in place before moving into residential care",
];

const included = [
  {
    icon: "monitor_heart", title: "Medical monitoring",
    text: "Medical staff on-site to help you through withdrawal as safely and comfortably as possible.",
  },
  {
    icon: "fact_check", title: "An individualized assessment",
    text: "Your plan is built around your own history and needs, not a one-size-fits-all protocol.",
  },
  {
    icon: "psychology", title: "Mental health support from day one",
    text: "Psychiatric care runs alongside medical care, so anxiety, depression, or trauma aren't left for later.",
  },
  {
    icon: "trending_up", title: "A direct line into residential care",
    text: "Detox is a starting point, not an endpoint — we plan the transition into residential treatment before you finish.",
  },
];

// Levels-of-care ladder, same pattern as /programs/php/: real sequence
// (Detox → Residential → PHP → IOP → Outpatient → Sober Living), text
// reused verbatim from the canonical `levels` array in data/home.ts,
// nothing invented. Medication-Assisted Treatment (a support service, not
// a sequential level of care) doesn't belong in this ladder, unlike the
// old plain "related programs" grid it replaces.
const ladder = [
  { n: "You are here", title: "Detox", href: null, text: level.text, active: true },
  { n: "Next step", title: "Residential Treatment", href: "/programs/residential-treatment/", text: levels.find((l) => l.title === "Residential Treatment")!.text },
  { n: "Then", title: "PHP — Day Treatment", href: "/programs/php/", text: levels.find((l) => l.title === "PHP — Day Treatment (SUD, MH)")!.text },
  { n: "Ongoing support", title: "Intensive Outpatient", href: "/programs/intensive-outpatient/", text: levels.find((l) => l.title === "IOP — Intensive Outpatient (SUD, MH)")!.text },
];

const whyPicks = why.filter(([, , h]) =>
  ["Addiction and Mental Health, Treated Together", "Staff Who've Lived It", "Your Privacy, Protected"].includes(h)
);

// Verbatim from Breathe_Life_Medical_Detox_FAQ_v2.docx (2026-09-11) — sourced
// by that brief from the live /medical-alcohol-and-drug-detox/ page.
const faqs = [
  { q: "How long does medical detox usually take?", a: "It depends on how long, how much, and how often you used. For some people, detox takes a few days to a week. For others, withdrawal symptoms can persist longer. Your team will give you a clearer sense once your assessment is complete." },
  { q: "What withdrawal symptoms should I expect?", a: "Common symptoms include gastrointestinal issues, changes in sleep and appetite, mood swings, headaches, anxiety, depression, and irritability. How intense they are depends on your specific substance use history." },
  { q: "Is it dangerous to detox without medical support?", a: "Continuing to use to avoid withdrawal often means using more to get the same effect, which raises the real risk of overdose. Medical detox exists so that stopping can be managed safely by a professional team, rather than alone." },
  { q: "Will I be given medication during detox?", a: "Medication may be used to ease withdrawal symptoms and cravings, particularly for opioid withdrawal, where buprenorphine and naltrexone are commonly used. Antidepressants or anti-anxiety medication may also be used where appropriate. Your medical team will walk you through what fits your situation." },
  { q: "What substances do you provide medical detox for?", a: "Alcohol, methamphetamine, heroin, fentanyl, kratom, opioids and opiates, synthetic stimulants, Xanax, cocaine, marijuana, prescription drugs, designer drugs, and inhalants." },
  { q: "Do you provide psychiatric care during detox, or only after?", a: "Psychiatric care is part of the detox process itself, not something that waits until later. Mood swings, anxiety, and depression during withdrawal are addressed as they happen." },
  { q: "Is detox covered by insurance?", a: "In most cases, yes. We are in-network with most major providers and [verify your specific benefits](/admissions/insurance/) before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

const pageUrl = new URL("/programs/medical-detox/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Programs", item: new URL("/programs/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Medical Detox", item: pageUrl },
      ],
    },
    {
      "@type": "WebPage",
      name: title,
      url: pageUrl,
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/programs/medical-detox/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Programs" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-03-clinical-office.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/programs/" style="color:#7FB3BC;">Programs</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Medical Detox
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Medical Detox. A Safe, Supported Start.</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">{level.text}</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person — no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:30ch;`}>What medical detox looks like</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>Medical detox is a medically supervised environment to safely manage withdrawal. It's usually the first step for people who need supervised withdrawal — a place to stabilize before starting the therapeutic work of treatment, not the treatment itself.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;max-width:58ch;">What that involves varies by substance and by person. Our medical team assesses you individually and talks through what's appropriate before anything is decided.</p>
        </div>
        <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:30px 30px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Medical detox may be right for you if</div>
          <div style="display:grid;gap:14px;">
            {forYou.map((s) => (
              <div style="display:flex;gap:12px;align-items:flex-start;">
                <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                  <Icon name="check" size={14} />
                </span>
                <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#3A444D;">{s}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT'S INCLUDED — vitals pulse line  ══════════════
       A heartbeat trace draws itself on load, each peak marking one of the
       four real things detox includes — the most literal way to say
       "medically monitored" for the one program where that's the whole
       point. See docs/proposals: applied here and on
       medication-assisted-treatment.astro, the two programs where ongoing
       medical/psychiatric monitoring is the defining feature. */}
    <section data-screen-label="What's included" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1180px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>What's included</div>
          <h2 style={`${S.h2}max-width:26ch;`}>You're monitored, every step</h2>
        </div>
        <div class="pulse-wrap">
          <svg class="pulse-svg" viewBox="0 0 800 64" preserveAspectRatio="none" aria-hidden="true">
            <path class="pulse-path" d="M0,32 L140,32 L160,10 L180,54 L200,32 L340,32 L360,10 L380,54 L400,32 L540,32 L560,10 L580,54 L600,32 L740,32 L760,10 L780,54 L800,32" />
            <circle class="pulse-dot" cx="170" cy="10" r="4" />
            <circle class="pulse-dot" cx="370" cy="10" r="4" />
            <circle class="pulse-dot" cx="570" cy="10" r="4" />
            <circle class="pulse-dot" cx="770" cy="10" r="4" />
          </svg>
          <div class="pulse-grid">
            {included.map((c, i) => (
              <div class="pulse-card">
                <div class="pulse-marker">Beat {i + 1}</div>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  RELATED PROGRAMS  ══════════════ */}
    <section data-screen-label="Related programs" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Where you go from here</div>
          <h2 style={`${S.h2}max-width:26ch;`}>What comes after detox</h2>
        </div>
        <div class="ladder">
          {ladder.map((step) => {
            const inner = (
              <>
                <p class="ladder-n">{step.n}</p>
                <h3 class="ladder-title">{step.title}</h3>
                <p class="ladder-text">{step.text}</p>
              </>
            );
            return step.href ? (
              <a href={step.href} class="ladder-step">{inner}<span class="ladder-link">Learn more <span aria-hidden="true">→</span></span></a>
            ) : (
              <div class="ladder-step ladder-step--active">{inner}</div>
            );
          })}
        </div>
        <div style="text-align:center;margin-top:32px;">
          <a href="/programs/" style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">See all Programs &amp; Levels of Care <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <SiteInsurance
      background="#F7F5F1"
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for medical detox — before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why choose Breathe for medical detox</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {whyPicks.map(([icon, color, h, p]) => (
            <div style="padding:32px 30px;">
              <span style={`display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:${color === "#478694" ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};margin-bottom:16px;`}>
                <span class="msym" style={`font-size:24px;color:${color === "#478694" ? "#2C5A64" : "#33679C"};`}>{msymChar(icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{h}</h3>
              <p style={S.card}>{p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about medical detox"
      intro="Straight answers about withdrawal, medication, and what to expect."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are You Ready to Take the First Step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure — just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-05-spa-bathroom-suite.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* ── Vitals pulse line — "What's included" ────────────────────────── */
  .pulse-wrap { position: relative; }
  .pulse-svg { display: block; width: 100%; height: 64px; margin-bottom: 8px; }
  .pulse-path {
    fill: none; stroke: #33679C; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 900; stroke-dashoffset: 900;
  }
  .pulse-path.draw { animation: pulse-draw 2.6s ease-out forwards; }
  @keyframes pulse-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .pulse-path, .pulse-path.draw { animation: none; stroke-dashoffset: 0; } }
  .pulse-dot { fill: #C98A3A; }
  .pulse-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 4px; }
  .pulse-card { text-align: center; }
  .pulse-marker { font-family: "Instrument Sans", sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #C98A3A; margin-bottom: 8px; }
  .pulse-card h3 { font-size: 16px; font-weight: 600; margin: 0 0 6px; }
  .pulse-card p { font-family: "Montserrat", Helvetica, sans-serif; font-size: 16px; line-height: 1.6; color: #3A444D; margin: 0; }
  @media (max-width: 900px) { .pulse-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .pulse-grid { grid-template-columns: 1fr; } }

  /* ── Levels-of-care ladder, same pattern as /programs/php/ ──────────── */
  .ladder { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; align-items: end; }
  .ladder-step {
    display: flex; flex-direction: column; gap: 8px; text-decoration: none;
    background: #FFFFFF; border: 1px solid #E2DED7; border-top: 2px solid #33679C;
    border-radius: 12px; padding: 22px 20px;
  }
  .ladder-n { font-family: "Instrument Sans", sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #646D76; margin: 0; }
  .ladder-title { font-family: "Instrument Sans", sans-serif; font-size: 17px; font-weight: 600; color: #14181C; margin: 0; }
  .ladder-text { font-family: "Montserrat", Helvetica, sans-serif; font-size: 13.5px; line-height: 1.55; color: #646D76; margin: 0; flex: 1; }
  .ladder-link { font-family: "Instrument Sans", sans-serif; font-size: 13px; font-weight: 600; color: #33679C; }
  .ladder-step--active {
    background: #16293D; border-color: #16293D; transform: translateY(-10px);
    box-shadow: 0 18px 40px rgba(22,41,61,0.28);
  }
  .ladder-step--active .ladder-n { color: #7FB3BC; }
  .ladder-step--active .ladder-title { color: #FFFFFF; }
  .ladder-step--active .ladder-text { color: #C3D2DE; }
  @media (max-width: 760px) {
    .ladder { grid-template-columns: repeat(2, 1fr); }
    .ladder-step--active { transform: none; }
  }
</style>

<script>
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // Vitals pulse line replays every time it scrolls into view, not just
  // once on load — remove the class on exit so the stroke resets to
  // undrawn, then re-add it on the next entry to restart the draw.
  (() => {
    const svg = document.querySelector<SVGElement>(".pulse-svg");
    const path = svg?.querySelector<SVGPathElement>(".pulse-path");
    if (!svg || !path || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) path.classList.add("draw");
          else path.classList.remove("draw");
        }
      },
      { threshold: 0.4 }
    );
    io.observe(svg);
  })();
</script>
