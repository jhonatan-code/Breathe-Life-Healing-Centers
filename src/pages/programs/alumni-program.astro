---
import { msymChar } from "../../lib/icons";
/**
 * /programs/alumni-program/ — no dedicated content brief exists yet for
 * this page, but two corrections came in directly from
 * ~/Downloads/Breathe_Life_Alumni_Program_CORRECTIONS.docx (applied
 * 2026-09-14) and are reflected below:
 *
 * 1. "What alumni are saying" replaced the old 3-card grid of generic
 *    reviews (Edil Visli, Dustin Dudley, Troy Eaton's own quote truncated
 *    right before the line that actually mentioned the alumni program) with
 *    a single featured pull-quote — Troy Eaton's real, complete review,
 *    quoted verbatim from the corrections doc (a slightly different
 *    transcription than the one stored in data/home.ts `reviews`, which is
 *    shared with other pages — this one is scoped to this page only, per
 *    the doc, so it isn't pulled from that shared array).
 * 2. The FAQ ClinicalPlaceholder is replaced with the 7 real Q&As the doc
 *    says were "already delivered separately" — real SiteFAQ content now,
 *    with FAQPage JSON-LD added since there's approved copy to back it.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";
import { why } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Alumni Program | Breathe Life Healing Centers";
const description =
  "Recovery doesn't end at discharge. Breathe's Alumni Program keeps you connected through follow-up, community events, and a peer network built for the LGBTQ+ community first.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const forYou = [
  "You're finishing a level of care and want to stay connected to the community",
  "You want a peer network of people who understand recovery from the inside",
  "You've been out a while and want to reconnect",
  "You're a family member wanting to know support continues after discharge",
];

const included = [
  { icon: "groups", title: "Ongoing community", text: "A network of people who've been through treatment here and understand what it took to get sober." },
  { icon: "call", title: "Real follow-up", text: "Staff who check in after discharge, not just during your stay." },
  { icon: "diversity_3", title: "Built for the LGBTQ+ community first", text: "The same affirming space you had in treatment, carried into life after it." },
  { icon: "family_restroom", title: "Room for family, too", text: "Family and chosen family stay part of the picture, not just the client alone." },
];

// Verbatim from Breathe_Life_Alumni_Program_CORRECTIONS.docx (2026-09-14).
const faqs = [
  { q: "What is the Alumni Program?", a: "Ongoing community and support for anyone who has completed treatment at Breathe. It includes weekly BreatheOUT support groups, a private alumni community, and an Alumni Coordinator who stays in touch after you leave." },
  { q: "Is the Alumni Program only for people who did residential treatment?", a: "No. Anyone who has completed a program at Breathe is welcome to stay connected through the Alumni Program." },
  { q: "How do the weekly support groups work?", a: "BreatheOUT hosts weekly virtual support groups, also available by podcast, where alumni can share progress, setbacks, and coping strategies with people who understand recovery from the inside." },
  { q: "Can family members be involved in alumni support?", a: "Family involvement doesn't stop at discharge. [Family Program](/programs/family-program/) options remain part of the picture for alumni and their families." },
  { q: "How do I stay connected after I leave treatment?", a: "Keep your contact information updated with our Alumni Coordinator, and ask about joining the private alumni community for ongoing updates and connection." },
  { q: "Is there a cost to participate in the Alumni Program?", a: "Alumni support is part of our ongoing commitment to your recovery. Reach out to our team for specifics on what's included." },
  { q: "Is the Alumni Program open to LGBTQ+ and non-LGBTQ+ alumni alike?", a: "Yes. The same affirming space you had in treatment carries into the Alumni Program, open to everyone who came through our care." },
];

const related = [
  { icon: "cottage", title: "Residential Treatment", href: "/programs/residential-treatment/", text: "Where most alumni started their treatment before staying connected here." },
  { icon: "family_restroom", title: "Family Program", href: "/programs/family-program/", text: "Family involvement doesn't stop at discharge — it has its own ongoing place here too." },
];

const whyPicks = why.filter(([, , h]) =>
  ["Staff Who've Lived It", "LGBTQIA+-Affirming Care at Every Level", "Chosen Family Welcome in Programming"].includes(h)
);

const pageUrl = new URL("/programs/alumni-program/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Programs", item: new URL("/programs/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Alumni Program", item: pageUrl },
      ],
    },
    {
      "@type": "WebPage",
      name: title,
      url: pageUrl,
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/programs/alumni-program/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Programs" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-08-poolside-grotto-overlook.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/programs/" style="color:#7FB3BC;">Programs</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Alumni Program
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Alumni Program. Recovery Doesn't End at Discharge.</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Treatment has a start date and an end date. Community doesn't have to. Our Alumni Program keeps you connected — through follow-up, community events, and people who've walked the same path.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person — no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;`}>What our alumni program is for</h2>
          <p style={`${S.intro}margin:0 0 16px;`}>Leaving treatment is its own kind of transition. The structure, the community, the daily check-ins — all of it changes at once. Our Alumni Program exists so that shift doesn't mean losing everything you built here.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;">It's not a formal level of care — it's the community and follow-up that continues once formal treatment ends.</p>
        </div>
        <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:30px 30px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Our alumni program may be for you if</div>
          <div style="display:grid;gap:14px;">
            {forYou.map((s) => (
              <div style="display:flex;gap:12px;align-items:flex-start;">
                <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                  <Icon name="check" size={14} />
                </span>
                <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#3A444D;">{s}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT'S INCLUDED  ══════════════ */}
    <section data-screen-label="What's included" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>What's included</div>
          <h2 style={`${S.h2}max-width:26ch;`}>What our alumni program includes</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {included.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT ALUMNI ARE SAYING  ══════════════ */}
    <section data-screen-label="What alumni are saying" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>From a real alumnus</div>
        <blockquote style="margin:0 0 22px;padding:0;border:0;font-family:'Instrument Sans',sans-serif;font-size:clamp(24px,3vw,34px);line-height:1.35;letter-spacing:-0.015em;font-weight:600;color:#16293D;text-wrap:balance;">
          &ldquo;I spent 90 days at Breathe just about a year ago and it changed my life. The staff there guided me through dealing with some underlying emotional issues I had been overlooking for years. The care I received from the entire staff on campus and at the clinic was amazing. Their alumni program is incredible, they are big on following up and supporting former patients even after they leave the facility.&rdquo;
        </blockquote>
        <div style="font-family:'Instrument Sans',sans-serif;font-size:15px;font-weight:600;color:#33679C;margin-bottom:36px;">Troy Eaton, Google review</div>
        <p style={`${S.card}max-width:64ch;margin:0 auto;`}>Beyond what our alumni say, the program itself runs on real structure: weekly BreatheOUT support groups, a private alumni community, and an Alumni Coordinator who keeps in touch after you leave.</p>
      </div>
    </section>

    {/* ══════════════  RELATED PROGRAMS  ══════════════ */}
    <section data-screen-label="Related programs" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Where it starts</div>
          <h2 style={`${S.h2}max-width:26ch;`}>Alumni status starts with treatment</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {related.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{`Learn About Our ${c.title}`} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
        <div style="text-align:center;margin-top:32px;">
          <a href="/programs/" style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">See all Programs &amp; Levels of Care <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for treatment — before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Why Choose Breathe's Alumni Program</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {whyPicks.map(([icon, color, h, p]) => (
            <div style="padding:32px 30px;">
              <span style={`display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:${color === "#478694" ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};margin-bottom:16px;`}>
                <span class="msym" style={`font-size:24px;color:${color === "#478694" ? "#2C5A64" : "#33679C"};`}>{msymChar(icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{h}</h3>
              <p style={S.card}>{p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews background="#FFFFFF" />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about the alumni program"
      intro="Straight answers about who it's for, how it works, and what it costs."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are You Ready to Take the First Step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure — just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-23-kitchen-common-area.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
