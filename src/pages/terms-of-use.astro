---
/**
 * /terms-of-use/ — legal page. Linked from SiteFooter.astro under "Legal".
 *
 * ⚠️ LEGAL CONTENT RULE (CLAUDE.md): this is a legally binding document.
 * We do not write fake legal text — invented boilerplate is worse than no
 * content, it could misrepresent real policy. The page shell (header, hero/
 * title, footer, consistent styling) is real; the body is a
 * ClinicalPlaceholder pending actual Terms of Use text from legal counsel.
 *
 * No approved SiteHeader `current` label matches a legal page, so `current`
 * is omitted — nothing in primaryNav is highlighted, which is correct.
 * Kept deliberately simple: no SiteReviews/SiteLocation/SiteInsurance, and
 * no keywords forced onto it (keyword-mapping.md: "utility, legal and trust
 * pages have not had keywords forced onto them").
 */
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ClinicalPlaceholder from "../components/ClinicalPlaceholder.astro";
import { site } from "../config/site";

const title = "Terms of Use | Breathe Life Healing Centers";
const description = "The terms that govern use of the Breathe Life Healing Centers website.";

const pageUrl = new URL("/terms-of-use/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Terms of Use", item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={title} description={description} path="/terms-of-use/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="background:#16293D;">
      <div style="max-width:900px;margin:0 auto;padding:60px 37px 50px;">
        <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:20px;">
          <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Terms of Use
        </nav>
        <h1 style="font-size:clamp(32px,3.6vw,48px);line-height:1.1;letter-spacing:-0.028em;font-weight:600;color:#FFFFFF;margin:0;text-wrap:balance;">Terms of Use</h1>
      </div>
    </section>

    {/* ══════════════  BODY  ══════════════ */}
    <section data-screen-label="Terms of Use body" style="padding:60px 37px 80px;background:#FFFFFF;">
      <div style="max-width:760px;margin:0 auto;">
        <ClinicalPlaceholder
          kind="LEGAL CONTENT"
          note="Requires actual Terms of Use text from legal counsel — do not publish placeholder copy as real policy. Should cover, at minimum: acceptable use of this site, intellectual property, disclaimers, limitation of liability, and governing law, as approved by Breathe's counsel."
        />
        <div style="margin-top:44px;padding-top:28px;border-top:1px solid #E2DED7;">
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.7;color:#3A444D;margin:0 0 16px;">Questions about these terms? <a href={site.emailHref} style="color:#2C5A64;font-weight:500;">{site.email}</a> or call <a href={site.phoneHref} style="color:#2C5A64;font-weight:500;">{site.phoneDisplay}</a>.</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px 20px;font-family:'Instrument Sans',sans-serif;font-size:14px;">
            <a href="/notice-of-privacy-practices/" style="color:#33679C;font-weight:500;">Notice of Privacy Practices</a>
            <a href="/confidentiality-form/" style="color:#33679C;font-weight:500;">Confidentiality Form</a>
          </div>
        </div>
      </div>
    </section>

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>
