---
/**
 * /conditions/dual-diagnosis/ — explains Breathe's integrated dual-diagnosis
 * model (substance use + mental health, treated together). Existing pages
 * (alcohol/methamphetamine/cocaine "co-occurring conditions" sections) already
 * link here, so this needs to function as a real hub, not a stub.
 *
 * Clinical content and FAQ sourced from
 * Breathe_Life_Dual_Diagnosis_Content_and_FAQ.docx (2026-09-14), which
 * defers to the BLHC Content Client Profile as authoritative and is not
 * going through further client/team review. Unlike the other four
 * Conditions pages, dual diagnosis is a treatment model rather than a
 * single condition, so the "Understanding" section keeps its existing
 * process-framed "What integrated care looks like" card (structural
 * copy, approved elsewhere, not a clinical claim) and adds a second card
 * for the brief's real "Common signs" list alongside it, plus a safety
 * note where the brief flags one.
 *
 * Two corrections from the live page, per the brief:
 *  - Methadone excluded (second confirmed instance in this project,
 *    consistent with /programs/medical-detox/ and
 *    /programs/medication-assisted-treatment/): the live page names
 *    buprenorphine, methadone, and naltrexone as MAT medications. The
 *    client profile confirms MAT is offered with the exception of
 *    methadone. Only buprenorphine and naltrexone are named below.
 *  - Xanax, named on the live page as an example anxiety medication, is
 *    not named here, same rule as the Depression, Anxiety, and Complex
 *    Trauma pages.
 *
 * The page adds Conditions/Substances link grids to work as a real hub.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";
import { galleryImg } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Dual Diagnosis Treatment in Los Angeles | Breathe";
const description =
  "Integrated dual-diagnosis treatment in Los Angeles, mental health and substance use, treated together in one plan. LGBTQ+-affirming. In-network with most major insurers. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

// Process description, not a clinical claim — how Breathe structures
// integrated care, not a diagnostic list.
const integrated = [
  "One clinical team treats both, instead of separate programs handing you off",
  "A single treatment plan covers substance use and mental health together",
  "Care moves with you between levels, residential, PHP, IOP, without starting over",
  "Family therapy and case management stay connected to the whole picture, not just one part of it",
];

const conditions: [string, string][] = [
  ["Depression", "/conditions/depression/"],
  ["Anxiety", "/conditions/anxiety/"],
  ["Complex Trauma / C-PTSD", "/conditions/complex-trauma/"],
  ["Trauma", "/conditions/trauma/"],
];

const substances: [string, string][] = [
  ["Alcohol", "/what-we-treat/alcohol/"],
  ["Methamphetamine", "/what-we-treat/methamphetamine/"],
  ["Cocaine", "/what-we-treat/cocaine/"],
];

// Verbatim from Breathe_Life_Dual_Diagnosis_Content_and_FAQ.docx
// (2026-09-14), itself sourced from the live page.
const signs = [
  "Sudden, drastic changes in behavior",
  "Using substances under dangerous conditions",
  "Inability to control substance use",
  "Growing tolerance, feeling like a substance is needed to function",
  "Significant mood changes",
];

const faqs = [
  { q: "What is dual diagnosis?", a: "When substance use and a mental health condition occur together, sometimes one driving the other, sometimes developing independently. Both are treated as one plan, not as separate problems." },
  { q: "Which condition gets treated first, the substance use or the mental health issue?", a: "Neither is treated in isolation. Our clinical team addresses both simultaneously, on the same plan, from day one." },
  { q: "Will I need to detox before starting dual diagnosis treatment?", a: "If you're dependent on a substance, yes, detox is typically the safe starting point, managed with clinical support to make withdrawal as comfortable as possible." },
  { q: "Will medication be part of my treatment?", a: "It may be, for either the substance use side or the mental health side, depending on your specific situation. Medication decisions are made by our psychiatric team, not assumed in advance." },
  { q: "Is dual diagnosis treatment more intensive than treating one issue alone?", a: "It's more integrated, not necessarily more intensive. The goal is one coordinated plan instead of bouncing between separate, disconnected programs." },
  { q: "Does insurance cover dual diagnosis treatment?", a: "In most cases, yes. We're in-network with most major providers and verify your specific benefits before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

const care = [
  {
    icon: "cottage", title: "Residential Treatment", href: "/programs/residential-treatment/", cta: "Learn About Residential Treatment",
    text: "Full-time structure, daily therapy, and psychiatric care for both addiction and mental health, in one setting.",
  },
  {
    icon: "wb_sunny", title: "PHP, Day Treatment", href: "/programs/php/", cta: "Learn About PHP",
    text: "Intensive daytime treatment, returning home or to transitional living in the evenings.",
  },
  {
    icon: "calendar_month", title: "Intensive Outpatient (IOP)", href: "/programs/intensive-outpatient/", cta: "Learn About IOP",
    text: "A flexible schedule for people balancing treatment with work, school, or family.",
  },
  {
    icon: "support_agent", title: "Case Management", href: "/programs/case-management/", cta: "Learn About Case Management",
    text: "One dedicated person who knows your whole file, not just the substance-use side or the mental-health side.",
  },
];

const why = [
  {
    icon: "join_inner", title: "One plan, not two",
    text: "Substance use and mental health are treated together from day one, by the same clinical team, on the same timeline.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress. Open to anyone whose values align, without losing that center.",
  },
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
];

const pageUrl = new URL("/conditions/dual-diagnosis/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Conditions", item: new URL("/conditions/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Dual Diagnosis", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/conditions/dual-diagnosis/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Conditions" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src={galleryImg("facility-11-clinical-building-exterior.jpg")} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.85;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.84) 48%,rgba(22,41,61,0.55) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/conditions/" style="color:#7FB3BC;">Conditions</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Dual Diagnosis
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Dual Diagnosis Treatment in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Substance use and mental health rarely show up separately, so we don't treat them that way. One team, one plan, from the first call.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING DUAL DIAGNOSIS  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:32ch;`}>What dual diagnosis means at Breathe</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>"Dual diagnosis" describes co-occurring substance use and mental health conditions, anxiety, depression, or trauma alongside drug or alcohol use, either driving it or left behind by it. Treating only one side rarely holds for long.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0 0 12px;max-width:58ch;">That's why our clinical team treats substance use and mental health in the same plan from the start, rather than as separate programs you're referred between.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;max-width:58ch;">Detox, when needed, is managed with clinical support to make withdrawal safer and more comfortable. <a href="/programs/medication-assisted-treatment/" style="color:#2C5A64;font-weight:500;">Medication</a> may be part of the plan where appropriate, both for substance use and for the specific mental health condition involved, always determined by a psychiatrist, not assumed in advance. Individual, group, and family therapy address both sides of the picture together, and support groups remain part of ongoing recovery.</p>
        </div>
        <div style="display:grid;gap:20px;">
          <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:26px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">What integrated care looks like</div>
            <div style="display:grid;gap:14px;">
              {integrated.map((s) => (
                <div style="display:flex;gap:12px;align-items:flex-start;">
                  <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                    <Icon name="check" size={14} />
                  </span>
                  <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#3A444D;">{s}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #478694;border-radius:12px;padding:26px 26px;">
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Common signs</div>
            <div style="display:grid;gap:12px;">
              {signs.map((s) => (
                <div style="display:flex;gap:12px;align-items:flex-start;">
                  <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:6px;background:rgba(71,134,148,0.12);color:#2C5A64;margin-top:1px;">
                    <span class="msym" style="font-size:14px;">check</span>
                  </span>
                  <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#3A444D;">{s}</span>
                </div>
              ))}
            </div>
          </div>
          <div style="background:#FBEFEA;border:1px solid #E8B9A6;border-radius:12px;padding:22px 24px;">
            <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px;">
              <span class="msym" style="font-size:20px;color:#B4472A;">emergency</span>
              <div style="font-family:'Instrument Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:#B4472A;">A note on safety</div>
            </div>
            <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14.5px;line-height:1.6;color:#5A3A32;margin:0;">If suicidal thoughts or extreme mood changes are present, reaching out for immediate help matters, our admissions team is available 24/7.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  CONDITIONS & SUBSTANCES WE TREAT TOGETHER  ══════════════ */}
    <section data-screen-label="Conditions and substances" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1100px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Treated together</div>
        <h2 style={`${S.h2}max-width:34ch;`}>Conditions and substances we treat together</h2>
        <p style={`${S.intro}max-width:76ch;margin-bottom:30px;`}>These aren't separate tracks, whichever combination applies to you becomes one plan.</p>

        <div style="margin-bottom:30px;">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#646D76;margin-bottom:12px;">Mental health</div>
          <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;">
            {conditions.map(([name, href]) => (
              <a class="link-card" href={href} style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid #C9D2DA;border-radius:999px;padding:9px 16px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">{name}</a>
            ))}
          </div>
        </div>

        <div>
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#646D76;margin-bottom:12px;">Substances</div>
          <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:26px;">
            {substances.map(([name, href]) => (
              <a class="link-card" href={href} style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid #C9D2DA;border-radius:999px;padding:9px 16px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">{name}</a>
            ))}
          </div>
        </div>

        <a class="cta" href="/conditions/" style={`display:inline-block;${S.ctaBlue}`}>Browse All Conditions</a>
      </div>
    </section>

    {/* ══════════════  HOW WE TREAT DUAL DIAGNOSIS  ══════════════ */}
    <section data-screen-label="How we treat it" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How we help</div>
          <h2 style={`${S.h2}max-width:30ch;`}>How we treat dual diagnosis</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {care.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{c.icon}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{c.cta} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for dual-diagnosis treatment, before you commit to anything."
      background="#F7F5F1"
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:36ch;`}>Why choose Breathe for dual-diagnosis treatment</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{w.icon}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about dual diagnosis"
      intro="Straight answers about treatment order, detox, medication, and coverage."
      groups={[{ items: faqs }]}
      background="#F7F5F1"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* Placed after the FAQ/placeholder section on new pages (confirmed change
       — existing pages place it before the FAQ). */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are You Ready to Take the First Step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure, just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-19-outdoor-dining-deck.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
