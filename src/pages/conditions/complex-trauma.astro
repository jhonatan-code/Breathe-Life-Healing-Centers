---
import { msymChar } from "../../lib/icons";
/**
 * /conditions/complex-trauma/ — Complex Trauma / C-PTSD. Clinical content
 * and FAQ sourced from Breathe_Life_Complex_Trauma_Content_and_FAQ.docx
 * (2026-09-14), which defers to the BLHC Content Client Profile as
 * authoritative and is not going through further client/team review.
 * Distinct page from /conditions/trauma/ — complex/cumulative trauma vs.
 * single-incident/PTSD framing.
 *
 * Three corrections from the live page, per the brief, one since reversed:
 *  - Kathleen Murphy, named on the live page as the specialist leading this
 *    treatment (meta description and body copy), was originally left
 *    unnamed here pending confirmation of her current employment status.
 *    REVERSED per Jasmine's direct confirmation (2026-09-14): "if she was
 *    in recent reviews by clients then it's safe to assume she's still a
 *    provider there, unless we get told otherwise by client." She's now
 *    named below as "Kathleen Murphy, MA, LPC, Clinical Director" (the
 *    simpler of two credential variants seen on live sources, used until
 *    the "MA, LMFT, LPC" discrepancy is resolved). Her old extended bio
 *    (30 years' experience, University of Texas Austin, St. Edward's
 *    University, "founding Clinical Director") is deliberately NOT
 *    reintroduced, only her being a current provider is confirmed, not
 *    that specific bio text, which was never checked.
 *  - EMDR, listed twice on the live page (body copy and an already-built
 *    FAQ answer), is excluded, this is the first confirmed instance of EMDR
 *    specifically (as opposed to IFS) found in this project. Per Jasmine's
 *    direct instruction (2026-09-14), the EMDR replacement text now uses her
 *    exact approved phrase, "Trauma-focused therapy: Addressing what is
 *    underneath the substance use, not just the substance use itself," word
 *    for word, so this page matches the corresponding live-WordPress-site
 *    replacement exactly rather than only in principle.
 *  - Specific medications (Paxil, Zoloft) are not named, same rule as the
 *    depression and anxiety pages.
 *
 * The FAQ below replaces the (already-built, EMDR-referencing) FAQ on the
 * live page entirely, per the brief's own "FREQUENTLY ASKED QUESTIONS,
 * CORRECTED" heading.
 *
 * Structure mirrors /what-we-treat/cocaine.astro (shared components, same
 * card/pill/pillar patterns), condition-framed instead of substance-framed.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { galleryImg } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Complex Trauma / C-PTSD Treatment in Los Angeles | Breathe";
const description =
  "Complex trauma (C-PTSD) treatment in Los Angeles, integrated with substance-use care when the two overlap. LGBTQ+-affirming. In-network with most major insurers. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const care = [
  {
    icon: "cottage", title: "Residential Treatment", href: "/programs/residential-treatment/", cta: "Learn About Residential Treatment",
    text: "Full-time structure, daily therapy, and psychiatric support in one setting.",
  },
  {
    icon: "wb_sunny", title: "PHP, Day Treatment", href: "/programs/php/", cta: "Learn About PHP",
    text: "Intensive daytime treatment, returning home or to transitional living in the evenings.",
  },
  {
    icon: "calendar_month", title: "Intensive Outpatient (IOP)", href: "/programs/intensive-outpatient/", cta: "Learn About IOP",
    text: "A flexible schedule for people balancing treatment with work, school, or family.",
  },
  {
    icon: "spa", title: "Trauma-Focused Therapy", href: "/therapies/trauma-focused-therapy/", cta: "Learn About Trauma-Focused Therapy",
    text: "Care built around how trauma actually shows up, at a pace that's yours to set.",
  },
];

const related: [string, string][] = [
  ["Trauma", "/conditions/trauma/"],
  ["Depression", "/conditions/depression/"],
  ["Alcohol", "/what-we-treat/alcohol/"],
];

// Verbatim from Breathe_Life_Complex_Trauma_Content_and_FAQ.docx
// (2026-09-14), itself sourced from the live page. Excludes EMDR, named
// clinician attribution, and specific medications, see file header comment.
const causes = [
  "Repeated sexual, physical, or emotional abuse",
  "Chronic neglect or abandonment",
  "Repeated combat exposure",
  "Sustained captivity or trafficking",
];

const symptoms = [
  "Persistent sadness or explosive anger",
  "Hypervigilance and detachment from surroundings",
  "Feeling helpless, shameful, or guilty",
  "Isolation and difficulty trusting others",
  "Re-experiencing past trauma unexpectedly",
];

const faqs = [
  { q: "What is complex trauma?", a: "Complex trauma results from repeated or prolonged traumatic experiences, such as ongoing abuse, captivity, or chronic neglect, rather than a single traumatic event. It can affect a person's sense of safety, self-worth, and ability to trust others, and often requires a different treatment approach than single-incident PTSD." },
  { q: "How is complex PTSD treated?", a: "Treatment typically combines psychotherapy and, when appropriate, medication. Trauma-focused therapy: Addressing what is underneath the substance use, not just the substance use itself, applied through a structured phase-based approach that builds safety and coping skills before processing traumatic memories." },
  { q: "How long does complex trauma treatment take?", a: "Treatment length varies by individual, depending on the severity and duration of past trauma, co-occurring conditions, and each person's response to therapy. Our clinical team develops a personalized treatment plan and timeline during the initial assessment." },
  { q: "Is complex trauma treatment covered by insurance?", a: "Coverage depends on your specific insurance plan. Our admissions team can help verify your benefits and explain what your policy covers before you begin treatment." },
];

const why = [
  {
    icon: "healing", title: "Trauma-informed at every level",
    text: "Care built around how trauma actually shows up, woven into every level of treatment, not a separate track you have to ask for.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress. Open to anyone whose values align, without losing that center.",
  },
  {
    icon: "family_restroom", title: "Family involved, on your terms",
    text: "Family therapy that doesn't assume blood relationships. Partners and chosen family are welcome participants.",
  },
];

const pageUrl = new URL("/conditions/complex-trauma/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Conditions", item: new URL("/conditions/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Complex Trauma / C-PTSD", item: pageUrl },
      ],
    },
    {
      "@type": "MedicalWebPage",
      name: title,
      url: pageUrl,
      about: { "@type": "MedicalCondition", name: "Complex post-traumatic stress disorder" },
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/conditions/complex-trauma/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Conditions" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src={galleryImg("facility-06-guest-house-exterior.jpg")} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/conditions/" style="color:#7FB3BC;">Conditions</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Complex Trauma / C-PTSD
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Complex Trauma / C-PTSD Treatment in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Complex trauma builds up over time rather than from a single event, and it can shape how safe the world feels years later. Real treatment gives it the time and pace it actually needs.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING COMPLEX TRAUMA  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:32ch;`}>Understanding complex trauma</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>Complex trauma, sometimes called C-PTSD, tends to come from prolonged or repeated experiences rather than a single incident, and it can quietly shape how you relate to yourself and other people long after the circumstances have changed. Roughly 70 percent of Americans experience at least one traumatic event in their lives, according to the National Institute of Mental Health, though complex trauma specifically develops from repeated exposure, not a single event.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0 0 12px;max-width:58ch;">At Breathe, complex trauma is treated as its own focus, not an afterthought to substance use. When the two overlap, our clinical team treats both in the same plan, on the same timeline.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;max-width:58ch;">Trauma-focused therapy: Addressing what is underneath the substance use, not just the substance use itself. Our clinical team, led by Kathleen Murphy, MA, LPC, Clinical Director, applies a structured, phase-based approach: building safety and coping skills first, processing the trauma itself once that foundation is in place, and consolidating what's been gained.</p>
        </div>
        <div style="display:grid;gap:20px;">
          <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:26px 26px;">
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">What can lead to complex trauma</div>
            <div style="display:grid;gap:12px;">
              {causes.map((c) => (
                <div style="display:flex;gap:12px;align-items:flex-start;">
                  <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:6px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                    <span class="msym" style="font-size:14px;">{msymChar("check")}</span>
                  </span>
                  <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#3A444D;">{c}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #478694;border-radius:12px;padding:26px 26px;">
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Common symptoms</div>
            <div style="display:grid;gap:12px;">
              {symptoms.map((s) => (
                <div style="display:flex;gap:12px;align-items:flex-start;">
                  <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:6px;background:rgba(71,134,148,0.12);color:#2C5A64;margin-top:1px;">
                    <span class="msym" style="font-size:14px;">{msymChar("check")}</span>
                  </span>
                  <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#3A444D;">{s}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  HOW WE TREAT COMPLEX TRAUMA  ══════════════ */}
    <section data-screen-label="How we treat it" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How we help</div>
          <h2 style={`${S.h2}max-width:28ch;`}>How we treat complex trauma</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {care.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{c.cta} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  RELATED CONDITIONS  ══════════════ */}
    <section data-screen-label="Related conditions" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:860px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Dual diagnosis</div>
        <h2 style={`${S.h2}max-width:26ch;`}>Complex trauma rarely travels alone</h2>
        <p style={`${S.intro}max-width:76ch;margin-bottom:22px;`}>Complex trauma often overlaps with depression, anxiety, and substance use, either driving it or left behind by it. We treat what's actually happening, not only the trauma.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:26px;">
          {related.map(([name, href]) => (
            <a class="link-card" href={href} style="display:inline-flex;align-items:center;gap:8px;background:#F7F5F1;border:1px solid #C9D2DA;border-radius:999px;padding:9px 16px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">{name}</a>
          ))}
        </div>
        <a class="cta" href="/conditions/dual-diagnosis/" style={`display:inline-block;${S.ctaBlue}`}>Learn About Dual Diagnosis</a>
      </div>
    </section>

    <SiteInsurance
      background="#F7F5F1"
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for complex trauma treatment, before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:36ch;`}>Why choose Breathe for complex trauma treatment</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{msymChar(w.icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about complex trauma treatment"
      intro="Straight answers about diagnosis, treatment approach, timing, and coverage."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* Placed after the FAQ/placeholder section on new pages (confirmed change
       — existing pages place it before the FAQ). */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are You Ready to Take the First Step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure, just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-17-living-room-lounge.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
