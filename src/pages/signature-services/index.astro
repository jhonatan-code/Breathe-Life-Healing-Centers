---
import { msymChar } from "../../lib/icons";
/**
 * /signature-services/ — section hub for Breathe's three signature service
 * tracks (Chemsex & Sexualized Drug Use Treatment, LGBTQ+ Treatment, Flight
 * Attendant Program). Structural/marketing framing on the hub itself is
 * original. FAQ sourced from Breathe_Life_Signature_Services_FAQ.docx
 * (2026-09-14), which defers to the BLHC Content Client Profile as
 * authoritative and is not going through further client/team review, this
 * page previously had no FAQ section at all (same gap as the What We Treat
 * overview had before its own FAQ was added), added below, same placement
 * pattern: right after SiteLocation, before the mobile verify slot.
 *
 * Kathleen Murphy, credited on the live /breathe-services/ source page as
 * "founding Clinical Director" with a full present-tense biography, was
 * originally left unnamed here pending confirmation of her current
 * employment status, same exclusion applied on the Complex Trauma page.
 * REVERSED per Jasmine's direct confirmation (2026-09-14): "if she was in
 * recent reviews by clients then it's safe to assume she's still a
 * provider there, unless we get told otherwise by client." Named below as
 * "Kathleen Murphy, MA, LPC, Clinical Director" (the simpler of two
 * credential variants seen on live sources, until the "MA, LMFT, LPC"
 * discrepancy is resolved). Her old extended bio (30 years' experience,
 * University of Texas Austin, St. Edward's University, "founding Clinical
 * Director") is deliberately NOT reintroduced, only her being a current
 * provider is confirmed, not that specific bio text.
 *
 * The brief also flagged three technical bugs on the live source page that
 * are not content decisions for this repo: (1) its meta title reads
 * "Bulimia Treatment in Los Angeles," mismatched to the actual page
 * content, a template/metadata bug on whichever live page currently
 * carries it; (2) its closing paragraph has a stray "obsessing about your
 * meals" line, an eating-disorder reference on a page not about that
 * topic; (3) it names the same program both "3-Day Family Workshop" and
 * "5-Day Family Workshop" in different places, an inconsistency already
 * resolved by the consolidated /programs/family-program/ page in this
 * build. None of these three are acted on here, they belong to whoever
 * owns the live site.
 *
 * Pattern mirrors /programs/ (see BUILD NOTES there): hero without a
 * breadcrumb, card grid, SiteInsurance, pillars-row, SiteReviews,
 * SiteLocation.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { galleryImg } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Signature Services | Breathe Life Healing Centers";
const description =
  "Breathe's signature services, Chemsex & Sexualized Drug Use Treatment, LGBTQ+ Treatment, and the Flight Attendant Program. Built for people and situations general treatment often misses. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const services = [
  {
    icon: "favorite", title: "Chemsex & Sexualized Drug Use Treatment", href: "/signature-services/chemsex-treatment/",
    text: "A dedicated track for substance use tied to sex, intimacy, or identity, treated as its own clinical issue, judgment-free, and never folded into general sex addiction treatment.",
  },
  {
    icon: "diversity_3", title: "LGBTQ+ Treatment", href: "/signature-services/lgbtq/",
    text: "Identity- and gender-affirming care woven into every level of treatment we offer, built for the LGBTQ+ community first, open to anyone whose values align.",
  },
  {
    icon: "flight", title: "Flight Attendant Program", href: "/signature-services/flight-attendant-program/",
    text: "Treatment shaped around airline rosters, union benefits, and the specific pressures of flight crew work, from a team that knows the job.",
  },
];

// FAQ #2's answer is reworded from the brief to not open with "No" (which
// faq.md prohibits) while keeping the same meaning. Every other answer is
// verbatim from Breathe_Life_Signature_Services_FAQ.docx (2026-09-14).
const faqs = [
  { q: "What makes a Signature Service different from a regular program?", a: "These three tracks exist because a standard program doesn't always fit. They're built around specific situations, chemsex, LGBTQ+ identity, or flight attendant work, not adapted from a generic template." },
  { q: "Do I need to fit one of these three categories to be treated here?", a: "These are specialized tracks for specific situations, not a requirement. Our full range of programs and levels of care are available to anyone." },
  { q: "Can I access a Signature Service alongside standard levels of care, like Residential or IOP?", a: "Yes. These tracks run alongside your primary level of care, not as a replacement for it." },
  { q: "Is the Chemsex track only for people who identify as LGBTQ+?", a: "Chemsex shows up most often in gay and queer men's communities, and that shapes how the track is built, but it's open to anyone experiencing this pattern." },
  { q: "How is the Flight Attendant Program different from general treatment?", a: "It's shaped around the real constraints of the job, airline schedules, union benefits, and the specific pressures of flight crew work, not a generic program with the job title attached." },
  { q: "Does insurance cover treatment through a Signature Service?", a: "In most cases, yes. Our admissions team [verifies your specific benefits](/admissions/insurance/) and explains what's covered before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

const why = [
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
  {
    icon: "target", title: "Specialized, not generic",
    text: "These tracks exist because a standard program doesn't always fit. They're built around specific people and specific situations, on purpose.",
  },
  {
    icon: "family_restroom", title: "Family involved, on your terms",
    text: "Family therapy that doesn't assume blood relationships. Partners and chosen family are welcome participants.",
  },
];

const pageUrl = new URL("/signature-services/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Signature Services", item: pageUrl },
      ],
    },
    {
      "@type": "ItemList",
      name: "Signature Services",
      itemListElement: services.map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: s.title,
        url: new URL(s.href, site.domain).href,
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/signature-services/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Signature Services" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src={galleryImg("facility-20-estate-entrance-gate.jpg")} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.85;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.84) 48%,rgba(22,41,61,0.55) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Signature Services
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Specialized Treatment Programs: Built Around Who You Actually Are</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Some situations need more than a generic program. These are the parts of Breathe built specifically around them, not bolted on, not an afterthought.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  WHY THESE EXIST  ══════════════ */}
    <section data-screen-label="Why signature services" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;right:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:900px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Why these exist</div>
        <h2 style={`${S.h2}max-width:30ch;`}>Specialized Care Beyond Standard Programs</h2>
        <p style={`${S.intro}max-width:78ch;margin-bottom:14px;`}>General addiction and mental health treatment works for a lot of people, but it doesn't account for everything, a substance pattern tied to sex or identity, a life built around airline schedules, or the specific weight of being LGBTQ+ in a world that isn't always safe to be honest in. We built these three tracks because those situations deserve treatment that actually understands them, not a version of care that has to be explained from scratch.</p>
        <p style={`${S.intro}max-width:78ch;`}>These tracks are overseen by Kathleen Murphy, MA, LPC, Clinical Director.</p>
      </div>
    </section>

    {/* ══════════════  SERVICES GRID  ══════════════ */}
    <section data-screen-label="Signature services" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Explore</div>
          <h2 style={`${S.h2}max-width:26ch;`}>Our signature services</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px;">
          {services.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:16px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:32px 28px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:12px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:26px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:21px;font-weight:600;letter-spacing:-0.016em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{`Learn About Our ${c.title}`} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered, before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why choose Breathe</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{msymChar(w.icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about signature services"
      intro="Straight answers about fit, eligibility, and coverage."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* The #verify form lives in the hero on desktop; VerifyInsuranceForm's
       script relocates the form node into #verify-mobile-slot at ≤1024px —
       lands right before the Final CTA, after the FAQ above. */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Not sure which service is right for you?"
      subhead="Our admissions team talks through your situation first, then matches you to the right starting point. No pressure, no obligation."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-15-pool-deck-canyon-view.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
