---
/**
 * /signature-services/chemsex-treatment/ — Chemsex & Sexualized Drug Use
 * Treatment. This is the live destination for the "Learn About Chemsex
 * Treatment" CTA already shipped on /what-we-treat/methamphetamine/ (its
 * "Chemsex context" section), so this page needs to deliver on that link.
 *
 * FAQ sourced from Breathe_Life_Chemsex_FAQ.docx (2026-09-14), which
 * defers to the BLHC Content Client Profile as authoritative and is not
 * going through further client/team review. Consistent with the rest of
 * this page and CLAUDE.md: chemsex is never conflated with sex addiction
 * below, treated throughout as its own distinct clinical issue, and no
 * IFS, contingency management, or named individual appears in any answer.
 *
 * RESOLVED (per Breathe_Life_Claude_Code_Instructions.docx, confirmed by
 * Jasmine, 2026-09-14): "Crystal Clear" (the meth page's former proprietary
 * program name for meth use tied to sex/identity) is renamed sitewide to
 * "Chemsex Programming." This page is that program's live destination,
 * methamphetamine.astro's "Chemsex Programming" card and "Chemsex context"
 * section both now link here directly.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { galleryImg } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Chemsex & Sexualized Drug Use Treatment in Los Angeles | Breathe";
const description =
  "Dedicated treatment for chemsex and sexualized drug use in Los Angeles, substance use tied to sex, intimacy, or identity, treated as its own clinical issue. LGBTQ+-affirming. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const different = [
  {
    icon: "shield", title: "Treated as its own issue",
    text: "Sexualized drug use isn't sex addiction, and we don't treat it as one. It gets its own clinical picture, not a category borrowed from somewhere else.",
  },
  {
    icon: "lock", title: "A team that won't flinch",
    text: "You won't be the first person to bring this into the room. Clinicians here are trained specifically for this conversation, not just addiction in general.",
  },
  {
    icon: "layers", title: "Works alongside standard care",
    text: "This track runs together with medical detox, residential treatment, and PHP/IOP, not instead of them. One coordinated plan, not two separate programs.",
  },
  {
    icon: "diversity_3", title: "Built with our community in mind",
    text: "Chemsex and sexualized drug use come up most often in LGBTQ+ men's spaces, and that context shapes how we built this track. It's not limited to that population.",
  },
];

// FAQ #1 and #2's answers are reworded from the brief to not open with "No"
// (which faq.md prohibits) while keeping the same meaning. Every other
// answer is verbatim from Breathe_Life_Chemsex_FAQ.docx (2026-09-14).
const faqs = [
  { q: "Is chemsex the same as sex addiction?", a: "Chemsex is a substance use pattern tied to sexual context, not sex addiction. We treat it as its own distinct clinical issue, not folded into that category." },
  { q: "Will I be judged for how I have sex, or who I have it with?", a: "This track is sex-positive and identity-affirming. The substance use is what we treat, not your sexuality or how you express it." },
  { q: "What substances does this cover?", a: "Methamphetamine, GHB, mephedrone, ketamine, cocaine, and other substances used in sexualized contexts." },
  { q: "Is this only for gay or bisexual men?", a: "Chemsex shows up most often in gay and queer men's spaces, and that shapes how this track is built, but it's open to anyone experiencing this pattern." },
  { q: "Will my HIV status or sexual health history be treated with respect?", a: "Yes. HIV-positive clients are welcomed and treated with clinical competence, not just tolerance." },
  { q: "How does this run alongside standard treatment, like detox or residential care?", a: "This track runs together with medical detox, residential care, and PHP or IOP, one coordinated plan, not two separate programs." },
  { q: "Does insurance cover treatment through this track?", a: "In most cases, yes. We're in-network with most major providers and verify your specific benefits before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

const why = [
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress. Open to anyone whose values align, without losing that center.",
  },
  {
    icon: "lock", title: "Your privacy, protected",
    text: "Confidentiality built into every part of how we operate, care that respects who knows you're here, on your terms.",
  },
];

const pageUrl = new URL("/signature-services/chemsex-treatment/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Signature Services", item: new URL("/signature-services/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Chemsex & Sexualized Drug Use Treatment", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/signature-services/chemsex-treatment/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Signature Services" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src={galleryImg("facility-17-living-room-lounge.jpg")} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/signature-services/" style="color:#7FB3BC;">Signature Services</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Chemsex & Sexualized Drug Use Treatment
          </nav>
          <h1 style="font-size:clamp(34px,4vw,54px);line-height:1.08;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Chemsex & Sexualized Drug Use Treatment in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">When substance use gets tied to sex, intimacy, or identity, generic addiction treatment often misses what's actually going on. This is treatment built for that, specifically.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  WHAT THIS IS  ══════════════ */}
    <section data-screen-label="What this is" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:900px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>What this is</div>
        <h2 style={`${S.h2}max-width:34ch;`}>A dedicated track, not a footnote in general treatment</h2>
        <p style={`${S.intro}max-width:78ch;margin-bottom:16px;`}>Chemsex & Sexualized Drug Use Treatment is for anyone whose substance use has become tangled up with sex, intimacy, hookup culture, or identity, whether that means using to get in the mood, to stay in the moment longer, or to feel comfortable being seen at all. It's one of the few dedicated programs of its kind, and it exists because this pattern deserves its own clinical attention, not a generic addiction script.</p>
        <p style={`${S.intro}max-width:78ch;margin-bottom:16px;`}>This is <strong>not</strong> sex addiction treatment, and we don't treat it as one. Sexualized drug use is its own clinical issue, distinct from compulsive sexual behavior, and folding the two together tends to miss both.</p>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;max-width:70ch;">This pattern shows up most often alongside methamphetamine use, and it's the reason our <a href="/what-we-treat/methamphetamine/" style="color:#33679C;font-weight:600;">Methamphetamine page</a> points here, but it isn't limited to one substance, and it doesn't require a meth-specific starting point to get help.</p>
      </div>
    </section>

    {/* ══════════════  WHAT MAKES THIS DIFFERENT  ══════════════ */}
    <section data-screen-label="What makes this different" style="padding:70px 37px;background:#F0F5FA;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How it works</div>
          <h2 style={`${S.h2}max-width:30ch;`}>What makes this different</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {different.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{c.icon}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  RELATED SIGNATURE SERVICE  ══════════════ */}
    <section data-screen-label="Related" style="padding:56px 37px;background:#FFFFFF;">
      <div style="max-width:1060px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Also built for our community</div>
        <h2 style={`${S.h2}max-width:36ch;`}>This track runs alongside our LGBTQ+ Treatment approach</h2>
        <p style={`${S.intro}max-width:76ch;margin-bottom:24px;`}>Chemsex and sexualized drug use come up most often in LGBTQ+ men's spaces, so this track and our identity-affirming care are built to work together, not as two separate doors.</p>
        <a class="cta" href="/signature-services/lgbtq/" style={`display:inline-block;${S.ctaBlue}`}>Learn About LGBTQ+ Treatment</a>
      </div>
    </section>

    <SiteInsurance
      background="#F7F5F1"
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered, before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why choose Breathe for this</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{w.icon}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about this track"
      intro="Straight answers about how this differs from sex addiction treatment, who it's for, and coverage."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* Placed after the FAQ placeholder / before the Final CTA per this
       batch's placement rule (existing pages place it before the FAQ). */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are you ready to take the first step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure, just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-13-ensuite-bath-balcony.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
