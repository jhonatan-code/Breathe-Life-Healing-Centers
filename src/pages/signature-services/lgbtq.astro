---
import { msymChar } from "../../lib/icons";
/**
 * /signature-services/lgbtq/ — the LGBTQIA+ pillar page (ClickUp, 2026-10-14).
 *
 * The site was repositioned as a drug and alcohol detox and residential
 * treatment center; LGBTQ language was toned down everywhere else and all
 * LGBTQIA+ content now lives here, linked from the footer and the relevant
 * program pages. Structure approved in the Artifact preview
 * ("Breathe LGBTQIA+ Pillar"): why it matters, what affirming care means at
 * Breathe, approach/treatments/modalities, a short chemsex section.
 *
 * Copy is reused from what was already approved on this page, on
 * /therapies/gender-affirming-care/ and on /signature-services/chemsex-treatment/
 * (FAQ answers from Breathe_Life_LGBTQ_Treatment_FAQ.docx, 2026-09-14). FAQ #1
 * was rewritten for the new positioning. No new statistics: clinician input
 * from the questionnaire meeting goes into the approach section once
 * Elizabeth adds it to the task.
 *
 * Wording rule: "Breathe offers LGBTQIA+ affirming care", never "LGBTQ
 * therapy". Never call being LGBTQ+ a "lifestyle"; never conflate chemsex
 * with sex addiction; "family" includes partners and chosen family.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { galleryImg, team, reviews } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "LGBTQIA+ Affirming Addiction Treatment in Los Angeles | Breathe";
const description =
  "Breathe offers LGBTQIA+ affirming care at every level of drug and alcohol treatment in Los Angeles, from medical detox and residential care through outpatient. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

// What affirming care means at Breathe: from this page's earlier "different"
// cards and /therapies/gender-affirming-care/.
const commitments = [
  { icon: "badge", title: "Correct names and pronouns", text: "From the first phone call, not after an adjustment period. It shouldn't be something you have to ask for twice." },
  { icon: "psychology", title: "Clinicians trained in minority stress", text: "A team that includes LGBTQIA+ people and allies, trained in the minority stress model and the trauma pathways common in LGBTQIA+, trans and nonbinary experience." },
  { icon: "home_health", title: "Gender-appropriate facilities", text: "Access to gender-appropriate facilities and living arrangements is part of how care is structured on campus." },
  { icon: "family_restroom", title: "Chosen family welcomed", text: "Partners and chosen family are valid participants in family therapy and the in-person 3-Day Family Workshop, open to clients in PHP or IOP with therapist approval." },
];

// Levels of care, short labels; links are the real program pages.
const ladder = [
  { label: "Medical Detox", sub: "Withdrawal managed around the clock", href: "/programs/medical-detox/" },
  { label: "Residential", sub: "Laurel Canyon campus, 24/7", href: "/programs/residential-treatment/" },
  { label: "PHP", sub: "Full clinical days", href: "/programs/php/" },
  { label: "IOP", sub: "Treatment around your schedule", href: "/programs/intensive-outpatient/" },
  { label: "Outpatient", sub: "Ongoing support", href: "/programs/outpatient-rehab/" },
  { label: "Sober Living", sub: "Substance-free home base", href: "/programs/sober-living/" },
];

// Modalities: each links to its existing therapy page. Clinician input from
// the questionnaire meeting is added here when Elizabeth posts it.
const modalities = [
  { icon: "healing", title: "Trauma-Focused Therapy", text: "Care shaped around how trauma actually presents, including the identity-related trauma many clients carry.", links: [["Trauma-focused therapy", "/therapies/trauma-focused-therapy/"]] },
  { icon: "diversity_3", title: "Gender-Affirming Care", text: "Shapes how every therapy is delivered, from the name on your chart to how your family is involved.", links: [["Gender-affirming care", "/therapies/gender-affirming-care/"]] },
  { icon: "psychology", title: "CBT, DBT and Motivational Interviewing", text: "Practical skills for cravings, emotions and relationships, built in process groups, skills-based groups and psychoeducation, then applied to the stressors in your actual life.", links: [["CBT", "/therapies/cbt/"], ["DBT", "/therapies/dbt/"], ["Motivational interviewing", "/therapies/motivational-interviewing/"]] },
  { icon: "self_improvement", title: "Somatic Therapy", text: "Body-based work for stress and trauma that talk therapy alone doesn't always reach.", links: [["Somatic therapy", "/therapies/somatic-therapy/"]] },
  { icon: "family_restroom", title: "Family Program", text: "For clients in PHP or IOP, with therapist approval: family therapy in person or online, plus the in-person 3-Day Family Workshop, with chosen family included.", links: [["Family program", "/programs/family-program/"]] },
  { icon: "palette", title: "Experiential and Holistic", text: "Yoga, mindfulness, breathwork, sound baths, art and music alongside clinical care, for the parts of recovery that aren't about talking.", links: [["Experiential therapies", "/therapies/experiential-therapies/"], ["Yoga and mindfulness", "/therapies/yoga-mindfulness/"]] },
];

// Beck Gee shown inside the "Staff Who've Lived It" card (from data/home.ts `team`).
const beck = team.find((t) => t.slug === "beck-gee")!;
// Verbatim excerpt from Stephen Timmer's review in data/home.ts `reviews`.
const proofQuote = reviews.find((r) => r.name === "Stephen Timmer")!;
const proofExcerpt =
  "I have brought LGBTQ clients and straight or cis gender clients and both are welcomed equally and given the same overwhelming amount of love and acceptance.";

const faqs = [
  { q: "Is Breathe only for LGBTQIA+ clients?", a: "Breathe is a drug and alcohol detox and residential treatment center open to everyone. We fully support every client, regardless of gender identity or expression, biological sex, sexual orientation or race. LGBTQIA+ affirming care is part of every level of treatment, and every client is held to the same standard of care." },
  { q: "What does gender-affirming care actually look like day to day?", a: "Correct names and pronouns from the first phone call, not after an adjustment period, and access to gender-appropriate facilities. Staff are trained in the specific weight of being LGBTQIA+ in addiction and mental health treatment, not just in general. More on [gender-affirming care](/therapies/gender-affirming-care/)." },
  { q: "Does 'family' in your programming mean my biological family?", a: "Partners, chosen family, and community are valid participants in [family therapy](/programs/family-program/), our 3-Day Family Workshop, and every other part of how we involve the people who matter to you. The family program begins once you step down to PHP or IOP, with your therapist's approval. During residential care, your care team keeps them informed." },
  { q: "Will I be treated by staff who understand LGBTQIA+ experience specifically?", a: "Yes. Our team includes LGBTQIA+ people and allies, and staff here are trained in minority stress and the specific weight of being LGBTQIA+, not general sensitivity training applied to every population." },
  { q: "Is chemsex treatment part of this, or a separate thing?", a: "[Chemsex and Sexualized Drug Use Treatment](/signature-services/chemsex-treatment/) is a dedicated track that runs alongside affirming care. It is open to anyone, regardless of sexual orientation or gender identity." },
  { q: "Does insurance cover this the same way as standard treatment?", a: "Yes. In most cases, we're in-network with most major providers and [verify your specific benefits](/admissions/insurance/) before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

const why: [string, string, string, string][] = [
  ["diversity_3", "#33679C", "LGBTQIA+ Affirming Care at Every Level", "Gender-affirming, identity-affirming clinical care, clinicians who understand minority stress and staff who use your pronouns without being asked twice."],
  ["volunteer_activism", "#478694", "Staff Who've Lived It", "Many of our team members, from the front desk to clinical leadership, have personal recovery experience, so you're not being treated only by people who studied it from the outside."],
  ["family_restroom", "#33679C", "Chosen Family Welcome in Programming", "Once you step down to PHP or IOP, family therapy and an in-person 3-Day Family Workshop, with room for chosen family, not only family of origin."],
  ["lock", "#33679C", "Your Privacy, Protected", "Confidentiality built into every part of how we operate, care that respects who knows you're here, on your terms."],
];

const pageUrl = new URL("/signature-services/lgbtq/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Signature Services", item: new URL("/signature-services/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "LGBTQIA+ Affirming Care", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/signature-services/lgbtq/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Signature Services" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#32679C;">
      <img src={galleryImg("facility-18-great-room.jpg")} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/signature-services/" style="color:#7FB3BC;">Signature Services</a> <span aria-hidden="true" style="opacity:0.6;">›</span> LGBTQIA+ Affirming Care
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">LGBTQIA+ Affirming Addiction Treatment in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Breathe offers LGBTQIA+ affirming care at every level of treatment, from medical detox and residential care through outpatient. Same clinical team, same standard of care, and nothing to explain about who you are.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered, before you commit to anything."
    />


    {/* ══════════════  WHY IT MATTERS  ══════════════ */}
    <section data-screen-label="Why it matters" style="padding:70px 37px;background:#FFFFFF;">
      <div class="pillar-split" style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:56px;align-items:center;">
        <div>
          <div style={S.eyebrow}>Why it matters</div>
          <h2 style={`${S.h2}margin-left:0;max-width:24ch;`}>Why LGBTQIA+ Affirming Treatment Matters</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:68ch;`}>Recovery takes enough energy without also managing how you're perceived. For many LGBTQIA+ people, drug and alcohol use is tangled up with rejection, minority stress, or trauma, and treatment that skips over that part tends to miss what's actually going on.</p>
          <p style={`${S.intro}margin:0 0 16px;max-width:68ch;`}>When you have to correct your name, defend your relationship, or decide how much of yourself is safe to share, that energy comes straight out of recovery. Affirming care takes that work off your plate so you can put it where it belongs.</p>
          <p style={`${S.intro}margin:0;max-width:68ch;`}>Breathe has particular expertise and cultural competency in serving the LGBTQ+ community, while providing inclusive, affirming care for anyone experiencing chemsex or sexualized drug use, regardless of sexual orientation or gender identity.</p>
        </div>
        <img src={galleryImg("facility-21-quiet-reading-nook.jpg")} alt="Quiet reading nook at the Breathe Life residence" loading="lazy" style="width:100%;max-width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px;display:block;" />
      </div>
    </section>

    {/* ══════════════  WHAT AFFIRMING CARE MEANS  ══════════════ */}
    <section data-screen-label="What affirming care means" style="padding:70px 37px;background:#F0F5FA;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>At Breathe</div>
          <h2 style={`${S.h2}max-width:30ch;`}>What Affirming Care Means at Breathe</h2>
          <p style={`${S.intro}max-width:80ch;`}>Affirming care is part of every level of treatment here, not a separate track added to a program built with someone else in mind. Breathe is open to everyone and fully supports every client, regardless of gender identity or expression, biological sex, sexual orientation or race. Our team includes LGBTQIA+ people and allies, and every client is held to the same standard of care.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;">
          {commitments.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  APPROACH, TREATMENTS & MODALITIES  ══════════════ */}
    <section data-screen-label="Approach" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1200px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Our approach</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Our Approach, Treatments and Modalities</h2>
          <p style={`${S.intro}max-width:80ch;`}>Affirming care runs through the full continuum, so moving from detox to residential to outpatient never means starting over with a new team or explaining yourself again.</p>
        </div>
        <ol class="pillar-ladder" aria-label="Levels of care" style="list-style:none;margin:0 0 34px;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border:1px solid #E2DED7;border-radius:12px;overflow:hidden;background:#FFFFFF;">
          {ladder.map((l) => (
            <li style="min-width:0;">
              <a href={l.href} style="display:block;height:100%;box-sizing:border-box;padding:16px 14px;color:#14181C;text-decoration:none;">
                <span style="display:block;font-size:15px;font-weight:600;letter-spacing:-0.01em;">{l.label}</span>
                <span style="display:block;font-family:'Montserrat',Helvetica,sans-serif;font-size:12.5px;line-height:1.45;color:#3A444D;margin-top:4px;">{l.sub}</span>
              </a>
            </li>
          ))}
        </ol>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;">
          {modalities.map((m, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:12px;background:#FFFFFF;border:1px solid #E2DED7;border-radius:12px;padding:26px 24px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(m.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{m.title}</h3>
                <p style={`${S.card}flex:1;`}>{m.text}</p>
                <div style="display:flex;flex-wrap:wrap;gap:6px 16px;">
                  {m.links.map(([label, href]) => (
                    <a href={href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{label} <span aria-hidden="true">→</span></a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  CHEMSEX (short)  ══════════════ */}
    <section data-screen-label="Chemsex" style="padding:70px 37px;background:#32679C;">
      <div class="pillar-split" style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:56px;align-items:center;">
        <div>
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#E6EDF4;margin-bottom:14px;">Chemsex</div>
          <h2 style={`${S.h2}margin-left:0;color:#FFFFFF;max-width:24ch;`}>Chemsex and Sexualized Drug Use</h2>
          <p style={`${S.intro}color:#DCE6EF;margin:0 0 16px;max-width:64ch;`}>Chemsex is substance use that has become tied to sex, intimacy or hookup culture, most often involving methamphetamine. It is its own clinical issue, and Breathe does not treat it as sex addiction.</p>
          <p style={`${S.intro}color:#DCE6EF;margin:0 0 26px;max-width:64ch;`}>Our dedicated chemsex track is compassionate, nonjudgmental and sex positive, with three chemsex groups each week at every level of care. It works alongside affirming care and is open to anyone, regardless of sexual orientation or gender identity.</p>
          <a class="cta cta--light" href="/signature-services/chemsex-treatment/" style={S.ctaWhite}>Learn About Chemsex Treatment</a>
        </div>
        <img src={galleryImg("facility-24-residence-lounge-deck.jpg")} alt="Residence lounge deck at the Breathe Life campus" loading="lazy" style="width:100%;max-width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px;display:block;" />
      </div>
    </section>

    {/* ══════════════  PULL QUOTE — SOURCED REVIEW  ══════════════ */}
    <section data-screen-label="Proof quote" style="position:relative;overflow:hidden;background:#F7F5F1;padding:70px 37px;">
      <div style="position:relative;max-width:840px;margin:0 auto;text-align:center;">
        <div style="width:1px;height:32px;background:#7FB3BC;margin:0 auto 22px;"></div>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(19px,2.2vw,26px);line-height:1.5;font-weight:400;color:#16293D;margin:0 auto 22px;max-width:38ch;">"{proofExcerpt}"</p>
        <div style="display:flex;align-items:center;justify-content:center;gap:12px;">
          <img src={proofQuote.avatar} alt={proofQuote.name} width="36" height="36" style="width:36px;height:36px;border-radius:999px;" />
          <span style="font-family:'Instrument Sans',sans-serif;font-size:14px;color:#3A444D;">{proofQuote.name}, Interventionist · Google review</span>
        </div>
      </div>
    </section>

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why Choose Breathe for LGBTQIA+ Affirming Care</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;">
          {why.map(([icon, color, h, p]) => (
            <div style="padding:32px 30px;">
              <span style={`display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:${color === "#478694" ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};margin-bottom:16px;`}>
                <span class="msym" style={`font-size:24px;color:${color === "#478694" ? "#2C5A64" : "#33679C"};`}>{msymChar(icon)}</span>
              </span>
              <h3 style="font-size:18px;font-weight:600;letter-spacing:-0.012em;margin:0 0 10px;text-wrap:balance;">{h}</h3>
              <p style={S.card}>{p}</p>
              {h === "Staff Who've Lived It" && (
                <div style="display:flex;align-items:center;gap:10px;margin-top:16px;padding-top:16px;border-top:1px solid #E2DED7;">
                  <img src={beck.photo} alt={beck.name} style="width:38px;height:38px;border-radius:999px;object-fit:cover;flex:0 0 auto;" />
                  <div>
                    <div style="font-size:13px;font-weight:600;color:#14181C;line-height:1.3;">{beck.name}</div>
                    <div style="font-family:'Instrument Sans',sans-serif;font-size:11.5px;color:#646D76;line-height:1.3;">{beck.role}</div>
                  </div>
