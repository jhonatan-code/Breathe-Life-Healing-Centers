---
/**
 * /about/our-team/bill-reilly/ — real profile. Bio sourced verbatim from the
 * official live site's own dedicated page
 * (breathelifehealingcenters.com/our-team/bill-reilly-cadc-ii/, checked
 * 2026-09-02) — the client's own real content, per this session's standing
 * instruction to check the official site rather than placeholder gaps. Note:
 * unlike most bios on the official site, Bill's is written in third person
 * (not first person) and is a single short paragraph — preserved verbatim as
 * published, not rewritten into first person. Not in src/data/home.ts (that
 * array only carries leadership), so name/role/photo/badge are defined
 * directly here.
 */
import Layout from "../../../layouts/Layout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteFinalCTA from "../../../components/SiteFinalCTA.astro";
import TeamProfile from "../../../components/TeamProfile.astro";
import { site } from "../../../config/site";

const person = {
  name: "Bill Reilly, CADC-II",
  role: "Group Facilitator",
  photo: "/Asset/Our%20Team/bill-reilly.png",
  badge: "CADC-II",
};

const fullBio = [
  "Bill is an addiction specialist with extensive experience bringing diversity in therapeutic counseling techniques for groups and individuals. Derivative expertise founded in over 30 years of personal experience working with addicted populations in a private setting. Innovative and analytical individual recognized for melding holistic and traditional therapeutic approaches to help the addicted population waken to what is possible in recovery.",
];

const title = "Bill Reilly, CADC-II | Group Facilitator | Breathe Life Healing Centers";
const description = "Bill Reilly, CADC-II, is a Group Facilitator at Breathe Life Healing Centers with over 30 years of experience working with addicted populations.";

const pageUrl = new URL("/about/our-team/bill-reilly/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Our Team", item: new URL("/about/our-team/", site.domain).href },
        { "@type": "ListItem", position: 4, name: person.name, item: pageUrl },
      ],
    },
    {
      "@type": "Person",
      name: person.name,
      jobTitle: person.role,
      image: new URL(person.photo, site.domain).href,
      url: pageUrl,
      worksFor: { "@id": new URL("/#organization", site.domain).href },
    },
    { "@type": "Organization", "@id": new URL("/#organization", site.domain).href, name: site.name, url: site.domain },
  ],
};
---

<Layout title={title} description={description} path="/about/our-team/bill-reilly/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="About" />

    <main id="main">

    <TeamProfile name={person.name} role={person.role} badge={person.badge} photo={person.photo} slug="bill-reilly" fullBio={fullBio} />

    <SiteFinalCTA
      heading="Talk to someone who's been where you are"
      subhead="Every clinician on staff has personal recovery experience — you won't have to explain yourself to someone who's only read about it."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-07-pool-waterfall-grotto.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>
