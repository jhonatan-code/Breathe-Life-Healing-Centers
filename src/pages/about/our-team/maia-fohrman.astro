---
/**
 * /about/our-team/maia-fohrman/ — new Clinical team member added per client
 * (2026-10-30): name and credentials only. No bio prose or headshot yet,
 * so no bio section and the site's standard "B" no-photo placeholder.
 */
import Layout from "../../../layouts/Layout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteFinalCTA from "../../../components/SiteFinalCTA.astro";
import TeamProfile from "../../../components/TeamProfile.astro";
import { site } from "../../../config/site";

const name = "Maia Fohrman, LCSW, CSAT";
const role = "Therapist";
const photo = "/Asset/Our%20Team/no-photo.jpg";

const title = "Maia Fohrman, LCSW, CSAT | Therapist | Breathe Life Healing Centers";
const description = "Maia Fohrman, LCSW, CSAT is a Therapist at Breathe Life Healing Centers.";

const pageUrl = new URL("/about/our-team/maia-fohrman/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Our Team", item: new URL("/about/our-team/", site.domain).href },
        { "@type": "ListItem", position: 4, name: name, item: pageUrl },
      ],
    },
    {
      "@type": "Person",
      name: name,
      jobTitle: role,
      image: new URL(photo, site.domain).href,
      url: pageUrl,
      worksFor: { "@id": new URL("/#organization", site.domain).href },
    },
    { "@type": "Organization", "@id": new URL("/#organization", site.domain).href, name: site.name, url: site.domain },
  ],
};
---

<Layout title={title} description={description} path="/about/our-team/maia-fohrman/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="About" />

    <main id="main">

    <TeamProfile name={name} role={role} photo={photo} slug="maia-fohrman" />

    <SiteFinalCTA
      heading="Talk to someone who's been where you are"
      subhead="Many of our team members have personal recovery experience, so you won't have to explain yourself to someone who's only read about it."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/campus-40-lounge.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>
