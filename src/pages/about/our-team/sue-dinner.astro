---
/**
 * /about/our-team/sue-dinner/ — placeholder profile. The official live
 * site's dedicated page
 * (breathelifehealingcenters.com/our-team/sue-dinner/, checked 2026-09-02)
 * carries only a name, title, and (no real headshot) photo — no bio prose
 * exists there to recover. Per CLAUDE.md / the standing rule never to invent
 * YMYL content without a brief, the bio section below uses
 * ClinicalPlaceholder rather than fabricated copy — see
 * src/pages/about/our-team/brad-lamm.astro for the pattern this follows.
 * Not in src/data/home.ts (that array only carries leadership), so
 * name/role/photo/badge are defined directly here.
 */
import Layout from "../../../layouts/Layout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteFinalCTA from "../../../components/SiteFinalCTA.astro";
import TeamProfile from "../../../components/TeamProfile.astro";
import { site } from "../../../config/site";

const person = {
  name: "Sue Dinner",
  role: "Group Facilitator",
  photo: "/Asset/Our%20Team/no-photo.jpg",
  badge: "",
};

const title = "Sue Dinner | Group Facilitator | Breathe Life Healing Centers";
const description = "Sue Dinner is a Group Facilitator at Breathe Life Healing Centers.";

const pageUrl = new URL("/about/our-team/sue-dinner/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Our Team", item: new URL("/about/our-team/", site.domain).href },
        { "@type": "ListItem", position: 4, name: person.name, item: pageUrl },
      ],
    },
    {
      "@type": "Person",
      name: person.name,
      jobTitle: person.role,
      image: new URL(person.photo, site.domain).href,
      url: pageUrl,
      worksFor: { "@id": new URL("/#organization", site.domain).href },
    },
    { "@type": "Organization", "@id": new URL("/#organization", site.domain).href, name: site.name, url: site.domain },
  ],
};
---

<Layout title={title} description={description} path="/about/our-team/sue-dinner/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="About" />

    <main id="main">

    <TeamProfile name={person.name} role={person.role} badge={person.badge} photo={person.photo} slug="sue-dinner" />

    <SiteFinalCTA
      heading="Talk to someone who's been where you are"
      subhead="Every clinician on staff has personal recovery experience — you won't have to explain yourself to someone who's only read about it."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-18-great-room.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>
