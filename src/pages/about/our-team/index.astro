---
/**
 * /about/our-team/ — team overview. Card grid of the `team` array
 * (src/data/home.ts) mirroring the homepage's gradient-scrim photo cards.
 *
 * Brad Lamm is included as a card/link like every other leader; his bio
 * page (/about/our-team/brad-lamm.astro) now carries his real bio — the
 * placeholder block on it was explicitly lifted by the user 2026-09-15
 * (see CLAUDE.md).
 */
import Layout from "../../../layouts/Layout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteFinalCTA from "../../../components/SiteFinalCTA.astro";
import { site } from "../../../config/site";
import { deptSlug, tabGroups, totalPeople } from "../../../data/team-roster";

const title = "Our Team | Breathe Life Healing Centers";
const description =
  "Meet the people behind Breathe Life Healing Centers, the leadership team guiding our LGBTQ+-affirming treatment community in Los Angeles.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
};

const pageUrl = new URL("/about/our-team/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Our Team", item: pageUrl },
      ],
    },
    { "@type": "AboutPage", name: title, url: pageUrl },
  ],
};
---

<Layout title={title} description={description} path="/about/our-team/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="About" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-17-living-room-lounge.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div style="position:relative;max-width:1514px;margin:0 auto;padding:80px 37px;display:flex;flex-wrap:wrap;gap:40px;align-items:flex-end;justify-content:space-between;">
        <div>
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/about/" style="color:#7FB3BC;">About</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Our Team
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;max-width:18ch;text-wrap:balance;">Our Team</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0;max-width:58ch;">Credentialed clinicians and leaders across medicine, nursing, and therapy, many with their own lived experience of recovery.</p>
        </div>
        <div class="hero-stat" style="flex:0 0 auto;text-align:right;">
          <div class="hero-stat-num" style="font-family:'Instrument Sans',sans-serif;font-weight:600;font-size:clamp(48px,6vw,76px);line-height:1;letter-spacing:-0.03em;color:#FFFFFF;" data-count-to={totalPeople}>0</div>
          <div class="hero-stat-label" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#7FB3BC;margin-top:6px;">People. One mission.</div>
        </div>
      </div>
    </section>

    {/* ══════════════  WHY OUR TEAM — credentials + lived-experience copy  ══════════════
       Real prose from Elizabeth (697 words, delivered as content_final.txt,
       2026-09-18), grounded only in facts already established elsewhere in
       this project: Beck Gee, Brad Lamm, Deb Hughes, real staff credentials,
       Joint Commission, DHCS, the 2013 founding year, and the 4,000+-served
       / 43-staff figures. Placed above the department tabs, in plain
       paragraphs with no interaction required, for the same crawlability
       reason the tabs themselves were just rebuilt around. */}
    <section data-screen-label="Why Our Team" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:760px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Credentials, and something more</div>
          <h2 style={`${S.h2}max-width:22ch;`}>Why our team is the foundation of recovery</h2>
        </div>
        <div style="font-family:'Montserrat',Helvetica,sans-serif;font-size:17px;line-height:1.8;color:#3A444D;display:grid;gap:22px;">
          <p>A treatment team's credentials matter, but at Breathe, what matters just as much is what those credentials sit alongside: personal recovery experience. Every clinician here has walked their own path through addiction, mental health struggles, or both, and then gone on to earn the clinical training to help others do the same. That combination, lived experience plus real credentials, is not a marketing detail. It is the actual structure of how care happens here, from the first phone call to discharge planning.</p>
          <p>Our leadership reflects this directly. Beck Gee, our Chief Executive Officer, is a trans man in recovery who leads Breathe's clinical and operational direction day to day. Brad Lamm, our founder, began his own recovery in 2003 and built Breathe from that experience, going on to personally select every clinician who joins the team. Deb Hughes, our Co-founder overseeing Strategic Relations, brings the same grounding to how we build partnerships and family programming. None of them are removed from the work they're asking others to do. They've done it themselves.</p>
          <p>That same standard carries through the full clinical team. Our staff hold real, verifiable credentials: Licensed Marriage and Family Therapists (LMFT), Licensed Professional Counselors (LPC), Certified Alcohol and Drug Counselors (CADC), Associate Marriage and Family Therapists (AMFT), and psychiatric leadership including a Chief Medical Officer. These are the same credentials you'd expect from any accredited treatment center. What's different is that a meaningful number of the people holding them have also been on the other side of treatment themselves, as patients, as family members, or both.</p>
          <p>Why does that combination matter clinically, not just emotionally? Addiction and co-occurring mental health conditions respond to more than technique. A clinician who has personally experienced withdrawal, relapse, shame, or the disorientation of early recovery brings something a textbook alone cannot: an intuitive sense of what a person actually needs to hear in a given moment, and what they don't. Clinical training gives our team the tools, evidence-based approaches like Cognitive Behavioral Therapy, Dialectical Behavior Therapy, Acceptance and Commitment Therapy, Motivational Interviewing, Somatic Therapy, and trauma-focused modalities. Lived experience gives them the judgment to apply those tools with real understanding, not just protocol.</p>
          <p>This is especially true for the communities Breathe was built around. Our team includes clinicians who understand minority stress, gender-affirming care, and the specific weight of being LGBTQ+ in addiction and mental health treatment, not because they studied it from the outside, but because many of them have lived it. That's the difference between a program that accommodates LGBTQ+ people and one that was actually built by and for them, which is what Breathe has been since our founding.</p>
          <p>This same standard runs across every level of care we offer, not just one program or one point in someone's stay. From medical detox through residential treatment, day treatment, intensive outpatient, and ongoing sober living, the team supporting a person at each stage brings that same pairing of clinical skill and personal understanding. It also extends to family involvement. Our clinicians understand that recovery rarely happens in isolation, so family therapy, our Family Class, and our multi-day Family Workshop are led by people who understand both the clinical dynamics of family systems and, often, what it actually feels like to sit on either side of that table, as the person in treatment or as the person who loves them.</p>
          <p>Breathe has operated in Los Angeles since 2013, and in that time our team has supported more than 4,000 people through treatment. We're accredited with the Gold Seal of Approval from The Joint Commission, the same independent, third-party review standard held by leading hospitals nationwide, and we're licensed by the California Department of Health Care Services. Those credentials confirm that our clinical standards meet a rigorous external bar. Our team's own recovery experience is what makes sure that standard translates into care that actually feels human once you're inside it.</p>
          <p>Across all 43 members of our team, spanning clinical leadership, therapy, case management, medical support, and operations, this is the throughline: real credentials, matched with real understanding of what recovery actually requires. We built it this way on purpose. It is, in our experience, the combination that works.</p>
        </div>
      </div>
    </section>

    {/* ══════════════  TEAM · full roster, always in the DOM  ══════════════ */}
    {/* Every department renders in full below, always — nothing sits behind
       a click or a carousel drag. "All" (default) shows the whole roster in
       one continuous scroll; the department pills are a same-page filter
       layered on top via JS, and plain anchor links so a department pill
       still jumps to real, already-visible content even without JS. This is
       deliberate for SEO: a crawler (or a visitor) that never executes a
       click still gets every person on the page. */}
    <section id="team-section" data-screen-label="Team" style="position:relative;overflow:hidden;padding:70px 37px;background:#F7F5F1;">
      <div id="team-parallax-bg" aria-hidden="true" style="position:absolute;top:-70px;bottom:-70px;left:0;right:0;background-image:url('/Asset/Facility/facility-18-great-room.jpg');background-size:cover;background-position:center;opacity:0.08;filter:saturate(0.7);will-change:transform;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>The full team</div>
          <h2 style={`${S.h2}max-width:26ch;`}>Every department, every person</h2>
        </div>

        <div id="team-tabs" class="no-scrollbar" role="tablist" aria-label="Filter team by department" style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:36px;">
          <a href="#team-list" class="team-tab-btn is-active" data-tab="all" role="tab" aria-selected="true">All</a>
          {tabGroups.map((group) => (
            <a href={`#dept-${deptSlug(group.dept)}`} class="team-tab-btn" data-tab={deptSlug(group.dept)} role="tab" aria-selected="false">{group.dept}</a>
          ))}
        </div>

        <div id="team-list">
          {tabGroups.map((group) => (
            <div class="team-dept-block" id={`dept-${deptSlug(group.dept)}`} data-dept={deptSlug(group.dept)}>
              <h3 class="team-dept-heading">{group.dept}</h3>
              <ul class="tc-static-row">
                {group.people.map((p) => (
                  <li class="tc-card">
                    <a href={`/about/our-team/${p.slug}/`} class="tc-card-link" style="display:block;background:#FFFFFF;border:1px solid #E2DED7;border-radius:16px;overflow:hidden;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.06);color:inherit;height:100%;">
                      <div style="aspect-ratio:4/5;overflow:hidden;background:#F7F5F1;">
                        <img src={p.photo} alt={p.name} loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:center 20%;display:block;" />
                      </div>
                      <div style="padding:16px 16px 18px;">
                        {p.badge && <span style="display:inline-block;font-family:'Instrument Sans',sans-serif;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;background:#F0F5FA;color:#2C5A64;padding:3px 8px;border-radius:4px;margin-bottom:8px;">{p.badge}</span>}
                        <div style="font-size:15px;font-weight:600;letter-spacing:-0.008em;line-height:1.3;">{p.name}</div>
                        <div style="font-family:'Montserrat',Helvetica,sans-serif;font-size:12.5px;color:#646D76;margin-top:3px;line-height:1.35;">{p.role}</div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <p style="text-align:center;margin:36px 0 0;font-family:'Montserrat',sans-serif;font-size:15px;">
          <a href="/about/" style="color:#33679C;font-weight:600;">← Back to About</a>
        </p>
      </div>
    </section>

    <SiteFinalCTA
      heading="Talk to someone who's been where you are"
      subhead="Every clinician on staff has personal recovery experience, you won't have to explain yourself to someone who's only read about it."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Backgrounds/our-team-cta-friends.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* Hero stat ("43 · People. One mission."): on desktop it sits to the
     right of the intro text in a flex-wrap row, so text-align:right centers
     it against that text. On mobile the row wraps and the block lands on
     its own line — flex:0 0 auto + text-align:right doesn't reposition the
     block itself, so it stranded at the left edge as an oversized, orphaned
     number. Below 1024px it becomes a compact inline stat instead, sized
     down and set beside its label so it reads as a continuation of the
     intro rather than a disconnected block. */
  @media (max-width: 1024px) {
    .hero-stat {
      text-align: left !important;
      display: flex !important; align-items: baseline; gap: 10px;
    }
    .hero-stat-num { font-size: 32px !important; }
    .hero-stat-label { margin-top: 0 !important; }
  }

  /* Department tabs: 7 pills wrapped into a ragged, uneven multi-line stack
     on narrow screens (the longest label ran nearly edge-to-edge). Below
     1024px this becomes a single-line, swipeable strip instead — bleeds
     into the section's own side gutter so it can scroll edge-to-edge, then
     pads itself back out so no pill sits flush against the viewport edge. */
  @media (max-width: 1024px) {
    #team-tabs {
      flex-wrap: nowrap !important;
      justify-content: flex-start !important;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      margin-left: -20px; margin-right: -20px;
      padding: 2px 20px 10px !important;
    }
    #team-tabs .team-tab-btn { flex: 0 0 auto; scroll-snap-align: start; white-space: nowrap; }
  }

  .team-tab-btn {
    font-family: 'Instrument Sans', sans-serif; font-size: 13px; font-weight: 500;
    padding: 9px 16px; border-radius: 999px; border: 1px solid #C9D2DA;
    background: #FFFFFF; color: #3A444D; cursor: pointer;
    /* Metallic rim: a bright inset edge at bottom-left and a faint dark one at
       top-right, as if lit from below-left — reads as a glossy bevel on the
       1px border without ever changing its width. */
    box-shadow: inset -1px 1px 0.5px rgba(255,255,255,0.9), inset 1px -1px 0.5px rgba(20,24,28,0.05);
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }
  .team-tab-btn:hover {
    border-color: #33679C; color: #33679C; transform: translateY(-1px);
    box-shadow: inset -1px 1px 0.5px rgba(255,255,255,0.9), inset 1px -1px 0.5px rgba(20,24,28,0.05),
      0 2px 5px rgba(20,24,28,0.08), 0 8px 18px rgba(20,24,28,0.10);
  }
  .team-tab-btn.is-active {
    /* border-color intentionally NOT the same as the fill — matching it made
       the ring disappear entirely on the active pill; a light, visible edge
       reads better than none at all. */
    background: #33679C; border-color: rgba(255,255,255,0.55); color: #FFFFFF;
    box-shadow: inset -1px 1px 0.5px rgba(255,255,255,0.35), inset 1px -1px 0.5px rgba(0,0,0,0.18);
  }
  .team-tab-btn.is-active:hover {
    box-shadow: inset -1px 1px 0.5px rgba(255,255,255,0.35), inset 1px -1px 0.5px rgba(0,0,0,0.18),
      0 2px 5px rgba(20,24,28,0.10), 0 8px 18px rgba(20,24,28,0.14);
  }
  /* ── Full roster: every department block stacks in one continuous page.
       Anchor jumps land below the sticky header, not flush under it. ── */
  #team-list { scroll-margin-top: 96px; }
  .team-dept-block { scroll-margin-top: 96px; margin-bottom: 44px; }
  .team-dept-block:last-child { margin-bottom: 0; }
  .team-dept-block[hidden] { display: none; }
  .team-dept-heading {
    font-family: 'Instrument Sans', sans-serif; font-size: 20px; font-weight: 600;
    letter-spacing: -0.014em; color: #14181C; margin: 0 0 18px; text-align: center;
  }
  .tc-static-row { list-style: none; margin: 0; padding: 4px 2px; display: flex; flex-wrap: wrap; gap: 18px; justify-content: center; }
  .tc-card { flex: 0 0 var(--tc-card-w, 190px); }

  /* Hover: the whole card lifts and grows slightly. */
  .tc-card-link { transition: transform 320ms cubic-bezier(0.4,0,0.2,1), box-shadow 320ms cubic-bezier(0.4,0,0.2,1); }
  .tc-card-link:hover { transform: scale(1.045); box-shadow: 0 4px 10px rgba(20,24,28,0.08), 0 14px 28px rgba(20,24,28,0.12); }

  @media (max-width: 640px) {
    .tc-card { flex-basis: 148px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tc-card-link, .tc-card-link:hover { transition: none; transform: none; }
    .team-tab-btn, .team-tab-btn:hover { transition: none; transform: none; }
  }

</style>

<script>
  // ── Animated headcount — real, derivable number (data-count-to), counts
  //    up once on scroll-into-view; static under prefers-reduced-motion. ──
  (() => {
    const el = document.querySelector<HTMLElement>('[data-count-to]');
    if (!el) return;
    const target = parseInt(el.dataset.countTo || '0', 10);
    const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !target) { el.textContent = String(target); return; }
    let done = false;
    const run = () => {
      if (done) return;
      done = true;
      const start = performance.now();
      const duration = 900;
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(eased * target));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { run(); io.disconnect(); }
      }, { threshold: 0.4 });
      io.observe(el);
    } else {
      run();
    }
  })();

  // ── Team section background parallax — the photo drifts at a fraction of
  //    scroll speed (rect.top * 0.15, clamped) rather than tracking 1:1, the
  //    classic parallax "lag" that reads as depth/activity behind the tabs.
  //    Static under prefers-reduced-motion. ──
  (() => {
    const bg = document.getElementById('team-parallax-bg');
    const section = document.getElementById('team-section');
    const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (!bg || !section || reduce) return;
    let ticking = false;
    const update = () => {
      const offset = Math.max(-60, Math.min(60, section.getBoundingClientRect().top * 0.15));
      bg.style.transform = `translateY(${offset}px)`;
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  })();

  // ── Department pills — filter which blocks are visible. Plain anchor
  //    links underneath (real href="#dept-...") so this is enhancement
  //    only: with JS disabled, or before it runs, every department block
  //    is already on the page and a pill just scrolls to it. ──
  (() => {
    const btns = Array.from(document.querySelectorAll<HTMLAnchorElement>('.team-tab-btn'));
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('.team-dept-block'));
    if (!btns.length || !blocks.length) return;
    btns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const tab = btn.dataset.tab;
        if (tab && tab !== 'all') e.preventDefault();
        btns.forEach((b) => { b.classList.toggle('is-active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        blocks.forEach((blk) => { blk.hidden = !!tab && tab !== 'all' && blk.dataset.dept !== tab; });
        if (tab && tab !== 'all') document.getElementById(`dept-${tab}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>
