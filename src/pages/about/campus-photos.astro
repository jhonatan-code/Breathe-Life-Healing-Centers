---
/**
 * /about/campus-photos/ — image-forward gallery of the Laurel Canyon
 * residential campus, mirroring the official live page's own structure
 * (breathelifehealingcenters.com/locations/campus-photos/): hero, then a
 * "West Hollywood (LA)" intro section (verbatim official copy), then "The
 * Campus" grid (exteriors and grounds from the 2026 photoshoot), then the
 * interiors below under their own heading.
 *
 * Grid + click-to-enlarge lightbox, vanilla JS, no dependency. Both photo
 * sets share one lightbox (`allPhotos`), so indices for the second grid
 * are offset by campusPhotos.length.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { galleryImg } from "../../data/home";

const title = "Campus Photos | Breathe Life Healing Centers";
const description = "See the Breathe Life Healing Centers residential campus in Laurel Canyon, real photos of the grounds, common spaces, and suites.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
};

// 2026 campus photoshoot (Kaela Saez, client-supplied 2026-10-26; three
// near-duplicate frames left out). Exteriors and grounds fill "The Campus",
// interiors fill "Grounds & Suites".
const exteriorPhotos = [
  ["campus-01-pool-waterfall.jpg", "Pool & Waterfall"],
  ["campus-02-patio-adirondack-chairs.jpg", "Garden Patio"],
  ["campus-03-adirondack-chairs.jpg", "Garden Seating"],
  ["campus-04-garden-patio-lounge.jpg", "Garden Patio Lounge"],
  ["campus-05-patio-sectional.jpg", "Outdoor Lounge"],
  ["campus-06-hillside-patio.jpg", "Hillside Patio"],
  ["campus-07-residence-balconies.jpg", "Residence"],
  ["campus-08-main-building.jpg", "Main Building"],
  ["campus-09-main-building-entry.jpg", "Main Building Entry"],
  ["campus-10-interior-detail.jpg", "Interior Detail"],
  ["campus-11-garden-path.jpg", "Garden Path"],
  ["campus-12-main-building-hillside.jpg", "Main Building"],
  ["campus-13-hillside-residence.jpg", "Hillside Residence"],
  ["campus-15-porch-walkway.jpg", "Covered Walkway"],
  ["campus-16-canyon-view.jpg", "Laurel Canyon View"],
  ["campus-17-shaded-garden-patio.jpg", "Shaded Garden Patio"],
  ["campus-18-covered-porch.jpg", "Covered Porch"],
  ["campus-19-residence-entrance.jpg", "Residence Entrance"],
  ["campus-20-residence-garden.jpg", "Residence Garden"],
  ["campus-21-residence-side.jpg", "Residence"],
] as const;

const photos = [
  ["campus-22-client-lounge-sofa.jpg", "Client Lounge"],
  ["campus-23-client-lounge.jpg", "Client Lounge Seating"],
  ["campus-24-dining-area.jpg", "Dining Area"],
  ["campus-25-living-room.jpg", "Living Room"],
  ["campus-27-dining-room-arch.jpg", "Dining Room"],
  ["campus-28-living-room-built-ins.jpg", "Living Room Built-Ins"],
  ["campus-29-sunlit-dining-room.jpg", "Sunlit Dining Room"],
  ["campus-30-window-seat.jpg", "Window Seat"],
  ["campus-31-window-seat-view.jpg", "Window Seat View"],
  ["campus-32-dining-staircase.jpg", "Dining Room & Staircase"],
  ["campus-33-dining-fireplace.jpg", "Dining Room & Fireplace"],
  ["campus-34-sitting-area.jpg", "Sitting Area"],
  ["campus-35-bedroom.jpg", "Bedroom"],
  ["campus-36-bedroom-blue.jpg", "Bedroom"],
  ["campus-37-welcome-kit.jpg", "Welcome Kit"],
  ["campus-39-hallway.jpg", "Hallway"],
  ["campus-40-lounge.jpg", "Lounge"],
  ["campus-41-lounge-sectional.jpg", "Lounge Seating"],
] as const;

const campusPhotos = exteriorPhotos.map(([file, cap]) => ({ src: galleryImg(file), cap }));

const facilityPhotos = photos.map(([file, cap]) => ({ src: galleryImg(file), cap }));
const allPhotos = [...campusPhotos, ...facilityPhotos];

const pageUrl = new URL("/about/campus-photos/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Campus Photos", item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={title} description={description} path="/about/campus-photos/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="About" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#32679C;">
      <img src="/Asset/Facility/campus-01-pool-waterfall.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div style="position:relative;max-width:1514px;margin:0 auto;padding:80px 37px;">
        <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
          <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/about/" style="color:#7FB3BC;">About</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Campus Photos
        </nav>
        <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;max-width:20ch;text-wrap:balance;">Campus Photos: A Look at Our Campus</h1>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0;max-width:58ch;">A secluded residential campus in Laurel Canyon, private enough to heal, comfortable enough to call home for a while.</p>
      </div>
    </section>

    {/* ══════════════  WEST HOLLYWOOD (LA)  ══════════════
       Verbatim from the official live page's own section in this same
       spot, below the hero and above the gallery
       (breathelifehealingcenters.com/locations/campus-photos/, checked
       2026-09-18). */}
    <section data-screen-label="West Hollywood (LA)" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1100px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Our Location</div>
        <h2 style={`${S.h2}max-width:20ch;`}>West Hollywood (LA)</h2>
        <p style={`${S.intro}margin-bottom:16px;`}>Breathe West Hollywood is set in a quiet, secluded part of Laurel Canyon. Breathe's many acres of property include three residential homes, lots of outdoor space with beautiful views and natural wildlife. There are an abundance of outdoor features including a spacious community dining room, amphitheater, pool and biodynamic gardens.</p>
        <p style={S.intro}>At Breathe West Hollywood (LA), we also make regular use of the amazing city around us.</p>
      </div>
    </section>

    {/* ══════════════  THE CAMPUS  ══════════════ */}
    <section data-screen-label="The Campus" style="padding:0 37px 70px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <h2 style={`${S.h2}max-width:16ch;`}>The Campus</h2>
        </div>
        <div class="gallery-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
          {campusPhotos.map((p, i) => (
            <button type="button" class="gal-item" data-gal-open={i} style="position:relative;display:block;border:0;padding:0;cursor:zoom-in;aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:#EDF2F7;">
              <img src={p.src} alt={p.cap} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;" />
            </button>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  OUTDOORS  ══════════════ */}
    <section data-screen-label="Outdoors" style="padding:0 37px 70px;background:#FFFFFF;">
      <div style="max-width:1100px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>On the Grounds</div>
        <h2 style={`${S.h2}max-width:16ch;`}>Outdoors</h2>
        <p style={S.intro}>Nestled on a multi-acre hidden valley in Laurel Canyon, Breathe's Campus experience allows a huge spot to roam, swim, garden, care for the chickens and more. Special spots include the biodynamic garden, Peace Park for meditation, the hill for walking, and working out alongside the gym. The outside parts of Breathe are special spots for recovering and more good in life.</p>
      </div>
    </section>

    {/* ══════════════  GALLERY  ══════════════ */}
    <section data-screen-label="Gallery" style="padding:0 37px 70px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <h2 style={`${S.h2}max-width:20ch;`}>Grounds &amp; Suites</h2>
        </div>
        <div class="gallery-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
          {photos.map(([file, cap], i) => (
            <button type="button" class="gal-item" data-gal-open={i + campusPhotos.length} style="position:relative;display:block;border:0;padding:0;cursor:zoom-in;aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:#EDF2F7;">
              <img src={galleryImg(file)} alt={cap} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;" />
              <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(22,41,61,0) 55%,rgba(22,41,61,0.72) 100%);"></div>
              <span style="position:absolute;left:14px;bottom:12px;font-family:'Instrument Sans',sans-serif;font-size:13px;font-weight:500;color:#FFFFFF;text-align:left;">{cap}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  LIGHTBOX  ══════════════ */}
    <div id="gal-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden style="position:fixed;inset:0;z-index:100;background:rgba(10,17,25,0.94);display:flex;align-items:center;justify-content:center;padding:24px;">
      <button type="button" id="gal-close" aria-label="Close" class="msym" style="position:absolute;top:20px;right:20px;width:48px;height:48px;border:0;border-radius:999px;background:rgba(255,255,255,0.12);color:#FFFFFF;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;">close</button>
      <button type="button" id="gal-prev" aria-label="Previous photo" class="msym" style="position:absolute;left:16px;top:50%;transform:translateY(-50%);width:52px;height:52px;border:0;border-radius:999px;background:rgba(255,255,255,0.12);color:#FFFFFF;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;">chevron_left</button>
      <button type="button" id="gal-next" aria-label="Next photo" class="msym" style="position:absolute;right:16px;top:50%;transform:translateY(-50%);width:52px;height:52px;border:0;border-radius:999px;background:rgba(255,255,255,0.12);color:#FFFFFF;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;">chevron_right</button>
      <figure style="margin:0;max-width:90vw;max-height:82vh;">
        <img id="gal-img" src="" alt="" style="max-width:90vw;max-height:76vh;display:block;border-radius:8px;margin:0 auto;" />
        <figcaption id="gal-cap" style="text-align:center;color:#DCE6EF;font-family:'Instrument Sans',sans-serif;font-size:14px;margin-top:14px;"></figcaption>
      </figure>
    </div>

    <SiteFinalCTA
      heading="Ready to see it in person?"
      subhead="The best way to know if Breathe is right for you is a real conversation. Call anytime, no pressure, no obligation."
      secondary={{ label: "Take the Video Tour", href: "/about/video-tour/" }}
      background="/Asset/Facility/campus-36-bedroom-blue.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script define:vars={{ photos: allPhotos }}>
  (() => {
    const box = document.getElementById("gal-lightbox");
    const img = document.getElementById("gal-img");
    const cap = document.getElementById("gal-cap");
    const items = Array.from(document.querySelectorAll("[data-gal-open]"));
    if (!box || !img || !cap || !items.length) return;
    let idx = 0;
    let lastFocused = null;
    const show = (i) => {
      idx = ((i % photos.length) + photos.length) % photos.length;
      img.src = photos[idx].src;
      img.alt = photos[idx].cap;
      cap.textContent = photos[idx].cap;
    };
    const open = (i) => {
      lastFocused = document.activeElement;
      show(i);
      box.hidden = false;
      document.body.style.overflow = "hidden";
      document.getElementById("gal-close")?.focus();
    };
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = "";
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };
    items.forEach((el, i) => el.addEventListener("click", () => open(i)));
    document.getElementById("gal-close")?.addEventListener("click", close);
    document.getElementById("gal-prev")?.addEventListener("click", () => show(idx - 1));
    document.getElementById("gal-next")?.addEventListener("click", () => show(idx + 1));
    box.addEventListener("click", (e) => { if (e.target === box) close(); });
    document.addEventListener("keydown", (e) => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(idx - 1);
      else if (e.key === "ArrowRight") show(idx + 1);
    });
  })();

  // ── Section reveal on scroll ──────────────────────────────────────────
  (() => {
    const targets = Array.from(document.querySelectorAll("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
