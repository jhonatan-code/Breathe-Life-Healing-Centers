---
/**
 * /about/campus-photos/ — image-forward gallery of the Laurel Canyon
 * residential campus, using the real facility photos in public/Asset/Facility/
 * (23 images, real content — not clinical copy, so no placeholder needed).
 * Captions are plain descriptive labels derived from the asset filenames.
 *
 * Grid + click-to-enlarge lightbox, vanilla JS, no dependency.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { galleryImg } from "../../data/home";

const title = "Campus Photos | Breathe Life Healing Centers";
const description = "See the Breathe Life Healing Centers residential campus in Laurel Canyon — real photos of the grounds, common spaces, and suites.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
};

const photos = [
  ["facility-20-estate-entrance-gate.jpg", "Estate Entrance Gate"],
  ["facility-16-facility-entrance-drive.jpg", "Entrance Drive"],
  ["facility-12-residence-exterior.jpg", "Residence Exterior"],
  ["facility-06-guest-house-exterior.jpg", "Guest House"],
  ["facility-22-garden-entrance-path.jpg", "Garden Entrance Path"],
  ["facility-18-great-room.jpg", "Great Room"],
  ["facility-17-living-room-lounge.jpg", "Living Room Lounge"],
  ["facility-04-community-dining-lounge.jpg", "Community Dining Lounge"],
  ["facility-19-outdoor-dining-deck.jpg", "Outdoor Dining Deck"],
  ["facility-14-community-kitchen.jpg", "Community Kitchen"],
  ["facility-23-kitchen-common-area.jpg", "Kitchen & Common Area"],
  ["facility-21-quiet-reading-nook.jpg", "Quiet Reading Nook"],
  ["facility-01-private-suite-entry.jpg", "Private Suite Entry"],
  ["facility-02-shared-bedroom-blue.jpg", "Shared Bedroom"],
  ["facility-09-twin-bedroom-suite.jpg", "Twin Bedroom Suite"],
  ["facility-13-ensuite-bath-balcony.jpg", "Ensuite Bath & Balcony"],
  ["facility-05-spa-bathroom-suite.jpg", "Spa Bathroom Suite"],
  ["facility-07-pool-waterfall-grotto.jpg", "Pool & Waterfall Grotto"],
  ["facility-08-poolside-grotto-overlook.jpg", "Poolside Grotto Overlook"],
  ["facility-15-pool-deck-canyon-view.jpg", "Pool Deck, Canyon View"],
  ["facility-10-fitness-center.jpg", "Fitness Center"],
  ["facility-11-clinical-building-exterior.jpg", "Clinical Building"],
  ["facility-03-clinical-office.jpg", "Clinical Office"],
] as const;

const pageUrl = new URL("/about/campus-photos/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Campus Photos", item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={title} description={description} path="/about/campus-photos/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="About" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-07-pool-waterfall-grotto.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div style="position:relative;max-width:1514px;margin:0 auto;padding:80px 37px;">
        <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
          <a href="/about/" style="color:#7FB3BC;">About</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Campus Photos
        </nav>
        <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;max-width:20ch;text-wrap:balance;">A look at our campus</h1>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0;max-width:58ch;">A secluded residential campus in Laurel Canyon — private enough to heal, comfortable enough to call home for a while.</p>
      </div>
    </section>

    {/* ══════════════  GALLERY  ══════════════ */}
    <section data-screen-label="Gallery" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div class="gallery-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
          {photos.map(([file, cap], i) => (
            <button type="button" class="gal-item" data-gal-open={i} style="position:relative;display:block;border:0;padding:0;cursor:zoom-in;aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:#EDF2F7;">
              <img src={galleryImg(file)} alt={cap} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;" />
              <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(22,41,61,0) 55%,rgba(22,41,61,0.72) 100%);"></div>
              <span style="position:absolute;left:14px;bottom:12px;font-family:'Instrument Sans',sans-serif;font-size:13px;font-weight:500;color:#FFFFFF;text-align:left;">{cap}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  LIGHTBOX  ══════════════ */}
    <div id="gal-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden style="position:fixed;inset:0;z-index:100;background:rgba(10,17,25,0.94);display:flex;align-items:center;justify-content:center;padding:24px;">
      <button type="button" id="gal-close" aria-label="Close" class="msym" style="position:absolute;top:20px;right:20px;width:48px;height:48px;border:0;border-radius:999px;background:rgba(255,255,255,0.12);color:#FFFFFF;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;">close</button>
      <button type="button" id="gal-prev" aria-label="Previous photo" class="msym" style="position:absolute;left:16px;top:50%;transform:translateY(-50%);width:52px;height:52px;border:0;border-radius:999px;background:rgba(255,255,255,0.12);color:#FFFFFF;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;">chevron_left</button>
      <button type="button" id="gal-next" aria-label="Next photo" class="msym" style="position:absolute;right:16px;top:50%;transform:translateY(-50%);width:52px;height:52px;border:0;border-radius:999px;background:rgba(255,255,255,0.12);color:#FFFFFF;font-size:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;">chevron_right</button>
      <figure style="margin:0;max-width:90vw;max-height:82vh;">
        <img id="gal-img" src="" alt="" style="max-width:90vw;max-height:76vh;display:block;border-radius:8px;margin:0 auto;" />
        <figcaption id="gal-cap" style="text-align:center;color:#DCE6EF;font-family:'Instrument Sans',sans-serif;font-size:14px;margin-top:14px;"></figcaption>
      </figure>
    </div>

    <SiteFinalCTA
      heading="Ready to see it in person?"
      subhead="The best way to know if Breathe is right for you is a real conversation. Call anytime — no pressure, no obligation."
      secondary={{ label: "Take the Video Tour", href: "/about/video-tour/" }}
      background="/Asset/Facility/facility-01-private-suite-entry.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script define:vars={{ photos: photos.map(([file, cap]) => ({ src: galleryImg(file), cap })) }}>
  (() => {
    const box = document.getElementById("gal-lightbox");
    const img = document.getElementById("gal-img");
    const cap = document.getElementById("gal-cap");
    const items = Array.from(document.querySelectorAll("[data-gal-open]"));
    if (!box || !img || !cap || !items.length) return;
    let idx = 0;
    let lastFocused = null;
    const show = (i) => {
      idx = ((i % photos.length) + photos.length) % photos.length;
      img.src = photos[idx].src;
      img.alt = photos[idx].cap;
      cap.textContent = photos[idx].cap;
    };
    const open = (i) => {
      lastFocused = document.activeElement;
      show(i);
      box.hidden = false;
      document.body.style.overflow = "hidden";
      document.getElementById("gal-close")?.focus();
    };
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = "";
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };
    items.forEach((el, i) => el.addEventListener("click", () => open(i)));
    document.getElementById("gal-close")?.addEventListener("click", close);
    document.getElementById("gal-prev")?.addEventListener("click", () => show(idx - 1));
    document.getElementById("gal-next")?.addEventListener("click", () => show(idx + 1));
    box.addEventListener("click", (e) => { if (e.target === box) close(); });
    document.addEventListener("keydown", (e) => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(idx - 1);
      else if (e.key === "ArrowRight") show(idx + 1);
    });
  })();

  // ── Section reveal on scroll ──────────────────────────────────────────
  (() => {
    const targets = Array.from(document.querySelectorAll("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
