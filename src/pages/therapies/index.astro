---
/**
 * /therapies/ — Therapies section hub (sitewide nav's "Therapies" top-level
 * item, primaryNav in ../../config/site). Card grid to all 12 modality pages,
 * grouped the same way as the header mega-menu: "Core therapies" then
 * "Holistic & experiential". Hub pattern follows /programs/index.astro.
 *
 * No approved clinical brief exists for any modality's own detail page yet,
 * so card blurbs here are deliberately structural/marketing only ("part of
 * your plan"), never a description of how a therapy works — see CLAUDE.md
 * and ../../components/ClinicalPlaceholder.astro on each detail page.
 *
 * FAQ sourced from Breathe_Life_Therapies_Overview_FAQ.docx (2026-09-14),
 * which defers to the BLHC Content Client Profile as authoritative and is
 * not going through further client/team review. No live source page exists
 * for this exact hub structure (the old site scattered modalities under a
 * smaller "Mental health treatment" submenu); this content is built from
 * the confirmed 12-item Therapies list already established in this
 * project's nav/sitemap work, not migrated from an old page. The brief
 * checked the 12-card list against that confirmed structure: all 12
 * present, none excluded, no EMDR/IFS/other flagged modality appears.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site, primaryNav } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Therapies We Use | Breathe Life Healing Centers";
const description =
  "The therapies available at Breathe Life Healing Centers, CBT, DBT, ACT, somatic therapy, motivational interviewing, trauma-focused therapy, gender-affirming care, and more. LGBTQ+-affirming care in Los Angeles. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

// Icon + one-line, non-clinical teaser per modality. No description of how a
// therapy works — those live behind <ClinicalPlaceholder /> on each detail
// page until an approved brief exists.
const coreTherapies = [
  { icon: "psychology", title: "Cognitive Behavioral Therapy (CBT)", href: "/therapies/cbt/", text: "Woven into individual and group sessions as part of your plan." },
  { icon: "balance", title: "Dialectical Behavior Therapy (DBT)", href: "/therapies/dbt/", text: "Skills-based support built into your individualized plan." },
  { icon: "target", title: "Acceptance & Commitment Therapy (ACT)", href: "/therapies/act/", text: "One of the therapies woven into your individualized plan." },
  { icon: "spa", title: "Somatic Therapy", href: "/therapies/somatic-therapy/", text: "Body-based work integrated into your plan." },
  { icon: "forum", title: "Motivational Interviewing", href: "/therapies/motivational-interviewing/", text: "A collaborative approach used throughout your care." },
  { icon: "healing", title: "Trauma-Focused Therapy", href: "/therapies/trauma-focused-therapy/", text: "Trauma-informed care integrated into your plan." },
];

const holisticTherapies = [
  { icon: "diversity_3", title: "Gender-Affirming Care", href: "/therapies/gender-affirming-care/", text: "Care that affirms who you are, at every level of treatment." },
  { icon: "self_improvement", title: "Yoga & Mindfulness", href: "/therapies/yoga-mindfulness/", text: "Movement and practice woven into daily programming." },
  { icon: "palette", title: "Art Therapy", href: "/therapies/art-therapy/", text: "Creative expression as part of your individualized plan." },
  { icon: "music_note", title: "Music Therapy", href: "/therapies/music-therapy/", text: "Music-based programming integrated into your care." },
  { icon: "eco", title: "Holistic Therapy", href: "/therapies/holistic-therapy/", text: "Whole-person care woven into your treatment plan." },
  { icon: "hiking", title: "Experiential Therapies", href: "/therapies/experiential-therapies/", text: "Hands-on, activity-based programming." },
];

// Verbatim from Breathe_Life_Therapies_Overview_FAQ.docx (2026-09-14).
const faqs = [
  { q: "How is my specific mix of therapies decided?", a: "Your clinical team builds your plan around your specific needs and history during assessment, not from a fixed template applied to everyone." },
  { q: "Do I get to choose which therapies I participate in?", a: "Your input matters, and your team talks through what's working and what isn't as your plan develops. It's collaborative, not something decided for you without discussion." },
  { q: "What's the difference between the core therapies and the holistic ones?", a: "Core therapies like CBT and DBT are clinical, evidence-based approaches woven into individual and group sessions. Holistic and experiential therapies, like art, music, and yoga, work alongside them as whole-person care, not a replacement for clinical treatment." },
  { q: "Is gender-affirming care a separate specialty program, or part of everyday treatment?", a: "It's woven into every level of treatment here, not a separate track you have to opt into." },
  { q: "Will these therapies address substance use and mental health together, or separately?", a: "Together. Whatever mix of therapies fits your plan addresses both, since they rarely show up in isolation from each other." },
  { q: "Does insurance cover these therapies?", a: "In most cases, yes. Our admissions team verifies your specific benefits and explains what's covered before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

const why = [
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress. Open to anyone whose values align, without losing that center.",
  },
  {
    icon: "family_restroom", title: "Family involved, on your terms",
    text: "Family therapy that doesn't assume blood relationships. Partners and chosen family are welcome participants.",
  },
];

const therapiesNav = primaryNav.find((n) => n.label === "Therapies")!;
const allLinks = therapiesNav.groups!.flatMap((g) => g.links);
const pageUrl = new URL("/therapies/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Therapies", item: pageUrl },
      ],
    },
    {
      "@type": "ItemList",
      name: "Therapies We Use",
      itemListElement: allLinks.map((l, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: l.label,
        url: new URL(l.href, site.domain).href,
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/therapies/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Therapies" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-20-estate-entrance-gate.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.85;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.84) 48%,rgba(22,41,61,0.55) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">How we treat</div>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Therapies We Use</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">No single therapy fits everyone. Your plan at Breathe draws on a mix of these, built around you, built for the LGBTQ+ community first, open to anyone whose values align.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta" href="/admissions/insurance/" style={S.ctaWhite}>Verify Your Insurance</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  CORE THERAPIES  ══════════════ */}
    {/* ══════════════  CORE THERAPIES — Woven Foundation  ══════════════
       Six real threads (same coreTherapies data as before) converge into
       one "Your Plan" anchor, literalizing the phrase already used four
       times in these six real descriptions ("woven into your plan").
       Redraws every time the section scrolls into view, same replay
       pattern as the vitals pulse line on medical-detox/MAT. */}
    <section data-screen-label="Core therapies" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Core therapies</div>
          <h2 style={`${S.h2}max-width:30ch;`}>The clinical foundation of your plan</h2>
          <p style={`${S.intro}max-width:80ch;`}>These are drawn on across most levels of care, adjusted to what you need at each stage.</p>
        </div>
        <div class="weave" id="weave-core">
          <div class="weave-threads">
            {coreTherapies.map((c, i) => {
              const colors = ["#33679C", "#478694", "#7FB3BC"];
              const color = colors[i % 3];
              return (
                <a class="weave-card" href={c.href} style={`--thread-color:${color};`}>
                  <span class="ic msym">{c.icon}</span>
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                </a>
              );
            })}
            <svg class="weave-svg" viewBox="0 0 620 64" preserveAspectRatio="none" aria-hidden="true">
              <path class="weave-path" d="M20,0 C 20,30 310,20 310,50" stroke="#33679C" />
              <path class="weave-path" d="M124,0 C 124,26 310,24 310,50" stroke="#478694" />
              <path class="weave-path" d="M228,0 C 228,22 310,28 310,50" stroke="#7FB3BC" />
              <path class="weave-path" d="M392,0 C 392,22 310,28 310,50" stroke="#33679C" />
              <path class="weave-path" d="M496,0 C 496,26 310,24 310,50" stroke="#478694" />
              <path class="weave-path" d="M600,0 C 600,30 310,20 310,50" stroke="#7FB3BC" />
            </svg>
          </div>
          <div class="weave-plan"><span class="msym">route</span><b>Your Plan</b></div>
        </div>
      </div>
    </section>

    {/* ══════════════  HOLISTIC & EXPERIENTIAL  ══════════════ */}
    {/* ══════════════  HOLISTIC & EXPERIENTIAL — Wellness Wave  ══════════════
       Same six real modalities (holisticTherapies, unchanged) riding a
       gentle wave instead of a grid — deliberately not "Woven Foundation"
       again (that's for Core therapies, which funnels into one plan);
       holistic/experiential care is additive, so this one flows. Redraws
       every time it scrolls into view, same replay pattern as the weave
       and the vitals pulse line. */}
    <section data-screen-label="Holistic and experiential" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Holistic &amp; experiential</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Care that goes beyond the therapy room</h2>
          <p style={`${S.intro}max-width:80ch;`}>Whole-person programming that rounds out your clinical care.</p>
        </div>
        <div class="wave-zone" id="wave-holistic">
          <svg class="wave-svg" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
            <path class="wave-path" d="M0,60 C 100,10 200,10 300,60 C 400,110 500,110 600,60 C 700,10 800,10 900,60 C 1000,110 1100,110 1200,60" stroke="url(#waveGradHolistic)" />
            <defs>
              <linearGradient id="waveGradHolistic" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#33679C" /><stop offset="0.5" stop-color="#478694" /><stop offset="1" stop-color="#7FB3BC" />
              </linearGradient>
            </defs>
          </svg>
          <div class="wave-nodes">
            {holisticTherapies.map((c, i) => {
              const colors = ["#33679C", "#3F76A0", "#478694", "#5C9CA3", "#6DAAAF", "#7FB3BC"];
              const dir = i % 2 === 0 ? "up" : "down";
              return (
                <div class={`wave-item ${dir}`}>
                  {dir === "up" ? (
                    <>
                      <a class="wave-card" href={c.href}><span class="wave-dot" style={`background:${colors[i]};`}><span class="msym">{c.icon}</span></span><h3>{c.title}</h3><p>{c.text}</p></a>
                      <div class="wave-stem" />
                    </>
                  ) : (
                    <>
                      <div class="wave-stem" />
                      <a class="wave-card" href={c.href}><span class="wave-dot" style={`background:${colors[i]};`}><span class="msym">{c.icon}</span></span><h3>{c.title}</h3><p>{c.text}</p></a>
                    </>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  WHY BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:30ch;`}>The same standard, across every therapy</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{w.icon}</span>
              </span>
              <h3 style="font-size:18px;font-weight:600;letter-spacing:-0.012em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered, before you commit to anything."
      background="#F7F5F1"
    />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about therapy at Breathe"
      intro="Straight answers about how your plan is built, core vs. holistic therapies, and coverage."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* The #verify form lives in the hero on desktop; VerifyInsuranceForm's
       script relocates the form node into #verify-mobile-slot at ≤1024px,
       lands right before the Final CTA, after the FAQ above. */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Not sure which therapy is right for you?"
      subhead="Our admissions team talks through your situation first, then works with your clinical team to build a plan that fits. No pressure, no obligation."
      secondary={{ label: "Verify My Insurance", href: "#verify" }}
      background="/Asset/Facility/facility-01-private-suite-entry.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* ── Woven Foundation — "Core therapies" ───────────────────────────── */
  .weave { position: relative; }
  .weave-threads { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; position: relative; padding-bottom: 64px; }
  .weave-svg { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 64px; overflow: visible; pointer-events: none; }
  .weave-path { fill: none; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 400; stroke-dashoffset: 400; }
  .weave-path.draw { animation: weave-draw 1.8s ease-out forwards; }
  @keyframes weave-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .weave-path { stroke-dashoffset: 0; animation: none; } }
  .weave-card {
    background: #FFFFFF; border: 1px solid #E2DED7; border-top: 3px solid var(--thread-color, #33679C); border-radius: 12px;
    padding: 18px 16px; text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 10px; position: relative; z-index: 1;
  }
  .weave-card .ic { width: 38px; height: 38px; border-radius: 9px; background: #F0F5FA; display: flex; align-items: center; justify-content: center; color: var(--thread-color, #33679C); font-size: 20px; }
  .weave-card h3 { font-size: 16px; font-weight: 600; margin: 0; line-height: 1.3; }
  .weave-card p { font-family: "Montserrat", Helvetica, sans-serif; font-size: 14px; color: #646D76; margin: 0; line-height: 1.5; flex: 1; }
  .weave-plan {
    max-width: 280px; margin: 0 auto; background: #16293D; color: #fff; border-radius: 14px; padding: 20px 26px;
    text-align: center; display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .weave-plan .msym { color: #7FB3BC; font-size: 20px; }
  .weave-plan b { font-family: "Instrument Sans", sans-serif; font-size: 15px; font-weight: 600; }

  @media (max-width: 900px) { .weave-threads { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .weave-threads { grid-template-columns: 1fr 1fr; } .weave-svg { display: none; } }

  /* ── Wellness Wave — "Holistic & experiential" ────────────────────── */
  .wave-zone { position: relative; padding: 20px 0 0; }
  .wave-svg { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); width: 100%; height: 120px; overflow: visible; pointer-events: none; }
  .wave-path { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1400; stroke-dashoffset: 1400; }
  .wave-path.draw { animation: wave-draw 2.2s ease-out forwards; }
  @keyframes wave-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .wave-path { stroke-dashoffset: 0; animation: none; } }
  .wave-nodes { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); column-gap: 14px; height: 270px; }
  .wave-item { position: relative; display: flex; flex-direction: column; align-items: center; }
  .wave-item.up { justify-content: flex-start; }
  .wave-item.down { justify-content: flex-end; }
  .wave-card {
    background: #FFFFFF; border: 1px solid #E2DED7; border-radius: 14px; padding: 16px 14px; text-align: center;
    text-decoration: none; color: inherit; width: 100%; max-width: 190px; box-shadow: 0 8px 20px rgba(20,24,28,.05);
  }
  .wave-dot { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; color: #fff; }
  .wave-dot .msym { font-size: 20px; }
  .wave-card h3 { font-size: 15px; font-weight: 600; margin: 0 0 5px; line-height: 1.3; }
  .wave-card p { font-family: "Montserrat", Helvetica, sans-serif; font-size: 14px; color: #646D76; margin: 0; line-height: 1.45; }
  .wave-stem { width: 2px; flex: 1; background: #E2DED7; min-height: 14px; }

  @media (max-width: 900px) {
    .wave-nodes { grid-template-columns: repeat(3, 1fr); height: auto; row-gap: 26px; padding: 20px 0; }
    .wave-svg { display: none; }
    .wave-item, .wave-item.up, .wave-item.down { justify-content: flex-start; }
    .wave-stem { display: none; }
  }
  @media (max-width: 560px) { .wave-nodes { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  // Woven Foundation threads replay every time they scroll into view —
  // same pattern as the vitals pulse line on medical-detox/MAT.
  (() => {
    const root = document.getElementById("weave-core");
    if (!root) return;
    const paths = Array.from(root.querySelectorAll<SVGPathElement>(".weave-path"));
    if (!paths.length || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) paths.forEach((p) => p.classList.add("draw"));
          else paths.forEach((p) => p.classList.remove("draw"));
        }
      },
      { threshold: 0.4 }
    );
    io.observe(root);
  })();
</script>

<script>
  // Wellness Wave path replays every time it scrolls into view — same
  // pattern as Woven Foundation and the vitals pulse line.
  (() => {
    const root = document.getElementById("wave-holistic");
    if (!root) return;
    const path = root.querySelector<SVGPathElement>(".wave-path");
    if (!path || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) path.classList.toggle("draw", e.isIntersecting);
      },
      { threshold: 0.4 }
    );
    io.observe(root);
  })();
</script>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
