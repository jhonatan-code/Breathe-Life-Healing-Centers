---
import { msymChar } from "../../lib/icons";
/**
 * /admissions/insurance/ — the substantial insurance-verification page per
 * the batch brief: explains how verification works generally, embeds
 * VerifyInsuranceForm prominently in the hero, shows the real insurer set
 * (src/data/home.ts `insurers` — the same list SiteInsurance.astro uses, no
 * carriers invented beyond it), and states the Medi-Cal/Medicare exclusion
 * using the exact approved wording already live in the what-we-treat FAQs
 * (see cocaine.astro / methamphetamine.astro: "We do not currently accept
 * Medi-Cal or Medicare.").
 *
 * SiteInsurance is skipped below — its marquee + "we don't accept Medi-Cal
 * or Medicare" line would just repeat the custom section built into this
 * page, so rendering it again would be redundant (per the batch brief,
 * that's a judgment call left to this page).
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { insurers } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Verify Your Insurance | Breathe Admissions";
const description =
  "See how insurance verification works at Breathe Life Healing Centers. We're in-network with most major insurers and check your specific benefits at no cost. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const steps = [
  { icon: "contact_page", title: "Share your basics", text: "Tell us your name, number, and insurance carrier — online or over the phone. Your policy ID helps but isn't required to get started." },
  { icon: "support_agent", title: "We call your insurer", text: "Our admissions team contacts your insurance company directly to check your specific plan, not a generic estimate." },
  { icon: "fact_check", title: "You get a clear answer", text: "We explain what's covered, in plain language, before you commit to anything or share more than you're ready to." },
  { icon: "event_available", title: "You decide what's next", text: "If you want to move forward, we help you plan admission. If now isn't the time, that's your call — no pressure either way." },
] as const;

const faqs = [
  { q: "Does insurance cover addiction and mental health treatment?", a: "In most cases, yes. We're in-network with most major providers, and our team verifies your specific benefits before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
  { q: "Do I need my insurance card to get started?", a: "It helps, but it's not required to make the first call. If you don't have your policy ID handy, we can usually look up your coverage with your name and insurer." },
  { q: "Will checking my insurance cost me anything?", a: "No. Verification is free and doesn't obligate you to anything. You'll know what's covered before you decide anything else." },
  { q: "Is my information kept confidential?", a: "Yes. What you share with us during verification is handled confidentially, whether or not you move forward with treatment." },
  { q: "What if my insurance isn't listed here?", a: "Call us — many plans are still in-network even if the logo isn't shown, and we verify based on your actual policy, not just the carrier name." },
  { q: "What happens after my insurance is verified?", a: "We walk you through what's covered, answer your questions, and — if you're ready — help coordinate your assessment and arrival." },
];

const pageUrl = new URL("/admissions/insurance/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Admissions", item: new URL("/admissions/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Verify Your Insurance", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/admissions/insurance/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Admissions" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-03-clinical-office.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/admissions/" style="color:#7FB3BC;">Admissions</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Verify Your Insurance
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Verify Your Insurance Before You Commit to Anything</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">We're in-network with most major insurers. Share a few details and our admissions team will verify your specific benefits directly with your insurer, at no cost and no obligation.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href={HREF} style={S.ctaWhite}>Call Us 24/7: {PH}</a>
            <a class="cta" href="/admissions/what-to-bring/" style={S.ctaGhost}>What to Bring</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Everything you share is confidential.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  HOW VERIFICATION WORKS  ══════════════ */}
    <section data-screen-label="How it works" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How it works</div>
          <h2 style={`${S.h2}max-width:30ch;`}>How insurance verification works</h2>
          <p style={`${S.intro}max-width:74ch;`}>Four steps, usually completed within one business day. You'll know exactly what's covered before you're asked to decide anything.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">
          {steps.map((s, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(s.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{s.title}</h3>
                <p style={S.card}>{s.text}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  INSURERS + MEDI-CAL/MEDICARE NOTE  ══════════════ */}
    <section id="insurance" data-screen-label="Insurers" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Cost &amp; coverage</div>
        <h2 style={`${S.h2}max-width:52ch;`}>We're in-network with most major insurers</h2>
        <p style={`${S.intro}max-width:84ch;margin-bottom:30px;`}>Every plan is different, which is why we verify your actual policy instead of quoting a generic estimate. Below are some of the carriers we regularly work with.</p>
        <div id="ins-wrap" style="margin-bottom:26px;">
          <div id="ins-track" class="no-scrollbar" style="display:flex;align-items:center;overflow-x:auto;">
            {[...insurers, ...insurers, ...insurers, ...insurers].map((i, k) => (
              <div aria-hidden={k >= insurers.length ? "true" : undefined} style="flex:0 0 210px;display:flex;align-items:center;justify-content:center;padding:0 8px;box-sizing:border-box;">
                <img src={i.src} alt={i.name} loading="lazy" style={`height:${i.h}px;width:auto;max-width:170px;object-fit:contain;`} />
              </div>
            ))}
          </div>
        </div>
        <div style="max-width:640px;margin:0 auto;background:#FFFFFF;border:1px solid #E2DED7;border-radius:12px;padding:22px 26px;">
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#3A444D;margin:0;">We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help.</p>
        </div>
      </div>
    </section>

    {/* ══════════════  WHY VERIFY FIRST  ══════════════ */}
    <section data-screen-label="Why verify first" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:860px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Why this comes first</div>
        <h2 style={`${S.h2}max-width:26ch;`}>No surprises, before or after</h2>
        <p style={`${S.intro}max-width:76ch;`}>We verify insurance early so you're never guessing what's covered. That's also why our admissions specialists ask for your carrier and policy details up front — not to gatekeep, but so the answer you get back is specific to you, not a generic range.</p>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFAQ
      heading="Questions people ask about insurance"
      intro="Straight answers about how coverage and verification work here."
      groups={[{ items: faqs }]}
      background="#F7F5F1"
    />

    <SiteFinalCTA
      heading="Ready to Check Your Coverage?"
      subhead="Fill out the form above or call us directly — either way, a real person on our admissions team will walk you through what's covered."
      secondary={{ label: "See What to Bring", href: "/admissions/what-to-bring/" }}
      background="/Asset/Facility/facility-07-pool-waterfall-grotto.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // ── Insurance logo marquee (auto-scroll, pause on hover/focus) ───────────
  (() => {
    const track = document.getElementById("ins-track");
    const wrap = document.getElementById("ins-wrap");
    if (!track || !wrap) return;
    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
    const SPEED = 0.03;
    let last = 0, pos: number | null = null, paused = false;
    wrap.addEventListener("mouseenter", () => (paused = true));
    wrap.addEventListener("mouseleave", () => (paused = false));
    wrap.addEventListener("focusin", () => (paused = true));
    wrap.addEventListener("focusout", () => (paused = false));
    const step = (t: number) => {
      const half = track.scrollWidth / 2;
      if (last && !paused && half > 0) {
        if (pos == null) pos = track.scrollLeft;
        pos += (t - last) * SPEED;
        if (pos >= half) pos -= half;
        track.scrollLeft = pos;
      }
      last = t;
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  })();
</script>
