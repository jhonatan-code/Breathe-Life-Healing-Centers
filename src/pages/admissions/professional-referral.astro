---
import { msymChar } from "../../lib/icons";
/**
 * /admissions/professional-referral/ — content for clinicians/therapists
 * referring a client into care. General process framing only per the batch
 * brief: no specific reimbursement/partnership terms invented, no fabricated
 * turnaround-time SLAs or dedicated-line claims beyond the real sitewide
 * phone number in config/site.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;
const EMAIL = site.email;
const EMAIL_HREF = site.emailHref;

const title = "Professional Referral | Breathe Admissions";
const description =
  "Refer a client to Breathe Life Healing Centers — an LGBTQ+-affirming provider offering medical detox, residential, PHP, IOP, and outpatient care in Los Angeles. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const process = [
  { icon: "call", title: "Reach our admissions team", text: "Call our admissions line directly, any time, to discuss your client's situation and the levels of care we offer." },
  { icon: "assignment", title: "Share what's relevant", text: "A general clinical picture helps us match your client to the right level of care — you decide what's appropriate to share at this stage." },
  { icon: "shield", title: "We verify their insurance", text: "Our team contacts their insurer directly and confirms coverage before anyone commits to anything, so you and your client both know where things stand." },
  { icon: "handshake", title: "We keep you in the loop", text: "With appropriate consent from your client, we can coordinate with you on their care as they move through our program." },
] as const;

const levels = [
  { label: "Medical Detox", href: "/programs/medical-detox/" },
  { label: "Residential Treatment", href: "/programs/residential-treatment/" },
  { label: "PHP — Day Treatment", href: "/programs/php/" },
  { label: "Intensive Outpatient (IOP)", href: "/programs/intensive-outpatient/" },
  { label: "Outpatient Rehab", href: "/programs/outpatient-rehab/" },
  { label: "Enhanced Sober Living", href: "/programs/sober-living/" },
] as const;

const faqs = [
  { q: "How do I refer a client to Breathe?", a: "Call our admissions line directly, any time. A member of our team will discuss your client's situation and walk through next steps together." },
  { q: "What levels of care does Breathe offer?", a: "Medical detox, residential treatment, PHP, IOP, outpatient rehab, and enhanced sober living, alongside [case management](/programs/case-management/) and [medication-assisted treatment](/programs/medication-assisted-treatment/) where appropriate." },
  { q: "Is Breathe only for LGBTQ+ clients?", a: "No. We're [built for the LGBTQ+ community first](/signature-services/lgbtq/), and that shapes how we treat everyone, but our doors are open to any client whose values align with how we operate." },
  { q: "Will I stay informed about my client's care?", a: "With appropriate consent from your client, our team can coordinate with you as they move through treatment. Federal confidentiality protections mean this always requires their authorization." },
  { q: "Does Breathe accept my client's insurance?", a: "We're in-network with most major providers and [verify each client's specific benefits](/admissions/insurance/) before anything is decided. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
  { q: "Who do I contact with questions before referring?", a: "Call our admissions line 24/7, or reach out by email — a real person will get back to you." },
];

const pageUrl = new URL("/admissions/professional-referral/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Admissions", item: new URL("/admissions/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Professional Referral", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/admissions/professional-referral/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Admissions" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-11-clinical-building-exterior.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/admissions/" style="color:#7FB3BC;">Admissions</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Professional Referral
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Refer a Client to Breathe</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">For clinicians, therapists, and other providers connecting a client with LGBTQ+-affirming addiction and mental health treatment in Los Angeles.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href={HREF} style={S.ctaWhite}>Call Us 24/7: {PH}</a>
            <a class="cta" href={EMAIL_HREF} style={S.ctaGhost}>Email Our Team</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">A real person answers, 24 hours a day.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  REFERRAL PROCESS  ══════════════ */}
    <section data-screen-label="Referral process" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How it works</div>
          <h2 style={`${S.h2}max-width:30ch;`}>How a referral works</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {process.map((p, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(p.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{p.title}</h3>
                <p style={S.card}>{p.text}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  LEVELS OF CARE  ══════════════ */}
    <section data-screen-label="Levels of care" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:860px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>What we offer</div>
        <h2 style={`${S.h2}max-width:26ch;`}>Levels of care your client could enter</h2>
        <p style={`${S.intro}max-width:76ch;margin-bottom:22px;`}>Our clinical team determines the right starting point during the assessment, based on your client's specific needs.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:26px;">
          {levels.map((l) => (
            <a class="link-card" href={l.href} style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid #C9D2DA;border-radius:999px;padding:9px 16px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">{l.label}</a>
          ))}
        </div>
        <a class="cta" href="/programs/" style={`display:inline-block;${S.ctaBlue}`}>See All Programs</a>
      </div>
    </section>

    {/* ══════════════  WHY REFER TO BREATHE  ══════════════ */}
    <section data-screen-label="Why refer here" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:860px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Why Breathe</div>
        <h2 style={`${S.h2}max-width:30ch;`}>Why Professionals Refer to Breathe</h2>
        <p style={`${S.intro}max-width:76ch;`}>Our team is built around lived recovery experience and training in LGBTQ+-specific and minority-stress-informed care, with correct names and pronouns used as a baseline, not an accommodation. We welcome referrals for any client whose values align with how we operate, LGBTQ+ or otherwise.</p>
      </div>
    </section>

    <SiteInsurance
      background="#F7F5F1"
      heading="In-network with most major insurers"
      intro="We verify your client's specific benefits directly with their insurer before anything is decided."
    />

    <SiteReviews />

    <SiteLocation />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFAQ
      heading="Questions referring providers ask"
      intro="Straight answers to what other clinicians ask before sending us a client."
      groups={[{ items: faqs }]}
      background="#F7F5F1"
    />

    <SiteFinalCTA
      heading="Let's Talk About Your Client"
      subhead="Call our admissions line 24/7, or reach out by email — a real person on our team will get back to you."
      primaryLabel={`Call Us 24/7: ${PH}`}
      secondary={{ label: "Email Our Team", href: EMAIL_HREF }}
      background="/Asset/Facility/facility-08-poolside-grotto-overlook.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
