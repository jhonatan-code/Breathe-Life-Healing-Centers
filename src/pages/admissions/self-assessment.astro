---
/**
 * /admissions/self-assessment/ — page shell/framing is real content (general
 * "not sure if treatment is right for you" framing is standard admissions
 * copy, not a clinical claim). The actual self-assessment questions are
 * CLINICAL CONTENT per the batch brief — what a screening tool actually
 * asks/measures requires a clinically-reviewed brief, which doesn't exist
 * yet, so that section is a ClinicalPlaceholder rather than invented
 * questions (CLAUDE.md: never invent YMYL content without a brief).
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import ClinicalPlaceholder from "../../components/ClinicalPlaceholder.astro";
import { site } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Self-Assessment | Breathe Admissions";
const description =
  "Not sure if treatment is the right next step? A private, no-obligation starting point at Breathe Life Healing Centers. Call 24/7 to talk it through with a real person.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const reasons = [
  "You're wondering whether what you're going through is \"serious enough\" to reach out about",
  "Someone in your life has said something that's stuck with you",
  "You've thought about getting help before, but haven't made the call",
  "You want to understand your options before you decide anything",
  "You're supporting someone else and aren't sure where to start",
];

const faqs = [
  { q: "Is this a diagnosis?", a: "No. A self-assessment is a private starting point for reflection, not a clinical diagnosis. Only a licensed clinician can assess and diagnose after speaking with you directly." },
  { q: "What happens after I complete it?", a: "That's up to you. You can call us to talk through what you noticed, with no pressure or obligation to move forward with anything." },
  { q: "Is it confidential?", a: "Yes. Whatever you share with us, whether through a self-assessment or a phone call, is handled confidentially." },
  { q: "What if I'm not sure treatment is 'serious enough' for me?", a: "That's a common feeling, and it isn't a reason to wait. A phone call with our admissions team costs nothing and doesn't commit you to anything." },
  { q: "Do I need insurance to talk to someone?", a: "No — you can call and talk to our admissions team regardless of insurance status. We'll help you understand coverage separately, when you're ready." },
  { q: "Is this only for LGBTQ+ people?", a: "No. We're built for the LGBTQ+ community first, and that shapes how we treat everyone, but our doors are open to anyone whose values align with how we operate." },
];

const pageUrl = new URL("/admissions/self-assessment/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Admissions", item: new URL("/admissions/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Self-Assessment", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/admissions/self-assessment/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="Admissions" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-21-quiet-reading-nook.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1440px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/admissions/" style="color:#7FB3BC;">Admissions</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Self-Assessment
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Not Sure If This Is For You?</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">You don't need certainty to reach out. A short self-assessment can be a private starting point for thinking it through, on your own terms.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href={HREF} style={S.ctaWhite}>Call Us 24/7: {PH}</a>
            <a class="cta" href="/admissions/insurance/" style={S.ctaGhost}>Verify Your Insurance</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Nothing here is a diagnosis. It's just a starting point.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  A FEW THINGS TO CONSIDER  ══════════════ */}
    <section data-screen-label="A few things to consider" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Getting oriented</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:30ch;`}>You don't need to be certain to reach out</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>There's no threshold you need to cross before it's "okay" to call. People reach out for all kinds of reasons, at all kinds of stages — a conversation with our admissions team costs nothing and commits you to nothing.</p>
        </div>
        <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:30px 30px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Common reasons people reach out</div>
          <div style="display:grid;gap:14px;">
            {reasons.map((s) => (
              <div style="display:flex;gap:12px;align-items:flex-start;">
                <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                  <span class="msym" style="font-size:15px;">check</span>
                </span>
                <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#3A444D;">{s}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  SELF-ASSESSMENT TOOL — CLINICAL PLACEHOLDER  ══════════════ */}
    <section data-screen-label="Self-assessment tool" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:900px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:28px;">
          <div style={S.eyebrow}>Self-assessment</div>
          <h2 style={`${S.h2}max-width:26ch;`}>Take a private self-assessment</h2>
          <p style={`${S.intro}max-width:64ch;`}>The screening questions themselves need to come from our clinical team before we can publish them here.</p>
        </div>
        <ClinicalPlaceholder
          kind="CLINICAL CONTENT"
          note="Self-assessment questions need clinical review before publishing. This should be a validated or clinically-approved screening tool (e.g. covering substance use and/or mental health), not staff-invented questions — placeholdered pending a brief from the clinical reviewer (see CLAUDE.md: clinical reviewer sign-off is currently TBD)."
        />
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="If you decide to move forward, our admissions team verifies your specific benefits before you commit to anything."
    />

    <SiteReviews />

    <SiteLocation />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFAQ
      heading="Questions people ask before reaching out"
      intro="Straight answers to what people wonder before they make the call."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    <SiteFinalCTA
      heading="You Don't Have to Be Sure to Call"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure — just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-09-twin-bedroom-suite.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
