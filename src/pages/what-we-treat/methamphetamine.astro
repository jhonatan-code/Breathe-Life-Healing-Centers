---
/**
 * /what-we-treat/methamphetamine/ — built from
 * docs/content/Breathe_Life_Methamphetamine_Page_Brief.docx (full
 * section-by-section copy). Visual language and section structure mirror
 * /what-we-treat/alcohol/ — same shared components, same card/pill/pillar
 * patterns — with copy substituted per the brief.
 *
 * Per the sitemap, this page also covers amphetamine addiction (old
 * Amphetamine Treatment page merges in) — acknowledged in the Understanding
 * section, no separate section.
 *
 * RESOLVED (per Breathe_Life_Claude_Code_Instructions.docx, confirmed by
 * Jasmine, 2026-09-14): "Crystal Clear" is renamed sitewide to "Chemsex
 * Programming." This also resolves the previously-flagged open item here,
 * since it's the same program already built out at
 * /signature-services/chemsex-treatment/ — the card below now links there
 * instead of the never-built /signature-services/crystal-clear/ placeholder.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Methamphetamine Addiction Treatment in Los Angeles | Breathe";
const description =
  "Medically supervised meth addiction treatment in Los Angeles: detox, residential care, and Chemsex Programming, our program for meth use tied to sex or identity. LGBTQ+-affirming. In-network with most major insurers. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const signs = [
  "Using more, or more often, to get the same effect",
  "Extended periods without sleep, followed by crashes",
  "Paranoia, agitation, or disconnection from reality",
  "Weight loss, skin issues, or changes in appearance",
  "Secrecy around use, especially where it intersects with sex or intimacy",
];

const care = [
  {
    icon: "monitor_heart", title: "Medical Detox", href: "/programs/medical-detox/", cta: "Learn About Medical Detox",
    text: "Early recovery from meth can include real physical and psychiatric risk. Our clinical team monitors closely, with psychiatric support available when symptoms are severe.",
  },
  {
    icon: "cottage", title: "Residential Treatment", href: "/programs/residential-treatment/", cta: "Learn About Residential Treatment",
    text: "Structure, distance from old patterns, and full clinical support while you rebuild sleep, trust, and stability.",
  },
  {
    icon: "wb_sunny", title: "PHP & IOP", href: "/programs/php/", cta: "Explore PHP & IOP",
    text: "Step-down options once you're stable, built around real life rather than replacing it.",
  },
  {
    icon: "diamond", title: "Chemsex Programming", href: "/signature-services/chemsex-treatment/", cta: "Learn About Chemsex Programming",
    text: "Specialized programming for meth use tied to sex, identity, or compulsion. Works alongside standard treatment, not instead of it.",
  },
];

const therapies: [string, string, string][] = [
  ["psychology", "Cognitive Behavioral Therapy (CBT)", "/therapies/cbt/"],
  ["balance", "Dialectical Behavior Therapy (DBT)", "/therapies/dbt/"],
  ["target", "Acceptance & Commitment Therapy (ACT)", "/therapies/act/"],
  ["forum", "Motivational Interviewing", "/therapies/motivational-interviewing/"],
  ["healing", "Trauma-Focused Therapy", "/therapies/trauma-focused-therapy/"],
  ["spa", "Somatic Therapy", "/therapies/somatic-therapy/"],
  ["self_improvement", "Holistic Therapy, Yoga & Mindfulness", "/therapies/holistic-therapy/"],
];

// "Approach Wheel" — same radial hub-and-spoke visual language as the
// Constellation pattern on the therapy modality pages, extended to a full
// ellipse for 7 nodes instead of 3. Geometry computed once at build time
// (no client JS needed). Same pattern as alcohol.astro (approved
// 2026-09-15, proposal 2 of 3), but sized down here to sit in a side
// column next to the heading/intro text instead of taking the full
// section width (user request, this page only).
const WHEEL_CX = 310, WHEEL_CY = 230, WHEEL_RX = 280, WHEEL_RY = 210;
const wheelNodes = therapies.map(([icon, name, href], i) => {
  const angle = ((-90 + (360 / therapies.length) * i) * Math.PI) / 180;
  const x = WHEEL_CX + WHEEL_RX * Math.cos(angle);
  const y = WHEEL_CY + WHEEL_RY * Math.sin(angle);
  return { icon, name, href, x, y };
});

const conditions: [string, string][] = [
  ["Depression", "/conditions/depression/"],
  ["Anxiety", "/conditions/anxiety/"],
  ["Trauma", "/conditions/trauma/"],
  ["Complex Trauma / C-PTSD", "/conditions/complex-trauma/"],
];

const why = [
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress. Open to anyone whose values align, without losing that center.",
  },
  {
    icon: "layers", title: "Treating what's underneath",
    text: "We don't treat meth addiction as a one-dimensional problem. Because in real life, it rarely is.",
  },
];

const faqs = [
  { q: "I've relapsed before. Can you still help?", a: "Yes. A long history with meth or a past relapse isn't proof recovery is out of reach. It's usually a sign someone needed a deeper level of support the first time." },
  { q: "What if my meth use is tied to sex or something I feel ashamed to talk about?", a: "That's more common than people think, and it's exactly what Chemsex Programming was built for. You won't be the first person to bring this into the room." },
  { q: "Can a family member reach out first, if I'm not ready?", a: "Yes. Many people who contact us are a parent, partner, or close friend calling on behalf of someone they love. We can talk you through where to start." },
  { q: "Is meth withdrawal medically dangerous?", a: "It can involve serious psychiatric symptoms like paranoia or psychosis, along with physical strain and severe sleep disruption. Medical monitoring during early recovery matters." },
  { q: "Does insurance cover meth addiction treatment?", a: "In most cases, yes. We're in-network with most major providers and verify your specific benefits before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
  { q: "Is this treatment only for LGBTQ+ clients?", a: "No. We're built for the LGBTQ+ community first, and that shapes how we treat everyone, but our doors are open to anyone whose values align with how we operate." },
];

const pageUrl = new URL("/what-we-treat/methamphetamine/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "What We Treat", item: new URL("/what-we-treat/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Methamphetamine", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
    {
      "@type": "MedicalWebPage",
      name: title,
      url: pageUrl,
      about: { "@type": "MedicalCondition", name: "Methamphetamine use disorder" },
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
  ],
};
---

<Layout title={title} description={description} path="/what-we-treat/methamphetamine/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="What We Treat" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-16-facility-entrance-drive.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/what-we-treat/" style="color:#7FB3BC;">What We Treat</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Methamphetamine
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Methamphetamine Addiction Treatment in Los Angeles. Come Back to Yourself.</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Real treatment for meth addiction goes past the crash and the cravings. It gets at what the drug was covering for, and what it takes to feel steady again.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person — no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING METH ADDICTION  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:30ch;`}>Understanding meth addiction</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>Meth changes more than behavior. It can affect sleep, thinking, mood, trust, relationships, and how safe a person feels in their own body. For some people it gets tied to performance and staying on. For others it's about escape, loneliness, or a mind that won't slow down.</p>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>Methamphetamine use carries real physical and psychiatric risk, including cardiovascular strain, severe sleep deprivation, and episodes of paranoia or psychosis. That's part of why medical support during early recovery matters, not just willpower.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;max-width:58ch;">This page also covers amphetamine addiction more broadly. The patterns and treatment approach are closely related, so we address both here rather than splitting into separate pages.</p>
        </div>
        <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:30px 30px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Common signs of meth addiction</div>
          <div style="display:grid;gap:14px;">
            {signs.map((s) => (
              <div style="display:flex;gap:12px;align-items:flex-start;">
                <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                  <Icon name="check" size={14} />
                </span>
                <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#3A444D;">{s}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  WHEN METH USE IS TIED TO SEX, INTIMACY, OR IDENTITY  ══════════════ */}
    <section data-screen-label="Chemsex context" style="padding:70px 37px;background:#F0F5FA;">
      <div style="max-width:1060px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Why this matters</div>
        <h2 style={`${S.h2}max-width:40ch;`}>When meth use is tied to sex, intimacy, or identity</h2>
        <p style={`${S.intro}max-width:78ch;margin-bottom:14px;`}>This is more common than most people expect, and it deserves care that doesn't flinch from it. When meth use is connected to sex, secrecy, or compulsive patterns, generic addiction treatment often misses what's actually going on.</p>
        <p style={`${S.intro}max-width:78ch;margin-bottom:28px;`}>Chemsex Programming, our program built specifically for this, treats it as the real clinical issue it is. Not a moral failing, and not folded into general sex addiction treatment.</p>
        <a class="cta" href="/signature-services/chemsex-treatment/" style={`display:inline-block;${S.ctaBlue}`}>Learn About Chemsex Treatment</a>
      </div>
    </section>

    {/* ══════════════  HOW WE TREAT METH ADDICTION  ══════════════ */}
    <section data-screen-label="How we treat it" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How we help</div>
          <h2 style={`${S.h2}max-width:26ch;`}>How we treat meth addiction</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {care.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{c.icon}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{c.cta} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  OUR CLINICAL APPROACH — Approach Wheel  ══════════════
       Same pattern as alcohol.astro: radial hub-and-spoke instead of a
       link-card grid. Reverted from the side-column split back to the
       full-width centered layout: getting real separation between all 7
       nodes at the 14px text floor needed a wheel too large (~740px) to
       fit a narrow side column without squeezing the heading/intro text
       into an unreadably narrow strip, so this now matches alcohol.astro's
       geometry exactly. */}
    <section data-screen-label="Clinical approach" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1100px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:20px;">
          <div style={S.eyebrow}>Our clinical approach</div>
          <h2 style={`${S.h2}max-width:26ch;`}>Evidence-based care, matched to you</h2>
          <p style={`${S.intro}max-width:78ch;`}>Treatment here draws on evidence-based modalities matched to what you actually need, not a one-size program.</p>
        </div>
        <div class="wheel">
          <svg viewBox={`0 0 ${WHEEL_CX * 2} ${WHEEL_CY * 2}`} preserveAspectRatio="none" aria-hidden="true">
            {wheelNodes.map((n) => (
              <path d={`M${WHEEL_CX},${WHEEL_CY} L${n.x.toFixed(1)},${n.y.toFixed(1)}`} />
            ))}
          </svg>
          <div class="wheel-hub"><span class="msym">bolt</span><b>Meth<br />Treatment</b></div>
          {wheelNodes.map((n) => (
            <a class="wheel-node" href={n.href} style={`left:${n.x.toFixed(1)}px;top:${n.y.toFixed(1)}px;`}>
              <span class="ic"><span class="msym">{n.icon}</span></span>
              <span>{n.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  CO-OCCURRING CONDITIONS  ══════════════ */}
    <section data-screen-label="Co-occurring conditions" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:860px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Dual diagnosis</div>
        <h2 style={`${S.h2}max-width:24ch;`}>Meth use rarely travels alone</h2>
        <p style={`${S.intro}max-width:76ch;margin-bottom:22px;`}>Anxiety, depression, trauma, and complex trauma often show up alongside it — sometimes as cause, sometimes as consequence. We treat what's actually happening, not just the meth use.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:26px;">
          {conditions.map(([name, href]) => (
            <a class="link-card" href={href} style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid #C9D2DA;border-radius:999px;padding:9px 16px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">{name}</a>
          ))}
        </div>
        <a class="cta" href="/conditions/dual-diagnosis/" style={`display:inline-block;${S.ctaBlue}`}>Learn About Dual Diagnosis</a>
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for meth detox and treatment — before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why choose Breathe for meth treatment</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{w.icon}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* The #verify form lives in the hero on desktop; VerifyInsuranceForm's
       script relocates the form node into #verify-mobile-slot at ≤1024px so
       mobile users meet it here, right before the FAQs. */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFAQ
      heading="Questions people ask about meth treatment"
      intro="Straight answers to what people and families ask us before they decide anything."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    <SiteFinalCTA
      heading="Are you ready to take the first step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure — just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-16-facility-entrance-drive.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* ── Approach Wheel — "Our clinical approach" ─────────────────────── */
  .wheel { position: relative; width: 100%; max-width: 620px; height: 460px; margin: 0 auto; }
  .wheel svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .wheel svg path { fill: none; stroke: #E2DED7; stroke-width: 1.5; }
  .wheel-hub {
    position: absolute; top: 230px; left: 310px; transform: translate(-50%, -50%); width: 132px; height: 132px; border-radius: 50%;
    background: #16293D; color: #fff; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4px;
    text-align: center; z-index: 2; box-shadow: 0 10px 30px rgba(22,41,61,.25);
  }
  .wheel-hub .msym { font-size: 26px; color: #7FB3BC; }
