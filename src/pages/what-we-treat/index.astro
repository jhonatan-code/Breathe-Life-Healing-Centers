---
import { msymChar } from "../../lib/icons";
/**
 * /what-we-treat/ — What We Treat section hub (sitemap: "What We Treat
 * (overview)"). No dedicated content brief exists for this hub yet, so all
 * copy here is original structural/marketing framing (headings, card
 * blurbs, CTA labels) rather than invented clinical content — mirrors the
 * pattern used for /programs/ (also brief-less). Card grid mirrors
 * /programs/'s hub pattern: icon, title, one-line blurb, link.
 *
 * Links to all 11 substance pages: the 3 that already existed (Alcohol,
 * Methamphetamine, Cocaine) plus the 8 built in this batch (Opioids, Xanax,
 * Benzodiazepines, Kratom, Marijuana, Designer/Synthetic Drugs, Inhalants,
 * Co-Occurring Eating Disorders).
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import NetworkDiagram from "../../components/NetworkDiagram.astro";
import { site, primaryNav } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "What We Treat | Substance Use & Addiction Treatment | Breathe";
const description =
  "Every substance we treat at Breathe Life Healing Centers: alcohol, opioids, benzodiazepines, stimulants, and more, plus co-occurring mental health and eating disorder support. LGBTQ+-affirming, Los Angeles. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const substances = [
  { icon: "local_bar", title: "Alcohol", href: "/what-we-treat/alcohol/", text: "Medical detox and residential care for alcohol use disorder.", cat: "depressant" },
  { icon: "bolt", title: "Methamphetamine", href: "/what-we-treat/methamphetamine/", text: "Treatment for meth and amphetamine use, including Chemsex Programming.", cat: "stimulant" },
  { icon: "science", title: "Cocaine", href: "/what-we-treat/cocaine/", text: "CBT and motivational interviewing for cocaine and stimulant use.", cat: "stimulant" },
  { icon: "medication", title: "Opioids", href: "/what-we-treat/opioids/", text: "Care for heroin, fentanyl, and prescription opioid use, together.", cat: "opioid" },
  { icon: "bedtime", title: "Xanax", href: "/what-we-treat/xanax/", text: "Medically supervised support for Xanax (alprazolam) dependence.", cat: "depressant" },
  { icon: "healing", title: "Benzodiazepines", href: "/what-we-treat/benzodiazepines/", text: "Support for Klonopin, Ativan, Valium, and related medications.", cat: "depressant" },
  { icon: "eco", title: "Kratom", href: "/what-we-treat/kratom/", text: "Real treatment for kratom dependence, taken seriously.", cat: "other" },
  { icon: "spa", title: "Marijuana", href: "/what-we-treat/marijuana/", text: "Support for marijuana use disorder, without judgment.", cat: "other" },
  { icon: "biotech", title: "Designer / Synthetic Drugs", href: "/what-we-treat/designer-drugs/", text: "Care for synthetic cannabinoids, bath salts, and other designer drugs.", cat: "other" },
  { icon: "air", title: "Inhalants", href: "/what-we-treat/inhalants/", text: "Treatment for inhalant use disorder, with the same seriousness as any other.", cat: "other" },
  { icon: "restaurant", title: "Co-Occurring Eating Disorders", href: "/what-we-treat/eating-disorders/", text: "Body-image and emotional-eating support, integrated into your care.", cat: "cooccurring" },
] as const;

// Groups substances the way they come up in conversation rather than
// alphabetically — "Substance Groups" proposal, approved 2026-09-15.
// Colors reused from the site's existing accent palette (no new hues):
// blue/teal/dark-teal are already load-bearing elsewhere, seaglass kept to
// this one small dot per CLAUDE.md's ~2%-of-surface rule.
const categories = [
  { id: "depressant", label: "Depressants", color: "#33679C" },
  { id: "stimulant", label: "Stimulants", color: "#C98A3A" },
  { id: "opioid", label: "Opioids", color: "#478694" },
  { id: "other", label: "Other Substances", color: "#2C5A64" },
  { id: "cooccurring", label: "Co-occurring", color: "#7FB3BC" },
] as const;

const why = [
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress. Open to anyone whose values align, without losing that center.",
  },
  {
    icon: "layers", title: "Treating what's underneath",
    text: "We don't treat any one substance as a one-dimensional problem. Because in real life, it rarely is.",
  },
];

// Verbatim from Breathe_Life_What_We_Treat_FAQ.docx (2026-09-14) — this hub
// had no FAQ section at all, not even a placeholder, unlike every other
// page reviewed so far.
const faqs = [
  { q: "I'm not sure which substance page applies to me. What do I do?", a: "You don't have to self-diagnose. Call our admissions team and talk through your situation, they'll help point you to the right page and the right level of care." },
  { q: "What if I use more than one substance?", a: "Very common, and treated as one plan, not separate problems. Whichever page best matches your primary concern is a fine place to start, your treatment plan will address everything, not just one substance." },
  { q: "Do you treat mental health conditions as well as substance use?", a: "Yes. Depression, anxiety, trauma, and dual diagnosis are addressed alongside substance use, not as an afterthought." },
  { q: "What is Dual Diagnosis, and why is it shown at the center of how you treat things?", a: "[Dual Diagnosis](/what-we-treat/dual-diagnosis/) is our model for treating substance use and mental health conditions together, as one plan. Most people we treat have both, so it sits at the center of how care is structured, not as a separate add-on service." },
  { q: "Is every substance treated the same way?", a: "No. Each page covers the specific approach for that substance, alcohol and opioid withdrawal, for example, carry different medical risks and require different protocols." },
  { q: "Is this only for LGBTQ+ clients?", a: "No. We're [built for the LGBTQ+ community first](/signature-services/lgbtq/), and that shapes how we treat everyone, but our doors are open to anyone whose values align with how we operate." },
  { q: "Is treatment covered by insurance no matter which page applies to me?", a: "In most cases, yes. We're in-network with most major providers and [verify your specific benefits](/admissions/insurance/) before you commit to anything. We do not currently accept Medi-Cal or Medicare. If that's your coverage, call us, we'll tell you straight away and point you toward a resource that can help." },
];

// Both nav groups (Substance Use + Mental Health, merged 2026-09-18) --
// this ItemList is meant to represent everything under "What We Treat" now,
// not just the substances half.
const whatWeTreatLinks = primaryNav.find((n) => n.label === "What We Treat")!.groups!.flatMap((g) => g.links);
const pageUrl = new URL("/what-we-treat/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "What We Treat", item: pageUrl },
      ],
    },
    {
      "@type": "ItemList",
      name: "What We Treat",
      itemListElement: whatWeTreatLinks.map((l, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: l.label,
        url: new URL(l.href, site.domain).href,
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/what-we-treat/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="What We Treat" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-19-outdoor-dining-deck.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> What We Treat
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">What We Treat in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Alcohol, opioids, stimulants, benzodiazepines, and more, plus the anxiety, depression, and trauma that often travel with them. Built for the LGBTQ+ community first, open to anyone ready to change.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  SUBSTANCES — GROUPED  ══════════════
       "Substance Groups" proposal: the 11 real substance pages clustered
       by how they come up in conversation (depressants / stimulants /
       opioids / other / co-occurring) instead of one flat 11-card grid.
       Static, no JS — each cluster gets a color rail matching its category. */}
    <section data-screen-label="Substances" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1080px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Substances</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Find the page that matches your situation</h2>
          <p style={`${S.intro}max-width:80ch;`}>Every page below covers assessment, levels of care, and how we treat what's underneath the substance use, not just the substance itself.</p>
        </div>
        <div class="cluster-wrap">
          {categories.map((cat) => {
            const items = substances.filter((s) => s.cat === cat.id);
            if (!items.length) return null;
            return (
              <div class="cluster">
                <div class="cluster-head">
                  <span class="cluster-bar" style={`background:${cat.color};`} />
                  <h3>{cat.label}</h3>
                  <span>{items.length} page{items.length > 1 ? "s" : ""}</span>
                </div>
                <div class="cluster-row">
                  {items.map((s) => (
                    <a class="cl-card" href={s.href}>
                      <span class="msym" style={`color:${cat.color};`}>{msymChar(s.icon)}</span>
                      <span>
                        <b>{s.title}</b>
                        <small>{s.text}</small>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <NetworkDiagram />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Why Choose Breathe</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{msymChar(w.icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews background="#FFFFFF" />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about what we treat"
      intro="Straight answers about finding the right page, co-occurring conditions, and coverage."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered, before you commit to anything."
      background="linear-gradient(180deg, #F7F5F1 0%, #FFFFFF 100%)"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* The #verify form lives in the hero on desktop; VerifyInsuranceForm's
       script relocates the form node into #verify-mobile-slot at ≤1024px —
       lands right before the Final CTA, after the FAQ above. */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Not sure which page fits your situation?"
      subhead="Our admissions team talks through what's going on first, then points you to the right level of care. No pressure, no obligation."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-12-residence-exterior.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* ── Substance Groups — "Substances" ─────────────────────────────── */
  /* Category panels in a 2-up grid instead of 5 full-width stacked rows,
     each panel a compact divided list rather than a card grid — cuts the
     section's overall height roughly in half. */
  .cluster-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 18px 22px; align-items: start; }
  .cluster { background: #F7F5F1; border: 1px solid #E2DED7; border-radius: 14px; padding: 20px 22px; }
  .cluster-head { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
  .cluster-bar { width: 4px; height: 16px; border-radius: 2px; flex: 0 0 auto; }
  .cluster-head h3 { font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin: 0; color: #14181C; }
  .cluster-head span { font-family: "Montserrat", Helvetica, sans-serif; font-size: 12px; color: #646D76; }
  .cluster-row { display: flex; flex-direction: column; }
  .cl-card {
    display: flex; align-items: flex-start; gap: 10px; text-decoration: none; color: inherit;
    padding: 9px 0; border-top: 1px solid #E2DED7;
  }
  .cluster-row .cl-card:first-child { border-top: 0; }
  .cl-card:hover b { text-decoration: underline; }
  .cl-card .msym { font-size: 18px; flex: 0 0 auto; margin-top: 1px; }
  .cl-card b { display: block; font-size: 14.5px; font-weight: 600; letter-spacing: -0.008em; }
  .cl-card small { display: block; font-family: "Montserrat", Helvetica, sans-serif; font-size: 14px; color: #646D76; margin-top: 2px; line-height: 1.4; }
</style>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
