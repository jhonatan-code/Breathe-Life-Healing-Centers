---
/**
 * /what-we-treat/marijuana/ — clinical content and FAQ sourced from
 * Breathe_Life_Marijuana_Content_and_FAQ.docx (2026-09-14), which defers to
 * the BLHC Content Client Profile as authoritative and is not going through
 * further client/team review. Content itself is sourced from the live page.
 *
 * ⚠️ OPEN CLIENT QUESTION, not resolved by this change: the live page (not
 * used as a source otherwise) mentions "adult and teen marijuana addiction
 * treatment." This is the first mention anywhere in this project of treating
 * minors, and nothing in the client profile or any other page confirms it.
 * The brief deliberately excludes it from the FAQ below pending a direct
 * yes/no from the client, since it may be a real scope or licensing
 * question, not just a copy detail. Do not add teen-related content until
 * that's confirmed.
 *
 * Per CLAUDE.md: never lead with, or frame punitively, Breathe's
 * abstinence-based in-treatment policy (no marijuana during treatment).
 * This page frames marijuana use disorder as a real, legitimate reason to
 * seek treatment on its own terms — the policy itself isn't mentioned here.
 * "Medical Detox" is deliberately left off the care cards below: unlike the
 * other substance pages, asserting marijuana requires medically supervised
 * detox would be a specific, unbriefed clinical claim.
 *
 * Structural/marketing copy (headings, framing sentences, CTA labels) is
 * original.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Marijuana Addiction Treatment in Los Angeles | Breathe";
const description =
  "Marijuana (cannabis) use disorder treatment in Los Angeles. Residential care, outpatient support, and dual diagnosis treatment. LGBTQ+-affirming. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const care = [
  {
    icon: "fact_check", title: "Comprehensive Assessment", href: "/admissions/self-assessment/", cta: "Start an Assessment",
    text: "We start by understanding your specific relationship with marijuana, not applying a generic label.",
  },
  {
    icon: "cottage", title: "Residential Treatment", href: "/programs/residential-treatment/", cta: "Learn About Residential Treatment",
    text: "Full-time structure and clinical support for working through what marijuana use has been standing in for.",
  },
  {
    icon: "psychology", title: "Cognitive Behavioral Therapy", href: "/therapies/cbt/", cta: "Learn About CBT",
    text: "Helps you recognize the thought patterns that drive use, and build different ones.",
  },
  {
    icon: "wb_sunny", title: "PHP & IOP", href: "/programs/php/", cta: "Explore PHP & IOP",
    text: "Step-down options once you're stable, built around real life rather than replacing it.",
  },
];

const conditions: [string, string][] = [
  ["Anxiety", "/conditions/anxiety/"],
  ["Depression", "/conditions/depression/"],
  ["Trauma", "/conditions/trauma/"],
];

// Verbatim from Breathe_Life_Marijuana_Content_and_FAQ.docx (2026-09-14),
// itself sourced from the live page.
const signs = [
  "Using daily or multiple times a day",
  "Needing more to get the same effect",
  "Irritability, insomnia, or anxiety when not using",
  "Prioritizing use over work, school, or relationships",
  "Loss of interest in previously enjoyed activities",
];

const faqs = [
  { q: "Is marijuana addiction actually a real, treatable condition?", a: "Yes. Regular use can lead to Cannabis Use Disorder, where the brain relies on THC to regulate mood, sleep, and appetite. It's a real clinical concern, not just a lifestyle choice." },
  { q: "Is marijuana withdrawal dangerous?", a: "It isn't life-threatening, but it's genuinely uncomfortable, irritability, insomnia, and intense cravings are common, and support makes a real difference in preventing relapse." },
  { q: "What does treatment for marijuana addiction actually involve?", a: "A comprehensive assessment of the role marijuana plays in your life, cognitive behavioral therapy, mindfulness-based relapse prevention, and holistic approaches like yoga and nutrition counseling." },
  { q: "Will co-occurring anxiety or depression be addressed too?", a: "Yes. Co-occurring mental health conditions are addressed as part of the same plan, not treated as separate from the marijuana use." },
  { q: "I'm not sure my marijuana use is 'bad enough' to need treatment. Should I still reach out?", a: "Yes. If it's affecting your relationships, responsibilities, or motivation, that's worth a real conversation, whatever your use looks like." },
  { q: "Does insurance cover marijuana addiction treatment?", a: "In most cases, yes. We're in-network with most major providers and verify your specific benefits before you commit to anything. We do not currently accept Medi-Cal or Medicare." },
];

const why = [
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress. Open to anyone whose values align, without losing that center.",
  },
  {
    icon: "family_restroom", title: "Family involved, on your terms",
    text: "Family therapy that doesn't assume blood relationships. Partners and chosen family are welcome participants.",
  },
];

const pageUrl = new URL("/what-we-treat/marijuana/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "What We Treat", item: new URL("/what-we-treat/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Marijuana", item: pageUrl },
      ],
    },
    {
      "@type": "MedicalWebPage",
      name: title,
      url: pageUrl,
      about: { "@type": "MedicalCondition", name: "Marijuana (cannabis) use disorder" },
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} path="/what-we-treat/marijuana/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="What We Treat" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-15-pool-deck-canyon-view.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1440px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/what-we-treat/" style="color:#7FB3BC;">What We Treat</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Marijuana
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Marijuana Addiction Treatment in Los Angeles. Support Without Judgment.</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Marijuana use disorder is real, even though cannabis is legal in California. If use that started recreationally or medically has started running your life, we can help.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING MARIJUANA ADDICTION  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:30ch;`}>Understanding marijuana addiction</h2>
          <p style={`${S.intro}margin:0 0 16px;max-width:58ch;`}>Marijuana's legal status in California doesn't change how it can affect someone's life. For some people, use that started recreationally or medically shifts into something harder to control.</p>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:0;max-width:58ch;">We treat marijuana use disorder the same way we treat any other substance use concern: with a real clinical assessment and a plan built around you.</p>
        </div>
        <div style="display:grid;gap:20px;">
          <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:26px 26px;">
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Signs of marijuana dependence</div>
            <div style="display:grid;gap:12px;">
              {signs.map((s) => (
                <div style="display:flex;gap:12px;align-items:flex-start;">
                  <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:6px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                    <span class="msym" style="font-size:14px;">check</span>
                  </span>
                  <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#3A444D;">{s}</span>
                </div>
              ))}
            </div>
          </div>
          <div style="background:#FFFFFF;border:1px solid #E2DED7;border-radius:12px;padding:22px 24px;">
            <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px;">
              <span class="msym" style="font-size:20px;color:#478694;">info</span>
              <div style="font-family:'Instrument Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:#2C5A64;">Withdrawal</div>
            </div>
            <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14.5px;line-height:1.6;color:#3A444D;margin:0;">Marijuana withdrawal isn't life-threatening, but it's real and can lead to relapse without support. Common symptoms include irritability, insomnia or vivid dreams, decreased appetite, restlessness, and intense cravings.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  HOW WE TREAT MARIJUANA ADDICTION  ══════════════ */}
    <section data-screen-label="How we treat it" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How we help</div>
          <h2 style={`${S.h2}max-width:28ch;`}>How we treat marijuana addiction</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {care.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{c.icon}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{c.cta} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;color:#646D76;margin:22px 0 0;text-align:center;">Treatment also draws on <a href="/therapies/yoga-mindfulness/" style="color:#2C5A64;font-weight:500;">mindfulness-based practices</a> and <a href="/therapies/holistic-therapy/" style="color:#2C5A64;font-weight:500;">holistic approaches</a> alongside clinical care.</p>
      </div>
    </section>

    {/* ══════════════  CO-OCCURRING CONDITIONS  ══════════════ */}
    <section data-screen-label="Co-occurring conditions" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:860px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Dual diagnosis</div>
        <h2 style={`${S.h2}max-width:24ch;`}>Marijuana use rarely travels alone</h2>
        <p style={`${S.intro}max-width:76ch;margin-bottom:22px;`}>Anxiety, depression, and trauma often show up alongside it. We treat what's actually happening, not just the marijuana use.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:26px;">
          {conditions.map(([name, href]) => (
            <a class="link-card" href={href} style="display:inline-flex;align-items:center;gap:8px;background:#F7F5F1;border:1px solid #C9D2DA;border-radius:999px;padding:9px 16px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">{name}</a>
          ))}
        </div>
        <a class="cta" href="/conditions/dual-diagnosis/" style={`display:inline-block;${S.ctaBlue}`}>Learn About Dual Diagnosis</a>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;color:#646D76;margin:22px 0 0;">See <a href="/what-we-treat/" style="color:#2C5A64;font-weight:500;">everything we treat</a>, including <a href="/what-we-treat/kratom/" style="color:#2C5A64;font-weight:500;">Kratom</a> and <a href="/what-we-treat/designer-drugs/" style="color:#2C5A64;font-weight:500;">Designer / Synthetic Drugs</a>.</p>
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for marijuana treatment, before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why choose Breathe for marijuana treatment</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{w.icon}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    <SiteFAQ
      heading="Questions people ask about marijuana treatment"
      intro="Straight answers about whether it's a real condition, withdrawal, treatment, and coverage."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* The #verify form lives in the hero on desktop; VerifyInsuranceForm's
       script relocates the form node into #verify-mobile-slot at ≤1024px so
       mobile users meet it here, right before the Final CTA. */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFinalCTA
      heading="Are you ready to take the first step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure, just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-15-pool-deck-canyon-view.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
