---
import { msymChar } from "../../lib/icons";
/**
 * /what-we-treat/alcohol/ — built from docs/content/Breathe_Life_Alcohol_Page_Brief.docx
 * (full section-by-section copy) and the approved sitemap. Visual language is
 * carried over from the homepage (src/pages/index.astro): same fonts, colors,
 * section rhythm, card styles, reveal-on-scroll and reduced-motion handling.
 * Header/footer are the new SiteHeader/SiteFooter (real nav, not scroll-anchors).
 *
 * REAL DATA: this page ranks #1 for "los angeles day alcohol detox" (53 mo.
 * visits / 43 tracked keywords) — that phrase is kept in the PHP & IOP copy
 * and section intro below; don't lose it in a future rewrite.
 *
 * 🔴 Open before publish: the SAMHSA LGBTQ+ alcohol-use disparity figure in
 * the "Alcohol use in the LGBTQ+ community" section is qualitative on
 * purpose — insert the verified stat + citation, don't approximate one.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VerifyInsuranceForm from "../../components/VerifyInsuranceForm.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteInsurance from "../../components/SiteInsurance.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFAQ from "../../components/SiteFAQ.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../config/site";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

const title = "Alcohol Detox & Addiction Treatment in Los Angeles | Breathe";
const description =
  "Medically supervised alcohol detox and day treatment in Los Angeles, including Los Angeles day alcohol detox, from an LGBTQ+-affirming team who've been where you are. In-network with most major insurers. Call 24/7.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaGhost: "background:transparent;color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const signs = [
  "Needing more to feel the same effect",
  "Drinking to manage anxiety, shame, or a body that doesn't feel safe",
  "Withdrawal symptoms (shaking, sweating, nausea, anxiety) when you try to stop",
  "Missing work, relationships, or commitments because of drinking or recovering from it",
  "Repeated attempts to cut back that haven't stuck",
];

const care = [
  {
    icon: "monitor_heart", title: "Medical Detox", href: "/programs/medical-detox/", cta: "Learn about Medical Detox",
    text: "Alcohol withdrawal can include serious, even life-threatening symptoms. Our medical team supervises detox around the clock, so your body can safely let go of what it's been depending on.",
  },
  {
    icon: "cottage", title: "Residential Treatment", href: "/programs/residential-treatment/", cta: "Learn about Residential Treatment",
    text: "Full-time, live-in care once detox is complete, structure, community, and clinical support while you rebuild.",
  },
  {
    icon: "wb_sunny", title: "PHP & IOP", href: "/programs/php/", cta: "Explore PHP & IOP",
    text: "Day treatment and intensive outpatient options for a lighter footprint once you're stable, including our Los Angeles day alcohol detox for those who don't need a residential stay.",
  },
  {
    icon: "medication", title: "Medication-Assisted Treatment", href: "/programs/medication-assisted-treatment/", cta: "Learn about MAT",
    text: "MAT is available to support alcohol recovery where it's clinically appropriate, as part of a full treatment plan, not a replacement for it.",
  },
];

const therapies: [string, string, string][] = [
  ["psychology", "Cognitive Behavioral Therapy (CBT)", "/therapies/cbt/"],
  ["balance", "Dialectical Behavior Therapy (DBT)", "/therapies/dbt/"],
  ["target", "Acceptance & Commitment Therapy (ACT)", "/therapies/act/"],
  ["forum", "Motivational Interviewing", "/therapies/motivational-interviewing/"],
  ["healing", "Trauma-Focused Therapy", "/therapies/trauma-focused-therapy/"],
  ["spa", "Somatic Therapy", "/therapies/somatic-therapy/"],
  ["self_improvement", "Holistic Therapy, Yoga & Mindfulness", "/therapies/holistic-therapy/"],
];

// "Approach Wheel" — same radial hub-and-spoke visual language as the
// Constellation pattern on the therapy modality pages, extended to a full
// ellipse for 7 nodes instead of 3. Geometry computed once at build time
// (no client JS needed), viewBox 620x460, hub at center. Approved
// 2026-09-15 (Proposal 2 of 3) — kept at its proven, non-touching size;
// text sits beside it in its own column rather than the wheel being
// shrunk to fit (that produced either overlapping cards or an unreadably
// narrow text column).
const WHEEL_CX = 310, WHEEL_CY = 230, WHEEL_RX = 280, WHEEL_RY = 210;
const wheelNodes = therapies.map(([icon, name, href], i) => {
  const angle = ((-90 + (360 / therapies.length) * i) * Math.PI) / 180;
  const x = WHEEL_CX + WHEEL_RX * Math.cos(angle);
  const y = WHEEL_CY + WHEEL_RY * Math.sin(angle);
  return { icon, name, href, x, y };
});

const conditions: [string, string][] = [
  ["Depression", "/what-we-treat/depression/"],
  ["Anxiety", "/what-we-treat/anxiety/"],
  ["Trauma", "/what-we-treat/trauma/"],
  ["Complex Trauma / C-PTSD", "/what-we-treat/complex-trauma/"],
];

const why = [
  {
    icon: "volunteer_activism", title: "Staff who've lived it",
    text: "Every clinician and counselor here has personal recovery experience. You're not explaining yourself to someone who's only read about it.",
  },
  {
    icon: "diversity_3", title: "Built for the LGBTQ+ community first",
    text: "Correct names, correct pronouns, and a team trained in minority stress, open to anyone whose values align, without losing that center.",
  },
  {
    icon: "family_restroom", title: "Chosen family, welcomed",
    text: "Family therapy that doesn't assume blood relationships. Partners and chosen family are valid participants in your recovery.",
  },
];

const faqs = [
  { q: "Is alcohol withdrawal actually dangerous?", a: "For some people, yes, it can include seizures and other serious symptoms. That's why medical detox, supervised around the clock, is the safe starting point rather than trying to stop on your own. More on what to expect: [5 Things You Probably Didn't Know About Alcohol Withdrawal](/blog/5-weird-things-alcohol-withdrawal/)." },
  { q: "Do you offer day treatment, or only residential?", a: "Both. We offer medically supervised day detox and [PHP](/programs/php/)/IOP options for people who don't need or want a residential stay, alongside full [residential care](/programs/residential-treatment/) for those who do." },
  { q: "Is this program only for LGBTQ+ clients?", a: "No. We're [built for the LGBTQ+ community first](/signature-services/lgbtq/), that shapes how we treat everyone, but our doors are open to anyone whose values align with how we operate." },
  { q: "Does insurance cover alcohol detox and treatment?", a: "In most cases, yes. We're in-network with most major providers, and our team [verifies your specific benefits](/admissions/insurance/) before you commit to anything." },
  { q: "What if I've relapsed before?", a: "That doesn't disqualify you. Many of the people we treat have tried before, that's part of the story, not a reason to turn you away." },
  { q: "Will you address my mental health, not just the drinking?", a: "Yes. Depression, anxiety, and trauma are treated as part of the same plan through our dual diagnosis approach, not as a separate, secondary concern." },
];

const pageUrl = new URL("/what-we-treat/alcohol/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "What We Treat", item: new URL("/what-we-treat/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Alcohol", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
    {
      "@type": "MedicalWebPage",
      name: title,
      url: pageUrl,
      about: { "@type": "MedicalCondition", name: "Alcohol use disorder" },
      provider: { "@id": new URL("/#organization", site.domain).href },
    },
  ],
};
---

<Layout title={title} description={description} path="/what-we-treat/alcohol/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="What We Treat" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src="/Asset/Facility/facility-16-facility-entrance-drive.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.9;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.5) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
            <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/what-we-treat/" style="color:#7FB3BC;">What We Treat</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Alcohol
          </nav>
          <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;">Alcohol Addiction Treatment in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0 0 30px;">Medically supervised alcohol detox, residential care, and day treatment from a team that's been where you are, built for the LGBTQ+ community first, open to anyone ready to change.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a class="cta cta--light" href="/admissions/" style={S.ctaWhite}>Start Your Treatment</a>
            <a class="cta" href={HREF} style={S.ctaGhost}>Call Us 24/7: {PH}</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>
        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  UNDERSTANDING ALCOHOL ADDICTION  ══════════════ */}
    <section data-screen-label="Understanding" style="position:relative;padding:70px 37px;background:#FFFFFF;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-100px;left:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(51,103,156,0.07),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(320px,1.15fr) minmax(300px,1fr);gap:48px;align-items:start;">
        <div>
          <div style={S.eyebrow}>Understanding</div>
          <h2 style={`${S.h2}margin:0 0 14px;max-width:30ch;`}>Understanding alcohol addiction</h2>
          <p style={`${S.intro}margin:0;max-width:58ch;`}>Alcohol is legal, everywhere, and often the substance people take most seriously last, which is part of what makes it dangerous. It's also one of the few substances where withdrawal itself can be medically dangerous, not just uncomfortable. If you've tried to stop before and your body fought back, that's not a personal failure. That's withdrawal, and it's exactly why medical detox exists.</p>
        </div>
        <div class="treat-card" style="background:#F7F5F1;border:1px solid #E2DED7;border-top:2px solid #33679C;border-radius:12px;padding:30px 30px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;margin-bottom:16px;">Common signs of alcohol addiction</div>
          <div style="display:grid;gap:14px;">
            {signs.map((s) => (
              <div style="display:flex;gap:12px;align-items:flex-start;">
                <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;background:rgba(51,103,156,0.10);color:#33679C;margin-top:1px;">
                  <Icon name="check" size={14} />
                </span>
                <span style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#3A444D;">{s}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  ALCOHOL USE IN THE LGBTQ+ COMMUNITY  ══════════════ */}
    <section data-screen-label="LGBTQ+ context" style="padding:70px 37px;background:linear-gradient(180deg, #FFFFFF 0%, #F7F5F1 100%);">
      <div style="max-width:960px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Why this matters</div>
        <h2 style={`${S.h2}max-width:30ch;`}>Alcohol use in the LGBTQ+ community</h2>
        <p style={`${S.intro}max-width:78ch;margin-bottom:24px;`}>This isn't a coincidence, and it isn't a character flaw. National survey data (SAMHSA) has consistently found LGBTQ+ adults report meaningfully higher rates of alcohol and substance use than heterosexual adults, a pattern researchers connect to minority stress, discrimination, and a lack of care that actually understands the difference.</p>
        <div style="position:relative;max-width:640px;margin:0 auto;padding:8px 24px 0;">
          <span aria-hidden="true" style="position:absolute;top:-30px;left:50%;transform:translateX(-50%);font-family:Georgia,serif;font-size:96px;line-height:1;color:rgba(51,103,156,0.12);pointer-events:none;">&ldquo;</span>
          <p style="position:relative;font-family:'Instrument Sans',sans-serif;font-size:clamp(19px,2vw,24px);line-height:1.4;font-weight:500;letter-spacing:-0.02em;color:#14181C;margin:0;text-wrap:balance;">We built this program around that reality, not around pretending it doesn't exist.</p>
        </div>
        {/* 🔴 Insert the verified SAMHSA disparity figure + citation before publish (brief COPY NOTE). Copy above is intentionally qualitative and publish-safe until then. */}
      </div>
    </section>

    {/* ══════════════  HOW WE TREAT ALCOHOL ADDICTION  ══════════════ */}
    <section data-screen-label="How we treat it" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>How we help</div>
          <h2 style={`${S.h2}max-width:24ch;`}>How we treat alcohol addiction</h2>
          <p style={`${S.intro}max-width:80ch;`}>Every plan starts with what your body needs first, from around-the-clock medical detox to day treatment, including Los Angeles day alcohol detox for people who don't need a residential stay.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
          {care.map((c, i) => {
            const teal = i % 2 === 1;
            return (
              <div class="treat-card" style={`display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1px solid #E2DED7;border-top:2px solid ${teal ? "#478694" : "#33679C"};border-radius:12px;padding:28px 26px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(c.icon)}</span>
                </span>
                <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0;text-wrap:balance;">{c.title}</h3>
                <p style={`${S.card}flex:1;`}>{c.text}</p>
                <a href={c.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{c.cta} <span aria-hidden="true">→</span></a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ══════════════  OUR CLINICAL APPROACH — Approach Wheel  ══════════════
       Extends the Constellation pattern already used on /therapies/cbt/ etc.
       to a full radial layout for all 7 modalities, hub = this page's own
       substance. Approved 2026-09-15 (Proposal 2 of 3). Text sits in its
       own column to the left of the wheel, which keeps its proven
       full size rather than being shrunk (a shrunk version either
       overlapped or needed a 740px-wide graphic). */}
    <section data-screen-label="Clinical approach" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1100px;margin:0 auto;">
        <div class="approach-split">
          <div>
            <div style={S.eyebrow}>Our clinical approach</div>
            <h2 style={`${S.h2}max-width:22ch;margin:0 0 14px;`}>Evidence-based care, matched to you</h2>
            <p style={`${S.intro}max-width:40ch;margin:0;`}>Treatment here draws on evidence-based modalities matched to what you actually need, not a one-size program.</p>
          </div>
          <div class="wheel">
            <svg viewBox={`0 0 ${WHEEL_CX * 2} ${WHEEL_CY * 2}`} preserveAspectRatio="none" aria-hidden="true">
              {wheelNodes.map((n) => (
                <path d={`M${WHEEL_CX},${WHEEL_CY} L${n.x.toFixed(1)},${n.y.toFixed(1)}`} />
              ))}
            </svg>
            <div class="wheel-hub"><span class="msym">{msymChar("local_bar")}</span><b>Alcohol<br />Treatment</b></div>
            {wheelNodes.map((n) => (
              <a class="wheel-node" href={n.href} style={`left:${n.x.toFixed(1)}px;top:${n.y.toFixed(1)}px;`}>
                <span class="ic"><span class="msym">{msymChar(n.icon)}</span></span>
                <span>{n.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  ALCOHOL & CO-OCCURRING CONDITIONS  ══════════════ */}
    <section data-screen-label="Co-occurring conditions" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:860px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Dual diagnosis</div>
        <h2 style={`${S.h2}max-width:22ch;`}>Alcohol rarely shows up alone</h2>
        <p style={`${S.intro}max-width:76ch;margin-bottom:22px;`}>Depression, anxiety, trauma, and complex trauma often travel with it, sometimes as the cause, sometimes as the consequence. Our dual diagnosis approach treats what's actually happening, not just the drinking.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:26px;">
          {conditions.map(([name, href]) => (
            <a class="link-card" href={href} style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid #C9D2DA;border-radius:999px;padding:9px 16px;font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:500;color:#14181C;">{name}</a>
          ))}
        </div>
        <a class="cta" href="/what-we-treat/dual-diagnosis/" style={`display:inline-block;${S.ctaBlue}`}>Learn about Dual Diagnosis</a>
      </div>
    </section>

    <SiteInsurance
      heading="In-network with most major insurers"
      intro="Our admissions team verifies your specific benefits and explains exactly what's covered for detox and treatment, before you commit to anything."
    />

    {/* ══════════════  WHY CHOOSE BREATHE  ══════════════ */}
    <section data-screen-label="Why Breathe" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Why Breathe</div>
          <h2 style={`${S.h2}max-width:34ch;`}>Why choose Breathe for alcohol treatment</h2>
        </div>
        <div class="pillars-row" style="max-width:1100px;margin:0 auto;background:#FFFFFF;border-radius:14px;box-shadow:0 1px 2px rgba(20,24,28,0.05),0 6px 16px rgba(20,24,28,0.05);">
          {why.map((w) => (
            <div style="padding:32px 30px;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{msymChar(w.icon)}</span>
              </span>
              <h3 style="font-size:19px;font-weight:600;letter-spacing:-0.014em;margin:0 0 10px;text-wrap:balance;">{w.title}</h3>
              <p style={S.card}>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    {/* ══════════════  VERIFY INSURANCE · mobile placement  ══════════════ */}
    {/* The #verify form lives in the hero on desktop; VerifyInsuranceForm's
       script relocates the form node into #verify-mobile-slot at ≤1024px so
       mobile users meet it here, right before the FAQs. */}
    <section id="verify-mobile-host" data-screen-label="Verify insurance" style="background:#16293D;padding:44px 20px;">
      <div id="verify-mobile-slot" style="max-width:440px;margin:0 auto;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:18px;text-align:center;">Check your coverage in minutes</div>
      </div>
    </section>

    <SiteFAQ
      heading="Questions people ask about alcohol treatment"
      intro="Straight answers to what people and families ask us before they decide anything."
      groups={[{ items: faqs }]}
      background="#FFFFFF"
    />

    <SiteFinalCTA
      heading="Are you ready to take the first step?"
      subhead="Whether it's your first call or your fifth, someone who's been where you are will pick up. No script, no pressure, just a real conversation about what comes next."
      secondary={{ label: "Send Us a Message", href: "/contact-us/" }}
      background="/Asset/Facility/facility-07-pool-waterfall-grotto.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* ── Approach Wheel — "Our clinical approach" ─────────────────────── */
  /* Text in its own column to the left; the wheel keeps its proven,
     non-touching full size (620x460) in a fixed-width right column
     instead of being shrunk to fit. */
  /* Wheel column is 736px, not 620: the absolutely-positioned nodes
     overflow the .wheel div's own 620px box by 58px on each side (its
     real visual footprint is ~736px), so the column has to reserve that
     or the widest nodes crowd into the text column. Node/pill spacing
     itself is untouched. */
  .approach-split { display: grid; grid-template-columns: minmax(260px, 1fr) 736px; gap: 40px; align-items: center; }
  .wheel { position: relative; width: 100%; max-width: 620px; height: 460px; margin: 0 auto; }
  .wheel svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .wheel svg path { fill: none; stroke: #E2DED7; stroke-width: 1.5; }
  .wheel-hub {
    position: absolute; top: 230px; left: 310px; transform: translate(-50%, -50%); width: 132px; height: 132px; border-radius: 50%;
    background: #16293D; color: #fff; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4px;
    text-align: center; z-index: 2; box-shadow: 0 10px 30px rgba(22,41,61,.25);
  }
  .wheel-hub .msym { font-size: 26px; color: #7FB3BC; }
  .wheel-hub b { font-size: 13px; font-weight: 700; line-height: 1.25; font-family: "Instrument Sans", sans-serif; }
  .wheel-node {
    position: absolute; display: flex; align-items: center; gap: 9px; background: #FFFFFF; border: 1px solid #E2DED7;
    border-radius: 14px; padding: 9px 14px 9px 9px; font-size: 14px; font-weight: 600; color: #14181C; text-decoration: none;
    line-height: 1.25; z-index: 2; transform: translate(-50%, -50%); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    width: 190px;
  }
  .wheel-node .ic { width: 26px; height: 26px; border-radius: 50%; background: rgba(51,103,156,.1); display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .wheel-node .ic .msym { font-size: 15px; color: #33679C; }
  .wheel-node:hover { transform: translate(-50%, -50%) scale(1.05); border-color: #33679C; box-shadow: 0 8px 20px rgba(51,103,156,.18); }
  @media (max-width: 1150px) {
    .approach-split { grid-template-columns: 1fr; gap: 28px; justify-items: center; text-align: center; }
  }
  @media (max-width: 660px) {
    .wheel { height: auto; display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .wheel svg { display: none; }
    .wheel-hub { position: static; transform: none; }
    .wheel-node { position: static; transform: none; max-width: none; width: 100%; justify-content: center; white-space: normal; }
    .wheel-node:hover { transform: translateY(-2px); }
  }
</style>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // The insurance-logo marquee and reviews carousel now live in
  // SiteInsurance.astro / SiteReviews.astro, shared across every page.
</script>
