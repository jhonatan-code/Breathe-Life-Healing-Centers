---
import { msymChar } from "../../lib/icons";
/**
 * /resources/media/ — "Media / Press", the one item in the Resources
 * dropdown (site.ts). Per the approved sitemap this absorbs the old
 * standalone "How to Choose Treatment" and "Brochures" pages, so it carries
 * general structural framing for both: a press/media-inquiries block, a
 * generic (non-clinical) "what to look for" section for anyone comparing
 * treatment centers, real downloadable brochures, and a press-coverage
 * section.
 *
 * Brochures (4 PDFs) and press references (5, grouped by category) are
 * both the same real items the official live site's own
 * /resources/media/ and /resources/our-brochures/ pages show (checked
 * 2026-09-18) — downloaded to /Asset/Brochures/ and /Asset/Press/ rather
 * than hotlinked to the old domain. The earlier version of this file
 * deliberately omitted any press coverage, since the founder-positioning
 * block (CLAUDE.md, docs/00-INVENTORY.md) made some specific backlinks
 * (NYT / Vanity Fair / BuzzFeed, all about Brad Lamm) off-limits — that
 * block was explicitly lifted 2026-09-15, and the user asked directly
 * for this section 2026-09-18, so it no longer applies here. Elizabeth
 * has additional press references beyond these 5 to add once received.
 *
 * Structure per BUILD NOTES: lighter than a clinical funnel — hero → content
 * sections → SiteReviews → SiteLocation → SiteFinalCTA. No forced insurance
 * form section, no FAQ.
 */
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteReviews from "../../components/SiteReviews.astro";
import SiteLocation from "../../components/SiteLocation.astro";
import SiteFinalCTA from "../../components/SiteFinalCTA.astro";
import { site } from "../../config/site";
import { galleryImg } from "../../data/home";

const PH = site.phoneDisplay;
const HREF = site.phoneHref;

// Same 4 PDFs as the official live site's /resources/our-brochures/
// (checked 2026-09-18), downloaded to /Asset/Brochures/ rather than
// hotlinked to the old domain.
const brochures = [
  { title: "Breathe Program Overview", text: "A general overview of our levels of care and how treatment works here.", file: "/Asset/Brochures/Breathe_Program_Overview.pdf" },
  { title: "Living in Recovery at Campus", text: "What day-to-day life looks like on our residential campus.", file: "/Asset/Brochures/Living_in_Recovery_at_Campus.pdf" },
  { title: "Chemsex Program", text: "Our specialized, sex-positive approach to chemsex and sexualized drug use.", file: "/Asset/Brochures/Chemsex-Brochure_7.26.pdf" },
  { title: "Family Class at Breathe", text: "How family is involved in treatment, and what Family Class covers.", file: "/Asset/Brochures/Breathe_-_Family_Class.pdf" },
] as const;

// Media coverage referenced on the official live site's own /resources/media/
// page (checked 2026-09-18) -- 5 items, grouped the same way that page
// groups them (Television / Blogs / Print). Logos downloaded to
// /Asset/Press/. Only Forbes carries a link, to the real, specific article
// URL -- the official site itself doesn't link the other 4 to anything
// (Today Show's own link there pointed at an old-site blog post, not the
// actual segment; the other 3 have no link at all), and per the site's
// standing rule against linking generic outlet homepages, they're shown as
// unlinked credits here too rather than inventing a destination.
const pressRefs = [
  { category: "Television", name: "Addicted to Food", outlet: "Oprah Winfrey Network (OWN)", logo: "/Asset/Press/oprah-addicted-to-food.jpg", text: "Follows eight people with eating disorders through a 42-day treatment program." },
  { category: "Television", name: "The Today Show", outlet: "NBC", logo: "/Asset/Press/today-show-media-page.png", text: "A morning news and talk show airing every morning on NBC." },
  { category: "Television", name: "The View", outlet: "ABC", logo: "/Asset/Press/the-view.png", text: "A morning talk show featuring a panel discussing the day's biggest stories." },
  { category: "Blogs", name: "Huffington Post", logo: "/Asset/Press/huffington-post.jpg", text: "An online news aggregator and blog founded by Arianna Huffington and colleagues." },
  { category: "Print", name: "Forbes", logo: "/Asset/Press/forbes.png", text: "“3 Ways Your Company's Mission Can Become Your Best Employee Engagement Tool.”", href: "https://www.forbes.com/sites/larrymyler/2013/11/06/3-ways-your-companys-mission-can-become-your-best-employee-engagement-tool/" },
] as const;

const title = "Media & Press | Breathe Life Healing Centers";
const description =
  "Press and media inquiries for Breathe Life Healing Centers, plus general guidance on what to look for when comparing an LGBTQIA+-affirming treatment center.";

const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

const lookFor = [
  { icon: "verified", title: "Licensing & accreditation", text: "Is the facility licensed in the state it operates in, and by whom? Ask to see it, not just a badge on a website." },
  { icon: "layers", title: "Levels of care offered", text: "Detox, residential, PHP, IOP: find out which ones actually exist on-site versus which are referred out." },
  { icon: "diversity_3", title: "Whether identity is actually centered", text: "Affirming language on a homepage is easy. Ask who's on staff, what training they've had, and how that shows up day to day." },
  { icon: "badge", title: "Staff credentials", text: "Who provides therapy, who provides medical care, and what their licenses are, this should be answerable directly, not vaguely." },
  { icon: "fact_check", title: "How insurance verification works", text: "A center that verifies your specific benefits before you commit is different from one that only says \"we accept most insurance.\"" },
  { icon: "family_restroom", title: "How family is involved", text: "Ask whether family programming assumes blood relationships, or makes room for partners and chosen family." },
];

const pageUrl = new URL("/resources/media/", site.domain).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.domain + "/" },
        { "@type": "ListItem", position: 2, name: "Resources", item: new URL("/resources/", site.domain).href },
        { "@type": "ListItem", position: 3, name: "Media & Press", item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={title} description={description} path="/resources/media/">
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader current="About" />

    <main id="main">

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src={galleryImg("facility-04-community-dining-lounge.jpg")} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.85;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.84) 48%,rgba(22,41,61,0.55) 100%);"></div>
      <div style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;">
        <nav aria-label="Breadcrumb" style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:22px;">
          <a href="/" style="color:#7FB3BC;">Home</a> <span aria-hidden="true" style="opacity:0.6;">›</span> <a href="/resources/" style="color:#7FB3BC;">Resources</a> <span aria-hidden="true" style="opacity:0.6;">›</span> Media & Press
        </nav>
        <h1 style="font-size:clamp(36px,4.2vw,56px);line-height:1.06;letter-spacing:-0.03em;font-weight:600;color:#FFFFFF;margin:0 0 22px;text-wrap:balance;max-width:22ch;">Media & Press</h1>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(17px,1.7vw,21px);line-height:1.55;font-weight:300;color:#E6EDF4;margin:0;max-width:64ch;">Press inquiries, and general guidance for anyone comparing treatment centers before they call.</p>
      </div>
    </section>

    {/* ══════════════  PRESS INQUIRIES  ══════════════ */}
    <section data-screen-label="Press inquiries" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:900px;margin:0 auto;text-align:center;">
        <div style={S.eyebrow}>Press inquiries</div>
        <h2 style={`${S.h2}max-width:26ch;`}>Reporting on Breathe or LGBTQIA+ behavioral health?</h2>
        <p style={`${S.intro}max-width:70ch;margin-bottom:26px;`}>For interview requests, fact-checking, or background on Breathe Life Healing Centers, reach our team directly. We're glad to help with accurate, responsibly sourced coverage.</p>
        <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
          <a class="cta" href={site.emailHref} style={`display:inline-flex;${S.ctaBlue}`}>{site.email}</a>
          <a class="cta" href={HREF} style="display:inline-flex;background:transparent;color:#33679C;border:1px solid #33679C;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;align-items:center;justify-content:center;">Call {PH}</a>
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT TO LOOK FOR — Wellness Wave  ══════════════
       Same pattern as /therapies/ "Holistic & experiential": six items
       riding a gentle wave instead of a grid, path redraws every time it
       scrolls back into view. */}
    <section data-screen-label="What to look for" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Comparing options</div>
          <h2 style={`${S.h2}max-width:32ch;`}>What to look for in a treatment center</h2>
          <p style={`${S.intro}max-width:74ch;margin:0 auto;`}>General questions worth asking of any facility you're considering, not just Breathe.</p>
        </div>
        <div class="wave-zone" id="wave-lookfor">
          <svg class="wave-svg" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
            <path class="wave-path" d="M0,60 C 100,10 200,10 300,60 C 400,110 500,110 600,60 C 700,10 800,10 900,60 C 1000,110 1100,110 1200,60" stroke="url(#waveGradLookfor)" />
            <defs>
              <linearGradient id="waveGradLookfor" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#33679C" /><stop offset="0.5" stop-color="#478694" /><stop offset="1" stop-color="#7FB3BC" />
              </linearGradient>
            </defs>
          </svg>
          <div class="wave-nodes">
            {lookFor.map((c, i) => {
              const colors = ["#33679C", "#3F76A0", "#478694", "#5C9CA3", "#6DAAAF", "#7FB3BC"];
              const dir = i % 2 === 0 ? "up" : "down";
              return (
                <div class={`wave-item ${dir}`}>
                  {dir === "up" ? (
                    <>
                      <div class="wave-card"><span class="wave-dot" style={`background:${colors[i]};`}><span class="msym">{msymChar(c.icon)}</span></span><h3>{c.title}</h3><p>{c.text}</p></div>
                      <div class="wave-stem" />
                    </>
                  ) : (
                    <>
                      <div class="wave-stem" />
                      <div class="wave-card"><span class="wave-dot" style={`background:${colors[i]};`}><span class="msym">{msymChar(c.icon)}</span></span><h3>{c.title}</h3><p>{c.text}</p></div>
                    </>
                  )}
                </div>
              );
            })}
          </div>
        </div>
        <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;text-align:center;margin:28px auto 0;max-width:70ch;">Have questions about how Breathe answers any of these? <a href={HREF} style="color:#2C5A64;font-weight:500;">Call us 24/7</a>, we'd rather you ask than guess.</p>
      </div>
    </section>

    {/* ══════════════  BROCHURES & MATERIALS  ══════════════ */}
    <section data-screen-label="Brochures & materials" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1180px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Downloadable materials</div>
          <h2 style={`${S.h2}max-width:26ch;`}>Brochures & printable overviews</h2>
          <p style={`${S.intro}max-width:66ch;margin:0 auto;`}>Real PDFs you can download, print, or share, covering our programs, campus life, family involvement, and the Chemsex Program.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">
          {brochures.map((b) => (
            <a href={b.file} target="_blank" rel="noopener noreferrer" style="display:flex;flex-direction:column;gap:10px;background:#F7F5F1;border:1px solid #E2DED7;border-radius:14px;padding:24px;text-decoration:none;color:inherit;">
              <span class="msym" style="font-size:28px;color:#33679C;">{msymChar("description")}</span>
              <h3 style="font-size:17px;font-weight:600;letter-spacing:-0.012em;margin:0;">{b.title}</h3>
              <p style={`${S.card}font-size:14.5px;flex:1;`}>{b.text}</p>
              <span style="font-family:'Instrument Sans',sans-serif;font-size:13.5px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">Download PDF <span aria-hidden="true">↓</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  PRESS & MEDIA COVERAGE  ══════════════
       Same 5 references the official live site's own /resources/media/
       page shows (checked 2026-09-18), grouped by category like that page
       does. Elizabeth has additional references beyond these 5 to add here
       once received -- this array is built to extend cleanly. */}
    <section data-screen-label="Press coverage" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1180px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:36px;">
          <div style={S.eyebrow}>Press coverage</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Where Breathe Has Been Featured</h2>
          <p style={`${S.intro}max-width:66ch;margin:0 auto;`}>Television, print, and online coverage Breathe has been part of over the years.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">
          {pressRefs.map((p) => {
            const card = (
              <>
                <div style="height:54px;display:flex;align-items:center;">
                  <img src={p.logo} alt={p.name} loading="lazy" style="max-height:54px;max-width:100%;width:auto;object-fit:contain;object-position:left center;display:block;" />
                </div>
                <div style="font-family:'Instrument Sans',sans-serif;font-size:10.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#2C5A64;margin:14px 0 4px;">{p.category}</div>
                <h3 style="font-size:16px;font-weight:600;letter-spacing:-0.01em;margin:0 0 6px;">{p.name}{"outlet" in p && p.outlet && <span style="font-weight:400;color:#646D76;"> · {p.outlet}</span>}</h3>
                <p style={`${S.card}font-size:14px;flex:1;`}>{p.text}</p>
                {"href" in p && p.href && (
                  <span style="margin-top:10px;font-family:'Instrument Sans',sans-serif;font-size:13px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:5px;">
                    Read the story <span class="msym" style="font-size:15px;">{msymChar("open_in_new")}</span>
                  </span>
                )}
              </>
            );
            const style = "display:flex;flex-direction:column;background:#FFFFFF;border:1px solid #E2DED7;border-radius:14px;padding:22px;";
            return "href" in p && p.href ? (
              <a href={p.href} target="_blank" rel="noopener noreferrer" style={`${style}text-decoration:none;color:inherit;`}>{card}</a>
            ) : (
              <div style={style}>{card}</div>
            );
          })}
        </div>
      </div>
    </section>

    <SiteReviews />

    <SiteLocation />

    <SiteFinalCTA
      heading="Ready to Talk to Someone?"
      subhead="Call 24/7 for a real conversation, no pressure, no obligation, or explore the rest of our resources first."
      secondary={{ label: "Back to Resources", href: "/resources/" }}
      background="/Asset/Facility/facility-12-residence-exterior.jpg"
    />

    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<style>
  /* ── Wellness Wave — "What to look for" ──────────────────────────── */
  .wave-zone { position: relative; padding: 20px 0 0; }
  .wave-svg { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); width: 100%; height: 120px; overflow: visible; pointer-events: none; }
  .wave-path { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1400; stroke-dashoffset: 1400; }
  .wave-path.draw { animation: wave-draw 2.2s ease-out forwards; }
  @keyframes wave-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .wave-path { stroke-dashoffset: 0; animation: none; } }
  .wave-nodes { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); column-gap: 14px; height: 270px; }
  .wave-item { position: relative; display: flex; flex-direction: column; align-items: center; }
  .wave-item.up { justify-content: flex-start; }
  .wave-item.down { justify-content: flex-end; }
  .wave-card {
    background: #FFFFFF; border: 1px solid #E2DED7; border-radius: 14px; padding: 16px 14px; text-align: center;
    width: 100%; max-width: 190px; box-shadow: 0 8px 20px rgba(20,24,28,.05);
  }
  .wave-dot { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; color: #fff; }
  .wave-dot .msym { font-size: 20px; }
  .wave-card h3 { font-size: 15px; font-weight: 600; margin: 0 0 5px; line-height: 1.3; }
  .wave-card p { font-family: "Montserrat", Helvetica, sans-serif; font-size: 14px; color: #646D76; margin: 0; line-height: 1.45; }
  .wave-stem { width: 2px; flex: 1; background: #E2DED7; min-height: 14px; }

  @media (max-width: 900px) {
    .wave-nodes { grid-template-columns: repeat(3, 1fr); height: auto; row-gap: 26px; padding: 20px 0; }
    .wave-svg { display: none; }
    .wave-item, .wave-item.up, .wave-item.down { justify-content: flex-start; }
    .wave-stem { display: none; }
  }
  @media (max-width: 560px) { .wave-nodes { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  // Wellness Wave path replays every time it scrolls into view — same
  // pattern as /therapies/ "Holistic & experiential".
  (() => {
    const root = document.getElementById("wave-lookfor");
    if (!root) return;
    const path = root.querySelector<SVGPathElement>(".wave-path");
    if (!path || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) path.classList.toggle("draw", e.isIntersecting);
      },
      { threshold: 0.4 }
    );
    io.observe(root);
  })();
</script>

<script>
  // ── Section reveal on scroll (same behaviour as the homepage) ────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();
</script>
