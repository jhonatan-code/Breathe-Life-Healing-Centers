---
import { msymChar } from "../lib/icons";
import Layout from "../layouts/Layout.astro";
import Schema from "../components/Schema.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import VerifyInsuranceForm from "../components/VerifyInsuranceForm.astro";
import SiteReviews from "../components/SiteReviews.astro";
import SiteInsurance from "../components/SiteInsurance.astro";
import SiteLocation from "../components/SiteLocation.astro";
import SiteFAQ from "../components/SiteFAQ.astro";
import SiteFinalCTA from "../components/SiteFinalCTA.astro";
import ClinicalPlaceholder from "../components/ClinicalPlaceholder.astro";
import ScrollActivateSteps from "../components/ScrollActivateSteps.astro";
import CareDial from "../components/CareDial.astro";
import FacilityGallery from "../components/FacilityGallery.astro";
import { site } from "../config/site";
import {
  gallery, galleryImg, substances, mentalHealth, levels, signature,
  why, team, steps, faqGroups,
} from "../data/home";

const PH = site.phoneDisplay;              // (877) 239-8684  — brief; design showed (877) 516-2604
const HREF = site.phoneHref;               // tel:+18772398684

const title = "LGBTQ+ Addiction & Mental Health Treatment in Los Angeles | Breathe";
const description =
  "LGBTQIA+-affirming addiction, detox and mental health treatment in Los Angeles, residential, PHP and IOP. In-network with most major insurers. Call 24/7.";

// shared inline style fragments (kept identical to the design)
const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

// "Why Breathe" Care Dial — labels/highlights are short restatements of the
// approved `why` copy above (same source every other page's why-grid uses),
// not new claims; kept local to the homepage since no other page uses the
// dial layout.
const whyLabels: [string, string][] = [
  ["LGBTQIA+", "Affirming"],
  ["Dual", "Diagnosis"],
  ["Chemsex", "Treatment"],
  ["Trauma", "Informed"],
  ["Residential", "Care"],
  ["Protected", "Privacy"],
  ["Chosen", "Family"],
  ["Lived", "Experience"],
];
const whyHighlights: string[][] = [
  ["Minority-stress-informed clinicians", "Pronouns respected, never re-explained", "Affirming care at every level, not a single track"],
  ["One coordinated care team, not two", "Anxiety, depression & trauma treated alongside substance use", "Integrated, not sequential, treatment"],
  ["One of few U.S. programs to address this directly", "Substance use and sexualized drug use treated together", "Clinically distinct from sex-addiction models"],
  ["Pacing and safety built in, not assumed", "Care shaped around how trauma actually presents", "Foundation for healing that lasts"],
  ["Private, inclusive campus in Laurel Canyon", "A place to live, not just a bed and a schedule", "Whole-person focus, not symptom management"],
  ["Confidentiality built into daily operations", "You decide who knows you're here", "Discretion at every touchpoint"],
  ["Family therapy & Family Class included", "A 3-Day Family Workshop", "Room for chosen family, not just family of origin"],
  ["Personal recovery experience, front desk to leadership", "Treated by people who've been there", "Lived experience woven through the whole team"],
];
const whyPillars = why.map(([icon, , title, desc], i) => ({
  icon,
  label: whyLabels[i],
  title,
  desc,
  highlights: whyHighlights[i],
}));

// Facility gallery wheel — a fixed 13-photo curated set (not the full 22;
// the rest live elsewhere on the page per user direction 2026-09-10), used
// consistently by the wheel, the mobile strip, and the lightbox. Card
// count keeps the ring overlapping properly at the wheel's fixed 520px
// size (user call 2026-09-10) — thumbnail size stays fixed, so ring size
// is tuned via count, not card dimensions. Great Room removed per user
// call 2026-09-10.

// Per-card anchor text for the "Levels of Care & Therapies" section below,
// replacing generic "Learn more" (Elizabeth, 2026-09-18). Keyed by href
// rather than added to the shared `levels` array in data/home.ts, since
// that array also feeds /programs/ and each level's own detail page --
// this wording is specific to this homepage section only.
const levelsCta: Record<string, string> = {
  "/programs/residential-treatment/": "Explore Our Residential Treatment Program",
  "/programs/medical-detox/": "Is Medical Detox Right for You? Learn More",
  "/programs/php/": "Learn About Our PHP Day Treatment Program",
  "/programs/intensive-outpatient/": "Explore Intensive Outpatient Treatment (IOP)",
  "/programs/sober-living/": "Learn About Transitional & Sober Living",
  "/programs/outpatient-rehab/": "Explore Our Outpatient Program",
};

const galleryWheelFiles = [
  "facility-07-pool-waterfall-grotto.jpg",
  "facility-10-fitness-center.jpg",
  "facility-11-clinical-building-exterior.jpg",
  "facility-12-residence-exterior.jpg",
  "facility-13-ensuite-bath-balcony.jpg",
  "facility-14-community-kitchen.jpg",
  "facility-20-estate-entrance-gate.jpg",
  "facility-17-living-room-lounge.jpg",
  "facility-09-twin-bedroom-suite.jpg",
  "facility-06-guest-house-exterior.jpg",
  "facility-05-spa-bathroom-suite.jpg",
  "facility-19-outdoor-dining-deck.jpg",
  "facility-22-garden-entrance-path.jpg",
];
const galleryPhotos = galleryWheelFiles.map((f) => {
  const g = gallery.find((x) => x.file === f)!;
  return { src: galleryImg(g.file), cap: g.cap };
});
---

<Layout title={title} description={description} path="/">
  <a class="skip-link" href="#top">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">

    <SiteHeader />

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src={galleryImg("facility-16-facility-entrance-drive.jpg")} alt="Evening arrival at the Breathe Life facility entrance" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.92;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.92) 0%,rgba(22,41,61,0.78) 46%,rgba(22,41,61,0.34) 100%);"></div>
      <div id="hero-inner" style="position:relative;max-width:1514px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <h1 style="font-size:clamp(36px,4.2vw,60px);line-height:1.04;letter-spacing:-0.032em;font-weight:600;color:#FFFFFF;margin:0 0 28px;text-wrap:balance;">Addiction &amp; Mental Health Treatment in Los Angeles</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(19px,1.9vw,24px);line-height:1.45;font-weight:300;color:#E6EDF4;margin:0 0 28px;">We've built care around one fact:</p>
          <div style="display:grid;gap:16px;margin-bottom:32px;max-width:56ch;">
            {[
              { icon: "diversity_3", text: "Built for the LGBTQ+ community, staff reflect the community from leadership to techs, so clients see themselves in their care team." },
              { icon: "favorite", text: "Dedicated chemsex/sexualized drug use program, trademarked curriculum for an issue mainstream treatment ignores or mishandles." },
              { icon: "volunteer_activism", text: "Lived experience at every level, CEO and staff are in recovery themselves, built by the people who lived it." },
              { icon: "healing", text: "Trauma-focused model, treats substance use and trauma in parallel, using identity affirmation to unlock the deeper work." },
              { icon: "verified", text: "Gold Seal Joint Commission, 22-acre Laurel Canyon campus, since 2013, 4,000+ clients, premium credibility behind the mission." },
            ].map((b) => (
              <div style="display:flex;gap:14px;align-items:flex-start;">
                <span style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,0.12);margin-top:1px;">
                  <span class="msym" style="font-size:17px;color:#FFFFFF;">{msymChar(b.icon)}</span>
                </span>
                <span style="font-size:17px;line-height:1.6;color:#DCE6EF;">{b.text}</span>
              </div>
            ))}
          </div>
          <a class="cta cta--light" href={HREF} style={S.ctaWhite}>Call Now: {PH}</a>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
        </div>

        <VerifyInsuranceForm />
      </div>
    </section>

    {/* ══════════════  AS SEEN ON  ══════════════ */}
    {/* Sourced directly from the official live site's own "As Seen On" row
       (breathelifehealingcenters.com, checked 2026-09-02, per instruction:
       the client built and approved that site themselves, so it's the
       source of truth for content gaps like this one) — same 3 outlets,
       logo files downloaded to /Asset/Press/.

       Intentionally NOT linked (removed 2026-09-18, urgent fix): Elizabeth's
       rule is that these must link to the actual publication that mentions
       Breathe, never the publisher's generic homepage. No real
       Breathe-specific article URL exists yet for any of the three, so the
       logos stay plain images rather than link somewhere that violates that
       rule. Add real hrefs only once genuine per-article URLs are sourced. */}
    <section id="as-seen-on" data-screen-label="As Seen On" style="padding:44px 37px;background:#F0F5FA;border-top:1px solid #E2DED7;border-bottom:1px solid #E2DED7;">
      <div style="max-width:1100px;margin:0 auto;text-align:center;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#8A94A0;margin-bottom:26px;">As Seen On</div>
        <div style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:44px 64px;">
          <img src="/Asset/Press/good-morning-america.png" alt="Good Morning America" style="height:54px;width:auto;display:block;opacity:0.85;" />
          <img src="/Asset/Press/oprah-winfrey-show.png" alt="The Oprah Winfrey Show" style="height:58px;width:auto;display:block;opacity:0.85;" />
          <img src="/Asset/Press/today-show.png" alt="TODAY Show" style="height:56px;width:auto;display:block;opacity:0.85;" />
        </div>
      </div>
    </section>

    {/* ══════════════  FACILITY  ══════════════ */}
    <section id="photos" data-screen-label="Facility" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="display:grid;gap:14px;margin-bottom:32px;">
          <div>
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;">The setting</div>
            <h2 style="font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0;max-width:28ch;text-wrap:balance;">Our Laurel Canyon facility</h2>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0;max-width:92ch;">A private, inclusive, and comforting space to recover, residential homes set in the quiet hills of Laurel Canyon, designed with privacy above all else.</p>
        </div>
        <FacilityGallery id="facility-gallery" photos={galleryPhotos} />
      </div>
    </section>

    {/* ══════════════  BELONGING  ══════════════ */}
    <section id="community" data-screen-label="Belonging" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1024px;margin:0 auto;display:grid;grid-template-columns:minmax(340px,1.2fr) minmax(300px,1fr);gap:64px;align-items:center;">
        <div>
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;">Belonging</div>
          <h2 style="font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 0 14px;max-width:32ch;text-wrap:balance;">LGBTQIA+ Community and Belonging</h2>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.75;color:#3A444D;margin:0 0 26px;max-width:68ch;">Recovery takes enough energy without also managing how you're perceived. Whether you're out to everyone, out to no one, or still figuring it out, whether the people supporting you are the family you were born into or the one you chose, nothing about who you are needs to be hidden, minimized, or explained here.</p>
          <a class="cta" href={HREF} style={`display:inline-flex;${S.ctaBlue}`}>Call Now: {PH}</a>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          {[
            ["facility-15-pool-deck-canyon-view.jpg", "Pool Deck"],
            ["facility-22-garden-entrance-path.jpg", "Garden Entrance Path"],
            ["facility-20-estate-entrance-gate.jpg", "Estate Entrance Gate"],
            ["facility-12-residence-exterior.jpg", "Residence Exterior"],
          ].map(([f, c]) => (
            <figure style="margin:0;position:relative;border-radius:12px;overflow:hidden;">
              <img src={galleryImg(f)} alt={c} loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;display:block;border-radius:12px;" />
              <figcaption style="position:absolute;left:0;right:0;bottom:0;background:linear-gradient(0deg,rgba(22,41,61,0.86),rgba(22,41,61,0.3));backdrop-filter:blur(7px);padding:10px 12px;font-family:'Instrument Sans',sans-serif;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">{c}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT WE TREAT  ══════════════ */}
    <section id="treat" data-screen-label="What we treat" style="position:relative;padding:70px 37px;background:#FFFFFF;border-top:1px solid #E2DED7;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-140px;right:-120px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle at 32% 30%,rgba(51,103,156,0.12),rgba(71,134,148,0.05) 60%,transparent 72%);pointer-events:none;"></div>
      <div aria-hidden="true" style="position:absolute;bottom:-160px;left:-140px;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle at 60% 60%,rgba(71,134,148,0.10),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:30px;">
          <div style={S.eyebrow}>Can we help you?</div>
          <h2 style={`${S.h2}max-width:22ch;`}>What we treat</h2>
          <p style={`${S.intro}max-width:110ch;`}>Substance use, mental health, or both, treated as equally important and deeply connected. For many LGBTQIA+ people, addiction and mental health are tangled up with rejection, minority stress, or trauma. We treat the whole picture, not just the symptom.</p>
        </div>

        <div style="display:flex;justify-content:center;margin-bottom:22px;">
          <div id="treat-tabs" role="tablist" aria-label="What we treat categories" style="display:inline-flex;gap:4px;padding:5px;background:#FFFFFF;border:1px solid #E2DED7;border-radius:999px;box-shadow:0 1px 2px rgba(20,24,28,0.05);">
            <button type="button" data-treat-tab="sub" role="tab" aria-selected="true" class="treat-tab is-active">Substances</button>
            <button type="button" data-treat-tab="mh" role="tab" aria-selected="false" class="treat-tab">Mental Health</button>
          </div>
        </div>

        <div data-treat-panel="sub">
          <div style="display:flex;justify-content:flex-end;gap:10px;margin-bottom:2px;">
            <button type="button" data-scroll="sub" data-dir="-1" aria-label="Scroll left" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">‹</button>
            <button type="button" data-scroll="sub" data-dir="1" aria-label="Scroll right" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">›</button>
          </div>
          <div data-scroller="sub" class="no-scrollbar" style="display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:14px 2px 18px;">
            {substances.map(([icon, h, p, href]) => (
              <a href={href} class="treat-card" style="flex:0 0 300px;scroll-snap-align:start;background:#FFFFFF;border:1px solid rgba(51,103,156,0.22);border-radius:12px;box-shadow:0 1px 2px rgba(51,103,156,0.07),0 4px 10px rgba(51,103,156,0.07);padding:24px 22px;box-sizing:border-box;text-decoration:none;color:inherit;display:block;">
                <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                  <span class="msym" style="font-size:24px;color:#33679C;">{msymChar(icon)}</span>
                </span>
                <h3 style="font-size:18px;font-weight:600;letter-spacing:-0.012em;margin:0 0 8px;text-wrap:balance;">{h}</h3>
                <p style={`${S.card}font-size:15px;line-height:1.6;`}>{p}</p>
              </a>
            ))}
          </div>
        </div>

        <div data-treat-panel="mh" hidden>
          <div style="display:flex;justify-content:flex-end;gap:10px;margin-bottom:2px;">
            <button type="button" data-scroll="mh" data-dir="-1" aria-label="Scroll left" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">‹</button>
            <button type="button" data-scroll="mh" data-dir="1" aria-label="Scroll right" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">›</button>
          </div>
          <div data-scroller="mh" class="no-scrollbar" style="display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:14px 2px 18px;">
            {mentalHealth.map(([icon, h, p, teal, href]) => (
              <a href={href} class="treat-card" style={`flex:0 0 300px;scroll-snap-align:start;background:#FFFFFF;border:1px solid ${teal ? "rgba(71,134,148,0.42)" : "rgba(51,103,156,0.22)"};border-radius:12px;box-shadow:0 1px 2px rgba(51,103,156,0.07),0 4px 10px rgba(51,103,156,0.07);padding:24px 22px;box-sizing:border-box;text-decoration:none;color:inherit;display:block;`}>
                <span style={`display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:${teal ? "rgba(71,134,148,0.12)" : "rgba(51,103,156,0.10)"};margin-bottom:16px;`}>
                  <span class="msym" style={`font-size:24px;color:${teal ? "#2C5A64" : "#33679C"};`}>{msymChar(icon)}</span>
                </span>
                <h3 style="font-size:18px;font-weight:600;letter-spacing:-0.012em;margin:0 0 8px;text-wrap:balance;">{h}</h3>
                <p style={`${S.card}font-size:15px;line-height:1.6;`}>{p}</p>
              </a>
            ))}
          </div>
        </div>

        <div style="text-align:center;margin-top:26px;">
          <a class="cta" href={HREF} style={`display:inline-block;${S.ctaBlue}`}>Get help now</a>
        </div>
      </div>
    </section>

    {/* ══════════════  LEVELS OF CARE  ══════════════ */}
    <section id="levels" data-screen-label="Levels of care" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Your path to recovery</div>
          <h2 style={`${S.h2}max-width:30ch;`}>Levels of Care &amp; Therapies</h2>
          <p style={`${S.intro}max-width:84ch;`}>Recovery isn't one-size-fits-all. We move with you through as many levels of care as you need.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:48px;align-items:start;">
          <img src={galleryImg("facility-22-garden-entrance-path.jpg")} alt="Garden entrance path at Breathe Life Healing Centers" loading="lazy" style="width:100%;height:100%;min-height:440px;object-fit:cover;display:block;border-radius:12px;" />
          <div style="display:grid;gap:0;">
            {levels.map((l, i) => (
              <div style={i === 0
                ? "background:#FFFFFF;border-left:2px solid #478694;padding:20px 22px;margin-bottom:16px;"
                : `border-top:1px solid #E2DED7;${i === levels.length - 1 ? "border-bottom:1px solid #E2DED7;margin-bottom:28px;" : ""}padding:22px 0;`}>
                <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:12px;margin-bottom:10px;">
                  <h3 style={`font-size:${i === 0 ? "22px" : "19px"};font-weight:600;letter-spacing:-0.018em;margin:0;text-wrap:balance;`}>{l.title}</h3>
                  {"flag" in l && l.flag && <span style="font-family:'Instrument Sans',sans-serif;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:#FFFFFF;background:#2C5A64;padding:5px 9px;">{l.flag}</span>}
                </div>
                <p style={`${S.card}margin:0 0 10px;`}>{l.text}</p>
                <a href={l.href} style="font-family:'Instrument Sans',sans-serif;font-size:14px;font-weight:600;color:#33679C;display:inline-flex;align-items:center;gap:6px;">{levelsCta[l.href] ?? "Learn more"} <span aria-hidden="true">→</span></a>
              </div>
            ))}
            <a class="cta" href={HREF} style={`align-self:start;justify-self:start;${S.ctaBlue}`}>Find the right program for you</a>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  SIGNATURE SERVICES  ══════════════ */}
    <section id="signature" data-screen-label="Signature services" style="padding:70px 37px;background:#16293D;color:#F7F5F1;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
