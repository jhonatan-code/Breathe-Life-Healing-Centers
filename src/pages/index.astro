            <a href={`/about/our-team/${p.slug}/`} class="team-card" style="position:relative;display:block;border-radius:14px;overflow:hidden;aspect-ratio:3/4;box-shadow:0 1px 2px rgba(20,24,28,0.08),0 10px 24px rgba(20,24,28,0.10);">
              <img src={p.photo} alt={p.name} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 14%;display:block;" />
