---
import { msymChar } from "../lib/icons";
import Layout from "../layouts/Layout.astro";
import Schema from "../components/Schema.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ContactLauncher from "../components/ContactLauncher.astro";
import SiteReviews from "../components/SiteReviews.astro";
import InsuranceSplit from "../components/InsuranceSplit.astro";
import SiteLocation from "../components/SiteLocation.astro";
import SiteFAQ from "../components/SiteFAQ.astro";
import SiteFinalCTA from "../components/SiteFinalCTA.astro";
import ClinicalPlaceholder from "../components/ClinicalPlaceholder.astro";
import ScrollActivateSteps from "../components/ScrollActivateSteps.astro";
import CareDial from "../components/CareDial.astro";
import FacilityGallery from "../components/FacilityGallery.astro";
import { site } from "../config/site";
import {
  gallery, galleryImg, substances, mentalHealth, levels, signature,
  why, team, steps, faqGroups,
} from "../data/home";

const PH = site.phoneDisplay;              // (877) 239-8684  — brief; design showed (877) 516-2604
const HREF = site.phoneHref;               // tel:+18772398684

const title = "LGBTQ+ Addiction & Mental Health Treatment in Los Angeles | Breathe";
const description =
  "LGBTQIA+-affirming addiction, detox and mental health treatment in Los Angeles, residential, PHP and IOP. In-network with most major insurers. Call 24/7.";

// shared inline style fragments (kept identical to the design)
const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};

// "Why Breathe" Care Dial — labels/highlights are short restatements of the
// approved `why` copy above (same source every other page's why-grid uses),
// not new claims; kept local to the homepage since no other page uses the
// dial layout.
const whyLabels: [string, string][] = [
  ["LGBTQIA+", "Affirming"],
  ["Dual", "Diagnosis"],
  ["Chemsex", "Treatment"],
  ["Trauma", "Informed"],
  ["Residential", "Care"],
  ["Protected", "Privacy"],
  ["Chosen", "Family"],
  ["Lived", "Experience"],
];
const whyHighlights: string[][] = [
  ["Minority-stress-informed clinicians", "Pronouns respected, never re-explained", "Affirming care at every level, not a single track"],
  ["One coordinated care team, not two", "Anxiety, depression & trauma treated alongside substance use", "Integrated, not sequential, treatment"],
  ["One of few U.S. programs to address this directly", "Substance use and sexualized drug use treated together", "Clinically distinct from sex-addiction models"],
  ["Pacing and safety built in, not assumed", "Care shaped around how trauma actually presents", "Foundation for healing that lasts"],
  ["Private, inclusive campus in Laurel Canyon", "A place to live, not just a bed and a schedule", "Whole-person focus, not symptom management"],
  ["Confidentiality built into daily operations", "You decide who knows you're here", "Discretion at every touchpoint"],
  ["Family therapy included, in person or online", "An in-person 3-Day Family Workshop", "Room for chosen family, not just family of origin"],
  ["Personal recovery experience, front desk to leadership", "Treated by people who've been there", "Lived experience woven through the whole team"],
];
const whyPillars = why.map(([icon, , title, desc], i) => ({
  icon,
  label: whyLabels[i],
  title,
  desc,
  highlights: whyHighlights[i],
}));

// Facility gallery wheel — a fixed 13-photo curated set (not the full 22;
// the rest live elsewhere on the page per user direction 2026-09-10), used
// consistently by the wheel, the mobile strip, and the lightbox. Card
// count keeps the ring overlapping properly at the wheel's fixed 520px
// size (user call 2026-09-10) — thumbnail size stays fixed, so ring size
// is tuned via count, not card dimensions. Great Room removed per user
// call 2026-09-10.

// Per-card anchor text for the "Levels of Care & Therapies" section below,
// replacing generic "Learn more" (Elizabeth, 2026-09-18). Keyed by href
// rather than added to the shared `levels` array in data/home.ts, since
// that array also feeds /programs/ and each level's own detail page --
// this wording is specific to this homepage section only.
const levelsCta: Record<string, string> = {
  "/programs/residential-treatment/": "Explore Our Residential Treatment Program",
  "/programs/medical-detox/": "Is Medical Detox Right for You? Learn More",
  "/programs/php/": "Learn About Our PHP Day Treatment Program",
  "/programs/intensive-outpatient/": "Explore Intensive Outpatient Treatment (IOP)",
  "/programs/sober-living/": "Learn About Transitional & Sober Living",
  "/programs/outpatient-rehab/": "Explore Our Outpatient Program",
};

const galleryWheelFiles = [
  "facility-07-pool-waterfall-grotto.jpg",
  "facility-10-fitness-center.jpg",
  "facility-11-clinical-building-exterior.jpg",
  "facility-12-residence-exterior.jpg",
  "facility-13-ensuite-bath-balcony.jpg",
  "facility-14-community-kitchen.jpg",
  "facility-15-pool-deck-canyon-view.jpg",
  "facility-17-living-room-lounge.jpg",
  "facility-09-twin-bedroom-suite.jpg",
  "facility-06-guest-house-exterior.jpg",
  "facility-05-spa-bathroom-suite.jpg",
  "facility-19-outdoor-dining-deck.jpg",
  "facility-22-garden-entrance-path.jpg",
];
// Hero accreditation logos (under the CTAs, no heading): same seals, alt text
// and verification links as the footer. [src, alt, sized by "h"eight or
// "w"idth, px, href?, tone]. The three round/badge seals keep their original
// colors and share one height (55px); DHCS and NAATP are white, sized by
// width (2026-10-05). Tone "solid" turns a flat color logo into a pure white
// silhouette via CSS; "asis" shows the file as it is.
const seals: [string, string, "h" | "w", number, string | undefined, "solid" | "asis"][] = [
  ["/Asset/Accreditations/The%20Joint%20Commission.svg", "The Joint Commission National Quality Approval Gold Seal", "h", 55, "https://www.jointcommission.org/en-us/accreditation/behavioral-health-care-and-human-services/provider-locator/566970/589068", "asis"],
  ["/Asset/Accreditations/Legit.svg", "LegitScript Certified", "h", 55, "https://www.legitscript.com/websites/?checker_keywords=breathelifehealingcenters.com", "asis"],
  ["/Asset/Accreditations/DHCS.svg", "Licensed by the California Department of Health Care Services", "w", 102, "https://www.dhcs.ca.gov/provgovpart/Pages/Licensing_and_Certification_Division.aspx", "solid"],
  ["/Asset/Accreditations/NAATP-white.svg", "NAATP Member", "w", 157, "https://www.naatp.org/resources/addiction-industry-directory/101/breathe-life-healing-centers", "asis"],
  ["/Asset/Accreditations/Fair%20Care.svg", "Fair Care Promise", "h", 55, undefined, "asis"],
];

const galleryPhotos = galleryWheelFiles.map((f) => {
  const g = gallery.find((x) => x.file === f)!;
  return { src: galleryImg(g.file), cap: g.cap };
});
---

<Layout title={title} description={description} path="/">
  <a class="skip-link" href="#top">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">

    <SiteHeader />

    {/* ══════════════  HERO  ══════════════ */}
    {/* Hero test 2026-10-03 (option B2 from the hero proposals canvas):
       centered panorama with no form. The admissions form moved into the
       floating ContactLauncher (bottom-right); "Verify Your Insurance"
       scrolls to the insurance split section, which carries its own form. */}
    {/* .hero-fold: on desktop the hero (with its accreditation logos) plus
       the As Seen On strip fill exactly one screen below the sticky header,
       so nothing shows half-cut at the fold (2026-10-05). Sizing lives in
       global.css. */}
    <div class="hero-fold">
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#0A141D;display:flex;">
      <img src={galleryImg("facility-07-pool-waterfall-grotto.jpg")} alt="Pool and waterfall grotto at the Breathe Life facility" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,9,16,0.60) 0%,rgba(4,9,16,0.46) 50%,rgba(4,9,16,0.72) 100%);"></div>
      <div class="hero-b" style="position:relative;width:100%;max-width:1440px;margin:0 auto;padding:clamp(24px,5vh,110px) 37px;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;">
        <div style="margin:auto 0;display:flex;flex-direction:column;align-items:center;gap:clamp(10px,2vh,26px);text-align:center;">
          <div style="font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#C8DAE9;">LGBTQ+ Affirming, Inclusive of All</div>
          <h1 style="font-size:clamp(34px,min(4.9vw,6.4vh),70px);line-height:1.02;letter-spacing:-0.034em;font-weight:600;color:#FFFFFF;margin:0;max-width:980px;text-wrap:balance;text-shadow:0 1px 3px rgba(0,0,0,0.35);">Addiction &amp; Mental Health Treatment in Los Angeles</h1>
          <ul class="hero-chips" style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:12px;">
            {[
              // Order per the homepage design review (client recap): clinical /
              // dual-diagnosis expertise leads, LGBTQIA+ focus second.
              "Expert trauma-focused care for dual-diagnosis",
              "LGBTQIA+ focus for those that need it, at every level of care",
              "Gold Seal accredited campus in Laurel Canyon since 2013",
            ].map((t) => (
              <li style="display:flex;gap:10px;align-items:center;min-height:44px;padding:8px 18px 8px 12px;box-sizing:border-box;border-radius:999px;background:linear-gradient(135deg,rgba(50,103,156,0.55) 0%,rgba(22,41,61,0.55) 100%);border:1px solid rgba(200,218,233,0.40);-webkit-backdrop-filter:blur(12px) saturate(140%);backdrop-filter:blur(12px) saturate(140%);box-shadow:inset 0 1px 0 rgba(255,255,255,0.18),0 4px 14px rgba(4,9,16,0.20);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto;"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg>
                <span style="font-size:16px;line-height:1.35;font-weight:600;color:#FFFFFF;text-align:left;">{t}</span>
              </li>
            ))}
          </ul>
          <div class="hero-ctas" style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:8px;">
            <a class="cta" href={HREF} style={`${S.ctaBlue}height:54px;padding:0 30px;font-size:17px;font-weight:600;gap:10px;`}>
              <span class="msym" style="font-size:20px;">{msymChar("call")}</span>Call Now: {PH}
            </a>
            <a class="cta cta--light" href="#insurance" style={`${S.ctaWhite}height:54px;padding:0 28px;font-size:17px;font-weight:600;`}>Verify Your Insurance</a>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#DCE6EF;margin:0;">Call 24/7 and talk to a real person, no pressure, no obligation.</p>
          <ul class="hero-seals" style="list-style:none;margin:clamp(6px,1.6vh,18px) 0 0;padding:0;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:20px clamp(28px,3.6vw,52px);">
            {seals.map(([src, alt, dim, px, href, tone]) => {
              const sizeStyle = dim === "h" ? `height:${px}px;width:auto;display:block;` : `width:${px}px;height:auto;display:block;`;
              const img = <img src={src} alt={alt} class={`seal seal--${tone}`} style={sizeStyle} />;
              // mobile (global.css): round badges on row 1, the two wide marks on row 2
              return <li class={`seal-li seal-li--${dim === "h" ? "round" : "wide"}`}>{href ? <a href={href} target="_blank" rel="noopener noreferrer" aria-label={alt} style="display:block;">{img}</a> : img}</li>;
            })}
          </ul>
        </div>
      </div>
    </section>

    {/* ══════════════  AS SEEN ON  ══════════════ */}
    {/* Updated 2026-09-18: auto-scrolling marquee (pause on hover/focus,
       same pattern as the insurance and signature marquees) of all 11
       pressRefs entries from resources/media.astro, Addicted to Food
       through Brad Lamm in the Media. Only the entries that carry a real
       per-article href are wrapped as links (Elizabeth's rule: must link to
       the actual publication that mentions Breathe, never a generic
       homepage) - the rest render as plain, unlinked logos.
       Moved below the Facility gallery per client feedback 2026-09-21, then
       up to the second section, right below the hero (2026-10-05). */}
    <section id="as-seen-on" data-screen-label="As Seen On" style="padding:clamp(22px,3.4vh,44px) 37px;background:#F0F5FA;border-top:1px solid #C8DAE9;border-bottom:1px solid #C8DAE9;">
      <div style="max-width:1440px;margin:0 auto;text-align:center;">
        <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#8A94A0;margin-bottom:clamp(10px,2vh,26px);">As Seen On</div>
        <div id="asn-wrap">
          <div id="asn-track" class="no-scrollbar" style="display:flex;align-items:center;overflow-x:auto;gap:40px;">
            {(() => {
              const logos: [string, string, string, string?][] = [
                ["/Asset/Press/oprah-addicted-to-food.jpg", "Addicted to Food, Oprah Winfrey Network (OWN)", "120px"],
                ["/Asset/Press/today-show-media-page.png", "The Today Show, NBC", "120px"],
                ["/Asset/Press/the-view.png", "The View, ABC", "120px"],
                ["/Asset/Press/huffington-post.jpg", "Huffington Post", "120px"],
                ["/Asset/Press/forbes.png", "Forbes", "150px", "https://www.forbes.com/sites/larrymyler/2013/11/06/3-ways-your-companys-mission-can-become-your-best-employee-engagement-tool/"],
                ["/Asset/Press/pr-newswire.png", "PR Newswire", "150px", "https://www.prnewswire.com/news-releases/breathe-life-healing-centers-expands-eating-disorder-unit-300210753.html"],
                ["/Asset/Press/voyage-la-footer.png", "Voyage LA", "150px", "https://voyagela.com/interview/meet-brad-lamm-breathe-life-healing-centers-intervention-com-west-hollywood/"],
                ["/Asset/Press/uvu-mono.svg", "Utah Valley University", "120px", "https://www.uvu.edu/news/2020/03/03102020_addiction.html"],
                ["/Asset/Press/reading-in-recovery.png", "Reading in Recovery", "150px", "https://www.youtube.com/watch?v=UtW-Oi_M65I"],
                ["/Asset/Press/recovery-unplugged.png", "Recovery Unplugged", "160px", "https://www.facebook.com/RecoveryUnplugged/videos/1366837938984354/"],
                ["/Asset/Press/brad-lamm-logo.png", "Brad Lamm in the Media", "150px", "https://bradlamm.com/brad-lamm-news/"],
              ];
              return [...logos, ...logos, ...logos, ...logos].map(([src, alt, maxW, href], k) => {
                const img = <img src={src} alt={alt} loading="lazy" class="asn-logo" style={`height:clamp(30px,4.2vh,44px);max-width:${maxW};width:auto;object-fit:contain;display:block;opacity:0.85;border-radius:6px;`} />;
                return (
                  <div aria-hidden={k >= logos.length ? "true" : undefined} style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;padding:0 28px;box-sizing:border-box;">
                    {href ? (
                      <a href={href} target="_blank" rel="noopener noreferrer" tabindex={k >= logos.length ? -1 : 0} style="display:block;line-height:0;">{img}</a>
                    ) : img}
                  </div>
                );
              });
            })()}
          </div>
        </div>
      </div>
    </section>
    </div>

    {/* Client feedback 2026-09-21: insurance + reviews moved from near the
       page bottom to directly below the hero, so trust signals land before
       a visitor has to scroll far. */}
    <InsuranceSplit intro="Our admissions team works directly with your insurance company to explain exactly what's covered before you commit to anything, no surprises." />

    {/* ══════════════  FACILITY  ══════════════ */}
    <section id="photos" data-screen-label="Facility" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="display:grid;gap:14px;margin-bottom:32px;">
          <div>
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;">The setting</div>
            <h2 style="font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0;max-width:28ch;text-wrap:balance;">Our Laurel Canyon facility</h2>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0;max-width:92ch;">A private, inclusive, and comforting space to recover, residential homes set in the quiet hills of Laurel Canyon, designed with privacy above all else.</p>
        </div>
        <FacilityGallery id="facility-gallery" photos={galleryPhotos} />
      </div>
    </section>

    {/* ══════════════  BELONGING  ══════════════ */}
    <section id="community" data-screen-label="Belonging" style="padding:70px 37px;background:#F7F5F1;">
      {/* 4-photo grid removed per the homepage design review (client recap): text-only, centered. */}
      <div style="max-width:820px;margin:0 auto;text-align:center;">
        <div>
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;">Belonging</div>
          <h2 style="font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;max-width:32ch;text-wrap:balance;">Belonging for Underserved Communities</h2>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.75;color:#3A444D;margin:0 auto 26px;max-width:68ch;">Recovery takes enough energy without also managing how you're perceived. Breathe is a place of belonging for communities too often underserved by traditional treatment, with specific expertise and cultural competency in serving the LGBTQ+ community. Whether you're out to everyone, out to no one, or still figuring it out, whether the people supporting you are the family you were born into or the one you chose, nothing about who you are needs to be hidden, minimized, or explained here.</p>
          <a class="cta" href={HREF} style={`display:inline-flex;${S.ctaBlue}`}>Call Now: {PH}</a>
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT WE TREAT  ══════════════ */}
    <section id="treat" data-screen-label="What we treat" style="position:relative;padding:70px 37px;background:#FFFFFF;border-top:1px solid #E2DED7;overflow:hidden;">
      <div aria-hidden="true" style="position:absolute;top:-140px;right:-120px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle at 32% 30%,rgba(51,103,156,0.12),rgba(71,134,148,0.05) 60%,transparent 72%);pointer-events:none;"></div>
      <div aria-hidden="true" style="position:absolute;bottom:-160px;left:-140px;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle at 60% 60%,rgba(71,134,148,0.10),transparent 70%);pointer-events:none;"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:30px;">
          <div style={S.eyebrow}>Can we help you?</div>
          <h2 style={`${S.h2}max-width:22ch;`}>What we treat</h2>
          <p style={`${S.intro}max-width:110ch;`}>Substance use, mental health, or both, treated as equally important and deeply connected. For many LGBTQIA+ people, addiction and mental health are tangled up with rejection, minority stress, or trauma. We treat the whole picture, not just the symptom.</p>
        </div>

        <div style="display:flex;justify-content:center;margin-bottom:22px;">
          <div id="treat-tabs" role="tablist" aria-label="What we treat categories" style="display:inline-flex;gap:4px;padding:5px;background:#FFFFFF;border:1px solid #E2DED7;border-radius:999px;box-shadow:0 1px 2px rgba(20,24,28,0.05);">
            <button type="button" data-treat-tab="sub" role="tab" aria-selected="true" class="treat-tab is-active">Substances</button>
            <button type="button" data-treat-tab="mh" role="tab" aria-selected="false" class="treat-tab">Mental Health</button>
          </div>
        </div>

        <div data-treat-panel="sub">
          <div style="display:flex;justify-content:flex-end;gap:10px;margin-bottom:2px;">
            <button type="button" data-scroll="sub" data-dir="-1" aria-label="Scroll left" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">‹</button>
            <button type="button" data-scroll="sub" data-dir="1" aria-label="Scroll right" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">›</button>
          </div>
          <div data-scroller="sub" class="no-scrollbar" style="display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:14px 2px 18px;">
            {substances.map(([icon, h, p, href]) => (
              <a href={href} class="treat-card" style="flex:0 0 300px;scroll-snap-align:start;background:#FFFFFF;border:1px solid rgba(51,103,156,0.22);border-radius:12px;box-shadow:0 1px 2px rgba(51,103,156,0.07),0 4px 10px rgba(51,103,156,0.07);padding:24px 22px;box-sizing:border-box;text-decoration:none;color:inherit;display:block;">
                <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                  <span class="msym" style="font-size:24px;color:#33679C;">{msymChar(icon)}</span>
                </span>
                <h3 style="font-size:18px;font-weight:600;letter-spacing:-0.012em;margin:0 0 8px;text-wrap:balance;">{h}</h3>
                <p style={`${S.card}font-size:15px;line-height:1.6;`}>{p}</p>
              </a>
            ))}
          </div>
        </div>

        <div data-treat-panel="mh" hidden>
          <div style="display:flex;justify-content:flex-end;gap:10px;margin-bottom:2px;">
