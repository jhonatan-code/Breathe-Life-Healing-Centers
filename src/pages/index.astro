---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Schema from "../components/Schema.astro";
import { site } from "../config/site";
import {
  gallery, galleryImg, substances, mentalHealth, levels, signature,
  why, team, steps, reviews, faqGroups, insurers,
} from "../data/home";

const PH = site.phoneDisplay;              // (877) 239-8684  — brief; design showed (877) 516-2604
const HREF = site.phoneHref;               // tel:+18772398684

const title = "LGBTQ+ Addiction & Mental Health Treatment in Los Angeles | Breathe";
const description =
  "LGBTQIA+-affirming addiction, detox and mental health treatment in Los Angeles — residential, PHP and IOP. In-network with most major insurers. Call 24/7.";

const socials = [
  { label: "Facebook", icon: "facebook" }, { label: "Instagram", icon: "instagram" },
  { label: "LinkedIn", icon: "linkedin" }, { label: "YouTube", icon: "youtube" },
  { label: "TikTok", icon: "tiktok" }, { label: "X", icon: "x-twitter" },
  { label: "Bluesky", icon: "bluesky" }, { label: "Pinterest", icon: "pinterest" },
];

// shared inline style fragments (kept identical to the design)
const S = {
  eyebrow: "font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;",
  h2: "font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 auto 14px;text-wrap:balance;",
  intro: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0 auto;",
  ctaBlue: "background:#33679C;color:#FFFFFF;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  ctaWhite: "background:#FFFFFF;color:#16293D;height:45px;box-sizing:border-box;padding:0 24px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);",
  card: "font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#3A444D;margin:0;",
};
---

<Layout title={title} description={description} path="/">
  <a class="skip-link" href="#top">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">

    {/* ══════════════  HEADER  ══════════════ */}
    <div class="site-hdr" style="position:sticky;top:0;z-index:50;background:#FFFFFF;border-bottom:1px solid #E2DED7;box-shadow:0 1px 3px rgba(20,24,28,0.06);">
      <div class="hdr-row" style="max-width:1440px;margin:0 auto;padding:16px 37px;display:flex;align-items:center;gap:32px;justify-content:space-between;">
        <a href="#top" class="hdr-logo" style="flex:0 0 auto;display:flex;align-items:center;">
          <img src="/Asset/Logo/Logo%20Breathe.svg" alt="Breathe Life Healing Centers" width="172" height="34" style="width:172px;height:auto;display:block;" />
        </a>
        <nav id="m-nav" class="hdr-nav" aria-label="Primary" style="display:flex;flex-wrap:wrap;gap:8px 26px;align-items:center;font-size:15px;">
          <a class="nav-link" href="#treat" style="color:#14181C;padding:4px 0;">What We Treat</a>
          <a class="nav-link" href="#levels" style="color:#14181C;padding:4px 0;">Levels of Care</a>
          <a class="nav-link" href="#team" style="color:#14181C;padding:4px 0;">Meet the Team</a>
          <a class="nav-link" href="#photos" style="color:#14181C;padding:4px 0;">Facility</a>
          <a class="nav-link" href="#community" style="color:#14181C;padding:4px 0;">Community</a>
          <a class="nav-link" href="#reviews" style="color:#14181C;padding:4px 0;">Reviews</a>
          <a class="nav-link" href="#insurance" style="color:#14181C;padding:4px 0;">Insurance</a>
          <a class="nav-link m-only-block" href={HREF} style="color:#33679C;font-weight:600;padding:4px 0;">Call 24/7: {PH}</a>
        </nav>
        <a class="cta hdr-call d-only" href={HREF} style={`flex:0 0 auto;${S.ctaBlue}`}>Call Now: {PH}</a>
        <button type="button" id="m-burger" class="hdr-burger m-only" aria-label="Menu" aria-expanded="false" aria-controls="m-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>

    <a class="m-callbar m-only" href={HREF} aria-label={`Call Breathe 24/7 at ${PH}`}>
      <Icon name="phone" size={18} /> Call 24/7 · {PH}
    </a>

    {/* ══════════════  HERO  ══════════════ */}
    <section id="top" data-screen-label="Hero" style="position:relative;overflow:hidden;background:#16293D;">
      <img src={galleryImg("facility-16-facility-entrance-drive.jpg")} alt="Evening arrival at the Breathe Life facility entrance" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.92;" />
      <div style="position:absolute;inset:0;background:linear-gradient(98deg,rgba(22,41,61,0.92) 0%,rgba(22,41,61,0.78) 46%,rgba(22,41,61,0.34) 100%);"></div>
      <div style="position:relative;max-width:1440px;margin:0 auto;padding:70px 37px;display:flex;flex-wrap:wrap;gap:50px;align-items:center;">
        <div style="flex:1 1 560px;">
          <div style="font-family:'Instrument Sans',sans-serif;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;color:#7FB3BC;margin-bottom:24px;">LGBTQIA+-Affirming Treatment Center · Laurel Canyon</div>
          <h1 style="font-size:clamp(36px,4.2vw,60px);line-height:1.04;letter-spacing:-0.032em;font-weight:600;color:#FFFFFF;margin:0 0 28px;text-wrap:balance;">LGBTQIA+-Affirming Addiction &amp; Mental Health Treatment</h1>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:clamp(19px,1.9vw,24px);line-height:1.45;font-weight:300;color:#E6EDF4;margin:0 0 28px;">We've built care around one fact:</p>
          <div style="display:grid;gap:16px;margin-bottom:32px;max-width:56ch;">
            {[
              "You shouldn't have to hide who you are, who you love, or how you identify to get well",
              "Gender-affirming care and chosen family are part of treatment, not an accommodation",
              "A clinical team that already understands the LGBTQIA+ experience instead of learning it from you",
            ].map((t) => (
              <div style="display:flex;gap:14px;align-items:flex-start;">
                <span style="flex:0 0 auto;width:24px;font-size:22px;line-height:1.2;color:#FFFFFF;">✓</span>
                <span style="font-size:17px;line-height:1.6;color:#DCE6EF;">{t}</span>
              </div>
            ))}
          </div>
          <a class="cta cta--light" href={HREF} style={S.ctaWhite}>Call Now: {PH}</a>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#C8DAE9;margin:18px 0 0;">Call 24/7 and talk to a real person — no pressure, no obligation.</p>
        </div>

        <form id="verify" data-ctm-pending style="flex:0 1 420px;background:#FFFFFF;border-radius:12px;padding:20px;width:100%;box-sizing:border-box;box-shadow:0 2px 6px rgba(0,0,0,0.18),0 20px 44px rgba(0,0,0,0.18);">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
            <img src="/Asset/Logo/HIPAA.svg" alt="HIPAA Compliant" style="height:40px;width:auto;flex:0 0 auto;display:block;" />
            <span style="font-size:23px;font-weight:600;letter-spacing:-0.02em;">Verify your insurance</span>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#3A444D;margin:0 0 18px;">Tell us a bit about your coverage and our admissions team will confirm your benefits — no obligation.</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;">
            <label style="display:block;">
              <span style="display:block;font-size:13px;color:#646D76;margin-bottom:6px;">Name</span>
              <input type="text" name="name" required placeholder="What we'll call you" style="width:100%;box-sizing:border-box;font-family:'Instrument Sans',sans-serif;font-size:15px;padding:11px 13px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#14181C;" />
            </label>
            <label style="display:block;">
              <span style="display:block;font-size:13px;color:#646D76;margin-bottom:6px;">Phone</span>
              <input type="tel" name="phone" required placeholder="(000) 000-0000" style="width:100%;box-sizing:border-box;font-family:'Instrument Sans',sans-serif;font-size:15px;padding:11px 13px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#14181C;" />
            </label>
            <label style="display:block;">
              <span style="display:block;font-size:13px;color:#646D76;margin-bottom:6px;">Email</span>
              <input type="email" name="email" required placeholder="you@example.com" style="width:100%;box-sizing:border-box;font-family:'Instrument Sans',sans-serif;font-size:15px;padding:11px 13px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#14181C;" />
            </label>
            <label style="display:block;">
              <span style="display:block;font-size:13px;color:#646D76;margin-bottom:6px;">Date of birth</span>
              <input type="date" name="dob" required style="width:100%;box-sizing:border-box;font-family:'Instrument Sans',sans-serif;font-size:15px;padding:11px 13px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#14181C;" />
            </label>
            <label style="display:block;">
              <span style="display:block;font-size:13px;color:#646D76;margin-bottom:6px;">Insurance carrier <i style="font-style:normal;color:#6B7480;">optional</i></span>
              <select name="carrier" style="width:100%;box-sizing:border-box;font-family:'Instrument Sans',sans-serif;font-size:15px;padding:11px 13px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#14181C;">
                <option>Select</option>
                <option>Aetna</option><option>Anthem</option><option>Blue Cross Blue Shield</option>
                <option>Cigna</option><option>Beacon Health Options</option><option>Carelon</option>
                <option>Other / not listed</option>
              </select>
            </label>
            <label style="display:block;">
              <span style="display:block;font-size:13px;color:#646D76;margin-bottom:6px;">Membership / policy ID <i style="font-style:normal;color:#6B7480;">optional</i></span>
              <input type="text" name="member_id" placeholder="If you have it to hand" style="width:100%;box-sizing:border-box;font-family:'Instrument Sans',sans-serif;font-size:15px;padding:11px 13px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#14181C;" />
            </label>
            <label style="grid-column:1 / -1;display:flex;gap:10px;align-items:flex-start;font-family:'Montserrat',sans-serif;font-size:13px;color:#646D76;">
              <input type="checkbox" name="sms_opt_in" value="yes" style="margin-top:2px;" />
              <span>Text me about my verification. Message and data rates may apply; reply STOP to opt out. Consent isn't a condition of treatment.</span>
            </label>
            <button type="submit" style="grid-column:1 / -1;justify-self:center;font-family:'Instrument Sans',sans-serif;background:#33679C;color:#FFFFFF;border:0;height:45px;box-sizing:border-box;padding:0 30px;font-size:15px;font-weight:500;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 1px 2px rgba(20,24,28,0.10),0 6px 16px rgba(20,24,28,0.07);cursor:pointer;" class="cta">Verify my insurance</button>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#646D76;margin:14px 0 0;text-align:center;">Or call us 24/7 at <a href={HREF} style="color:#2C5A64;font-weight:500;">{PH}</a>. Everything you share is confidential.</p>
          <p class="ivf-status" role="status" hidden style="font-family:'Montserrat',sans-serif;font-size:14px;color:#2C5A64;background:#EFF5FA;border-radius:8px;padding:10px 12px;margin:12px 0 0;"></p>
        </form>
      </div>
    </section>

    {/* ══════════════  FACILITY  ══════════════ */}
    <section id="photos" data-screen-label="Facility" style="padding:70px 37px;background:#FFFFFF;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="display:grid;gap:14px;margin-bottom:32px;">
          <div>
            <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;">The setting</div>
            <h2 style="font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0;max-width:28ch;text-wrap:balance;">Our Laurel Canyon facility</h2>
          </div>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#3A444D;margin:0;max-width:92ch;">A private, inclusive, and comforting space to recover — residential homes set in the quiet hills of Laurel Canyon, designed with privacy above all else.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;align-items:stretch;">
          <figure id="gal-main-fig" style="margin:0;height:100%;position:relative;border-radius:12px;overflow:hidden;box-shadow:0 2px 4px rgba(20,24,28,0.08),0 18px 40px rgba(20,24,28,0.10);">
            <img id="gal-main" src={galleryImg(gallery[0].file)} alt={gallery[0].cap} style="width:100%;height:100%;min-height:436px;object-fit:cover;display:block;border-radius:12px;" />
            <figcaption style="position:absolute;left:0;right:0;bottom:0;background:linear-gradient(0deg,rgba(22,41,61,0.9),rgba(22,41,61,0.4));backdrop-filter:blur(8px);padding:16px 22px;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline;justify-content:space-between;">
              <span id="gal-cap" style="font-size:22px;font-weight:600;letter-spacing:-0.016em;color:#FFFFFF;">{gallery[0].cap}</span>
              <span id="gal-count" style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#7FB3BC;">1 of {gallery.length}</span>
            </figcaption>
          </figure>
          <div>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;">
              <span style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#646D76;">Browse the campus</span>
              <span style="flex:1;height:1px;background:#E2DED7;"></span>
              <button type="button" data-gal="prev" aria-label="Previous images" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;box-shadow:0 1px 2px rgba(20,24,28,0.08);">‹</button>
              <button type="button" data-gal="next" aria-label="More images" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;box-shadow:0 1px 2px rgba(20,24,28,0.08);">›</button>
            </div>
            <div id="gal-thumbs" class="no-scrollbar" style="display:grid;grid-auto-flow:column;grid-template-rows:repeat(2,1fr);grid-auto-columns:calc(50% - 7px);gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding-bottom:8px;">
              {gallery.map((g, i) => (
                <button type="button" data-thumb={i} style="position:relative;padding:0;border:0;background:transparent;cursor:pointer;border-radius:12px;overflow:hidden;display:block;scroll-snap-align:start;box-shadow:0 1px 2px rgba(20,24,28,0.10);">
                  <img src={galleryImg(g.file)} alt={g.cap} loading="lazy" style="width:100%;height:180px;object-fit:cover;display:block;border-radius:12px;" />
                  <span style="position:absolute;left:0;right:0;bottom:0;background:linear-gradient(0deg,rgba(22,41,61,0.86),rgba(22,41,61,0.34));backdrop-filter:blur(7px);padding:10px 12px;font-family:'Instrument Sans',sans-serif;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;text-align:left;display:block;">{g.cap}</span>
                </button>
              ))}
            </div>
            <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:15px;line-height:1.7;color:#3A444D;margin:20px 0 0;">Slide through and tap any frame to bring it forward. Every photograph here is the actual campus, not a stand-in.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════  BELONGING  ══════════════ */}
    <section id="community" data-screen-label="Belonging" style="padding:70px 37px;background:#F7F5F1;">
      <div style="max-width:1080px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:64px;align-items:center;">
        <div>
          <div style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#2C5A64;margin-bottom:14px;">Belonging</div>
          <h2 style="font-size:clamp(30px,3.2vw,46px);line-height:1.08;letter-spacing:-0.028em;font-weight:600;margin:0 0 14px;max-width:26ch;text-wrap:balance;">Whoever you are, you belong here</h2>
          <p style="font-family:'Montserrat',Helvetica,sans-serif;font-size:16px;line-height:1.75;color:#3A444D;margin:0 0 26px;max-width:68ch;">Recovery takes enough energy without also managing how you're perceived. Whether you're out to everyone, out to no one, or still figuring it out — whether the people supporting you are the family you were born into or the one you chose — nothing about who you are needs to be hidden, minimized, or explained here.</p>
          <a class="cta" href={HREF} style={`display:inline-flex;${S.ctaBlue}`}>Call Now: {PH}</a>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          {[
            ["facility-15-pool-deck-canyon-view.jpg", "Pool Deck"],
            ["facility-22-garden-entrance-path.jpg", "Garden Entrance Path"],
            ["facility-20-estate-entrance-gate.jpg", "Estate Entrance Gate"],
            ["facility-12-residence-exterior.jpg", "Residence Exterior"],
          ].map(([f, c]) => (
            <figure style="margin:0;position:relative;border-radius:12px;overflow:hidden;">
              <img src={galleryImg(f)} alt={c} loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;display:block;border-radius:12px;" />
              <figcaption style="position:absolute;left:0;right:0;bottom:0;background:linear-gradient(0deg,rgba(22,41,61,0.86),rgba(22,41,61,0.3));backdrop-filter:blur(7px);padding:10px 12px;font-family:'Instrument Sans',sans-serif;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">{c}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════  WHAT WE TREAT  ══════════════ */}
    <section id="treat" data-screen-label="What we treat" style="padding:70px 37px;background:#F0F5FA;border-top:1px solid #E2DED7;">
      <div style="max-width:1440px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:32px;">
          <div style={S.eyebrow}>Can we help you?</div>
          <h2 style={`${S.h2}max-width:22ch;`}>What we treat</h2>
          <p style={`${S.intro}max-width:110ch;`}>Substance use, mental health, or both — treated as equally important and deeply connected. For many LGBTQIA+ people, addiction and mental health are tangled up with rejection, minority stress, or trauma. We treat the whole picture, not just the symptom.</p>
        </div>

        <div style="display:flex;align-items:center;gap:16px;margin-bottom:6px;">
          <span style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;">Substances</span>
          <span style="flex:1;height:1px;background:#E2DED7;"></span>
          <button type="button" data-scroll="sub" data-dir="-1" aria-label="Scroll left" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">‹</button>
          <button type="button" data-scroll="sub" data-dir="1" aria-label="Scroll right" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">›</button>
        </div>
        <div data-scroller="sub" class="no-scrollbar" style="display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:14px 2px 18px;">
          {substances.map(([icon, h, p]) => (
            <div style="flex:0 0 300px;scroll-snap-align:start;background:#FFFFFF;border:1px solid rgba(51,103,156,0.22);border-radius:12px;box-shadow:0 1px 2px rgba(51,103,156,0.07),0 4px 10px rgba(51,103,156,0.07);padding:24px 22px;box-sizing:border-box;">
              <span style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:10px;background:rgba(51,103,156,0.10);margin-bottom:16px;">
                <span class="msym" style="font-size:24px;color:#33679C;">{icon}</span>
              </span>
              <h3 style="font-size:18px;font-weight:600;letter-spacing:-0.012em;margin:0 0 8px;text-wrap:balance;">{h}</h3>
              <p style={`${S.card}font-size:15px;line-height:1.6;`}>{p}</p>
            </div>
          ))}
        </div>

        <div style="display:flex;align-items:center;gap:16px;margin:22px 0 6px;">
          <span style="font-family:'Instrument Sans',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#2C5A64;">Mental health</span>
          <span style="flex:1;height:1px;background:#E2DED7;"></span>
          <button type="button" data-scroll="mh" data-dir="-1" aria-label="Scroll left" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">‹</button>
          <button type="button" data-scroll="mh" data-dir="1" aria-label="Scroll right" class="icon-btn" style="font-family:'Instrument Sans',sans-serif;width:44px;height:44px;border:1px solid #C9D2DA;border-radius:8px;background:#FFFFFF;color:#33679C;font-size:16px;cursor:pointer;">›</button>
        </div>
