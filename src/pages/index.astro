    {/* ══════════════  FOOTER  ══════════════ */}
    <footer id="footer" data-screen-label="Footer" style="background:#0F1F2E;color:#DCE6EF;padding:44px 37px 22px;">
      <div style="max-width:1440px;margin:0 auto;">
