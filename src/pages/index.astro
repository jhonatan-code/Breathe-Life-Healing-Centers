<script>
  // ── Section reveal on scroll ──────────────────────────────────────────────
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -200px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // ── Facility gallery ─────────────────────────────────────────────────────
  (() => {
    const main = document.getElementById("gal-main") as HTMLImageElement | null;
    const cap = document.getElementById("gal-cap");
    const count = document.getElementById("gal-count");
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-thumb]"));
    const strip = document.getElementById("gal-thumbs");
    if (!main || !thumbs.length) return;
    const total = thumbs.length;
    let pick = 0;
    const set = (i: number) => {
      pick = (i + total) % total;
      const img = thumbs[pick].querySelector("img") as HTMLImageElement;
      main.src = img.src;
      main.alt = img.alt;
      if (cap) cap.textContent = img.alt;
      if (count) count.textContent = `${pick + 1} of ${total}`;
      thumbs[pick].scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
    };
    thumbs.forEach((b, i) => b.addEventListener("click", () => set(i)));
    document.querySelector('[data-gal="prev"]')?.addEventListener("click", () => {
      strip?.scrollBy({ left: -Math.max(320, (strip?.clientWidth || 0) * 0.85), behavior: "smooth" });
    });
    document.querySelector('[data-gal="next"]')?.addEventListener("click", () => {
      strip?.scrollBy({ left: Math.max(320, (strip?.clientWidth || 0) * 0.85), behavior: "smooth" });
    });
  })();

  // ── Substance / mental-health scrollers ──────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>("[data-scroll]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.getAttribute("data-scroll");
      const dir = Number(btn.getAttribute("data-dir")) || 1;
      const el = document.querySelector<HTMLElement>(`[data-scroller="${key}"]`);
      el?.scrollBy({ left: dir * Math.max(320, el.clientWidth * 0.85), behavior: "smooth" });
    });
  });

  // ── Signature marquee (auto-scroll, pause on hover/focus) ─────────────────
  (() => {
    const track = document.getElementById("sig-track");
    const wrap = document.getElementById("sig-wrap");
    if (!track || !wrap) return;
    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
    const SPEED = 0.028;
    let last = 0, pos: number | null = null, paused = false;
    wrap.addEventListener("mouseenter", () => (paused = true));
    wrap.addEventListener("mouseleave", () => (paused = false));
    wrap.addEventListener("focusin", () => (paused = true));
    wrap.addEventListener("focusout", () => (paused = false));
    const step = (t: number) => {
      const half = track.scrollWidth / 2;
      if (last && !paused && half > 0) {
        if (pos == null) pos = track.scrollLeft;
        pos += (t - last) * SPEED;
        if (pos >= half) pos -= half;
        track.scrollLeft = pos;
      }
      last = t;
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  })();

  // ── Reviews carousel (infinite, drag, keyboard, dots) ────────────────────
  (() => {
    const car = document.getElementById("rev-car");
    const track = document.getElementById("rev-track") as HTMLElement | null;
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    if (!car || !track) return;
    const total = dots.length;
    const readVisible = () => {
      const v = parseInt(getComputedStyle(car).getPropertyValue("--visible-cards"), 10);
      return Number.isFinite(v) && v > 0 ? v : 3;
    };
    let visible = readVisible();
    let idx = visible;
    let step = 0;
    const measure = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return;
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      step = first.getBoundingClientRect().width + gap;
    };
    const place = (animate: boolean) => {
      track.style.transition = animate ? "" : "none";
      track.style.transform = `translateX(${-idx * step}px)`;
      if (!animate) { void track.offsetWidth; track.style.transition = ""; }
    };
    const syncDots = () => {
      const real = ((idx - visible) % total + total) % total;
      dots.forEach((d, k) => {
        const on = k === real;
        d.setAttribute("aria-selected", String(on));
        const s = d.firstElementChild as HTMLElement;
        s.style.width = on ? "24px" : "8px";
        s.style.background = on ? "#1E2A4A" : "#B4BFD4";
      });
    };
    const go = (i: number) => { idx = i; place(true); syncDots(); };
    track.addEventListener("transitionend", () => {
      if (idx >= total + visible) { idx -= total; place(false); }
      else if (idx < visible) { idx += total; place(false); }
      syncDots();
    });
    car.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); go(idx - 1); }
      else if (e.key === "ArrowRight") { e.preventDefault(); go(idx + 1); }
    });
    document.querySelector('[data-rev="prev"]')?.addEventListener("click", () => go(idx - 1));
    document.querySelector('[data-rev="next"]')?.addEventListener("click", () => go(idx + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => go(k + visible)));

    // drag
    let drag: { x: number; dx: number } | null = null;
    track.addEventListener("pointerdown", (e) => { drag = { x: e.clientX, dx: 0 }; track.classList.add("is-dragging"); });
    track.addEventListener("pointermove", (e) => {
      if (!drag) return;
      drag.dx = e.clientX - drag.x;
      track.style.transform = `translateX(${-idx * step + drag.dx}px)`;
    });
    const end = () => {
      if (!drag) return;
      const dx = drag.dx; drag = null;
      track.classList.remove("is-dragging");
      const th = (step || 300) * 0.25;
      if (dx <= -th) go(idx + 1);
      else if (dx >= th) go(idx - 1);
      else place(true);
    };
    track.addEventListener("pointerup", end);
    track.addEventListener("pointercancel", end);
    track.addEventListener("pointerleave", end);
    track.addEventListener("dragstart", (e) => e.preventDefault());

    let rz: number;
    addEventListener("resize", () => {
      clearTimeout(rz);
      rz = window.setTimeout(() => {
        const next = readVisible();
        if (next !== visible) { idx = (((idx - visible) % total + total) % total) + next; visible = next; }
        measure(); place(false); syncDots();
      }, 150);
    });
    requestAnimationFrame(() => { measure(); place(false); syncDots(); });
  })();

  // ── Mobile nav toggle ───────────────────────────────────────────────────
  (() => {
    const burger = document.getElementById("m-burger");
    const nav = document.getElementById("m-nav");
    if (!burger || !nav) return;
    const close = () => { burger.setAttribute("aria-expanded", "false"); nav.classList.remove("is-open"); };
    burger.addEventListener("click", () => {
      const open = burger.getAttribute("aria-expanded") === "true";
      burger.setAttribute("aria-expanded", String(!open));
      nav.classList.toggle("is-open", !open);
    });
    nav.addEventListener("click", (e) => { if ((e.target as HTMLElement).tagName === "A") close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  })();

  // ── Insurance form: no verified PHI destination yet (forms-ctm.md BLOCKED) ─
  document.querySelectorAll<HTMLFormElement>("form[data-ctm-pending]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const s = form.querySelector<HTMLElement>(".ivf-status");
      if (s) {
        s.hidden = false;
        s.textContent =
          "Thanks — online verification isn't connected yet. Please call 24/7 and our admissions team will verify your benefits right away.";
      }
    });
  });
</script>
