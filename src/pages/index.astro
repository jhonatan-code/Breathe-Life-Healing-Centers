          {team.map((p) => (
            <a href={`/about/our-team/${p.slug}/`} class="team-card" style="position:relative;display:block;border-radius:14px;overflow:hidden;aspect-ratio:3/4;box-shadow:0 1px 2px rgba(20,24,28,0.08),0 10px 24px rgba(20,24,28,0.10);">
              <img src={p.photo} alt={p.name} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 14%;display:block;" />
              <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(22,41,61,0) 38%,rgba(22,41,61,0.55) 68%,rgba(22,41,61,0.94) 100%);"></div>
              <span style="position:absolute;top:16px;right:16px;font-family:'Instrument Sans',sans-serif;font-size:10px;letter-spacing:0.14em;background:#FFFFFF;color:#2C5A64;padding:6px 10px;border-radius:4px;">{p.badge}</span>
              <div style="position:absolute;left:0;right:0;bottom:0;padding:24px 26px;">
