<script>
  // ── Section reveal on scroll ──────────────────────────────────────────────
  // #admissions ("Four simple steps") is excluded — it has its own
  // scroll-driven number/line color effect and doesn't need the generic
  // section-level fade-in on top of that. #as-seen-on is excluded too: it
  // shares the first screen with the hero (.hero-fold) and must appear with
  // it, not fade in after. rootMargin's bottom offset went
  // from -200px to -50px (150px less restrictive) so every other
  // section's fade-in fires while it's still 150px further down the
  // screen than before — sooner, not slower: the transition itself is
  // still the unchanged 700ms defined on .blhc-reveal in global.css, only
  // the trigger point moved.
  (() => {
    const targets = Array.from(document.querySelectorAll<HTMLElement>("section:not(#top):not(#as-seen-on):not(#admissions), footer"));
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    let lastY = window.scrollY || 0;
    targets.forEach((el) => el.classList.add("blhc-reveal"));
    const io = new IntersectionObserver((entries) => {
      const y = window.scrollY || 0;
      const down = y >= lastY;
      lastY = y;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (down || e.boundingClientRect.top < innerHeight * 0.5) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: "0px 0px -50px 0px", threshold: 0 });
    targets.forEach((el) => io.observe(el));
  })();

  // ── Substance / mental-health scrollers ──────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>("[data-scroll]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.getAttribute("data-scroll");
      const dir = Number(btn.getAttribute("data-dir")) || 1;
      const el = document.querySelector<HTMLElement>(`[data-scroller="${key}"]`);
      el?.scrollBy({ left: dir * Math.max(320, el.clientWidth * 0.85), behavior: "smooth" });
    });
  });

  // ── "What we treat" category switcher ─────────────────────────────────────
  (() => {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-treat-tab]"));
    if (!tabs.length) return;
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.getAttribute("data-treat-tab");
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", String(on));
        });
        document.querySelectorAll<HTMLElement>("[data-treat-panel]").forEach((panel) => {
          panel.hidden = panel.getAttribute("data-treat-panel") !== key;
        });
      });
    });
  })();

  // ── Signature marquee (auto-scroll, pause on hover/focus) ─────────────────
  (() => {
    const track = document.getElementById("sig-track");
    const wrap = document.getElementById("sig-wrap");
    if (!track || !wrap) return;
    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
    const SPEED = 0.028;
    let last = 0, pos: number | null = null, paused = false;
    wrap.addEventListener("mouseenter", () => (paused = true));
    wrap.addEventListener("mouseleave", () => (paused = false));
    wrap.addEventListener("focusin", () => (paused = true));
    wrap.addEventListener("focusout", () => (paused = false));
    const step = (t: number) => {
      const half = track.scrollWidth / 2;
      if (last && !paused && half > 0) {
        if (pos == null) pos = track.scrollLeft;
        pos += (t - last) * SPEED;
        if (pos >= half) pos -= half;
        track.scrollLeft = pos;
      }
      last = t;
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  })();

  // ── As Seen On marquee (auto-scroll, pause on hover/focus) ────────────────
  (() => {
    const track = document.getElementById("asn-track");
    const wrap = document.getElementById("asn-wrap");
    if (!track || !wrap) return;
    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
    const SPEED = 0.028;
    let last = 0, pos: number | null = null, paused = false;
    wrap.addEventListener("mouseenter", () => (paused = true));
    wrap.addEventListener("mouseleave", () => (paused = false));
    wrap.addEventListener("focusin", () => (paused = true));
    wrap.addEventListener("focusout", () => (paused = false));
    const step = (t: number) => {
      const half = track.scrollWidth / 2;
      if (last && !paused && half > 0) {
        if (pos == null) pos = track.scrollLeft;
        pos += (t - last) * SPEED;
        if (pos >= half) pos -= half;
        track.scrollLeft = pos;
      }
      last = t;
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  })();

  // Mobile nav toggle lives in SiteHeader.astro; verify-form submit
  // handling lives in VerifyInsuranceForm.astro (rendered here inside
  // ContactLauncher); the insurance
  // section lives in InsuranceSplit.astro; the reviews carousel lives in
  // SiteReviews.astro; the "Four simple steps" scroll-activate effect
  // lives in ScrollActivateSteps.astro (shared with the Careers page's
  // "How to Apply") — all shared across every page that uses them.
</script>
