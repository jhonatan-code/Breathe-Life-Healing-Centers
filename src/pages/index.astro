---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import InsuranceForm from "../components/InsuranceForm.astro";
import Schema from "../components/Schema.astro";
import { site } from "../config/site";
import {
  hero, trust, belonging, facility, whatWeTreat, levels, signature,
  why, team, steps, reviews, insurance, location, faq, finalCta,
} from "../data/home";

const title = "LGBTQ+ Addiction & Mental Health Treatment in Los Angeles | Breathe";
const description =
  "LGBTQ+-affirming residential, detox, PHP and IOP treatment in Los Angeles. Built by people in recovery, for the LGBTQ+ community first. In-network with most major insurers. Call 24/7.";
---

<Layout title={title} description={description} path="/">
  <Header />

  <main id="main">
    <!-- ─────────────  HERO  ───────────── -->
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">{hero.eyebrow}</p>
          <h1>{hero.h1}</h1>
          <p class="hero__sub">{hero.sub}</p>
          <ul class="hero__points">
            {hero.points.map((p) => (
              <li><Icon name="check" size={20} /> <span>{p}</span></li>
            ))}
          </ul>
          <div class="hero__cta">
            <Button href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
            <a class="hero__call" href={site.phoneHref}>
              <Icon name="phone" size={18} /> Call 24/7 · {site.phoneDisplay}
            </a>
          </div>
        </div>

        <div class="hero__form" id="verify">
          <h2 class="hero__form-title">Verify your insurance</h2>
          <p class="hero__form-sub">
            Tell us a bit about your coverage and our admissions team will confirm
            your benefits — no obligation.
          </p>
          <InsuranceForm />
        </div>
      </div>
    </section>

    <!-- ─────────────  TRUST BAR  ───────────── -->
    <section class="trustbar" aria-label="Accreditation and insurance">
      <div class="container trustbar__inner">
        <p class="trustbar__label">In-network with most major insurers</p>
        <ul class="trustbar__logos">
          {trust.insurers.map((i) => (
            <li><img src={i.src} alt={i.name} loading="lazy" /></li>
          ))}
        </ul>
        <p class="trustbar__accred">
          Joint Commission Gold Seal · LegitScript Certified · Licensed by the California DHCS
        </p>
      </div>
    </section>

    <!-- ─────────────  FACILITY  ───────────── -->
    <section class="section facility reveal-on-scroll">
      <div class="container">
        <p class="eyebrow">{facility.eyebrow}</p>
        <h2>{facility.h2}</h2>
        <p class="lead">{facility.body}</p>
        <div class="facility__grid">
          {facility.photos.map((p, i) => (
            <figure class:list={["facility__ph", i === 0 && "facility__ph--lead"]}>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ─────────────  BELONGING  ───────────── -->
    <section class="section belonging reveal-on-scroll">
      <div class="container belonging__inner">
        <p class="eyebrow">{belonging.eyebrow}</p>
        <h2>{belonging.h2}</h2>
        {belonging.body.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- ─────────────  WHAT WE TREAT  ───────────── -->
    <section class="section treat reveal-on-scroll">
      <div class="container">
        <p class="eyebrow">{whatWeTreat.eyebrow}</p>
        <h2>{whatWeTreat.h2}</h2>
        <p class="lead">{whatWeTreat.body}</p>
        <div class="treat__cols">
          <div>
            <h3 class="treat__h3">Substances</h3>
            <ul class="chips">
              {whatWeTreat.substances.map((s) => (
                <li><a href={s.href}>{s.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="treat__h3">Mental health</h3>
            <ul class="chips">
              {whatWeTreat.conditions.map((c) => (
                <li><a href={c.href}>{c.label}</a></li>
              ))}
            </ul>
            <p class="treat__note">
              {whatWeTreat.conditions.find((c) => c.note)?.note}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────  LEVELS OF CARE  ───────────── -->
    <section class="section levels reveal-on-scroll">
      <div class="container">
        <p class="eyebrow">{levels.eyebrow}</p>
        <h2>{levels.h2}</h2>
        <p class="lead">{levels.body}</p>
        <div class="card-grid">
          {levels.cards.map((c) => (
            <article class="card">
              {c.flag && <span class="card__flag">{c.flag}</span>}
              <h3><a href={c.href}>{c.title}</a></h3>
              <p>{c.text}</p>
              <a class="card__link" href={c.href}>Learn more <Icon name="arrowRight" size={15} /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─────────────  SIGNATURE SERVICES  ───────────── -->
    <section class="section signature on-ink reveal-on-scroll">
      <div class="container">
        <p class="eyebrow eyebrow--ink">{signature.eyebrow}</p>
        <h2>{signature.h2}</h2>
        <p class="lead lead--ink">{signature.body}</p>
        <div class="sig-grid">
          {signature.cards.map((c) => (
            <article class="sig">
              <h3><a href={c.href}>{c.title}</a></h3>
              <p>{c.text}</p>
              <a class="sig__link" href={c.href}>Explore <Icon name="arrowRight" size={15} /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─────────────  WHY BREATHE  ───────────── -->
    <section class="section why reveal-on-scroll">
      <div class="container">
        <p class="eyebrow">{why.eyebrow}</p>
        <h2>{why.h2}</h2>
        <div class="why-grid">
          {why.items.map((it) => (
            <article class="why__item">
              <span class="why__icon"><Icon name={it.icon} size={22} /></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─────────────  TEAM  ───────────── -->
    <section class="section team reveal-on-scroll">
      <div class="container team__inner">
        <div>
          <p class="eyebrow">{team.eyebrow}</p>
          <h2>{team.h2}</h2>
          <p class="lead">{team.body}</p>
          <Button href={team.fullTeamHref} variant="secondary">Meet the full team</Button>
        </div>
        <ul class="team__list">
          {team.people.map((p) => (
            <li class="person">
              <img src={p.photo} alt={`${p.name}, ${p.role}`} loading="lazy" width="96" height="96" />
              <div>
                <p class="person__name">{p.name} <span>{p.credential}</span></p>
                <p class="person__role">{p.role}</p>
                <p class="person__bio">{p.bio}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ─────────────  FOUR STEPS  ───────────── -->
    <section class="section steps reveal-on-scroll">
      <div class="container">
        <p class="eyebrow">{steps.eyebrow}</p>
        <h2>{steps.h2}</h2>
        <ol class="steps__list">
          {steps.items.map((s) => (
            <li>
              <span class="steps__n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─────────────  REVIEWS  ───────────── -->
    <section class="section reviews reveal-on-scroll">
      <div class="container">
        <div class="reviews__head">
          <div>
            <p class="eyebrow">{reviews.eyebrow}</p>
            <h2>{reviews.h2}</h2>
          </div>
          <p class="reviews__rating">
            <span class="reviews__stars" aria-hidden="true">
              <Icon name="star" size={18} /><Icon name="star" size={18} /><Icon name="star" size={18} /><Icon name="star" size={18} /><Icon name="star" size={18} />
            </span>
            <span>{site.google.rating.toFixed(1)} average · {site.google.count} Google reviews</span>
          </p>
        </div>
        <ul class="reviews__grid">
          {reviews.items.map((r) => (
            <li class="review">
              <span class="review__stars" aria-label="5 out of 5 stars">
                <Icon name="star" size={15} /><Icon name="star" size={15} /><Icon name="star" size={15} /><Icon name="star" size={15} /><Icon name="star" size={15} />
              </span>
              <blockquote>{r.quote}</blockquote>
              <cite>{r.name}{r.detail ? <span> · {r.detail}</span> : null}</cite>
            </li>
          ))}
        </ul>
        <p class="reviews__disclaimer">{reviews.disclaimer}</p>
        <a class="card__link" href={reviews.moreHref}>Read more reviews <Icon name="arrowRight" size={15} /></a>
      </div>
    </section>

    <!-- ─────────────  INSURANCE  ───────────── -->
    <section class="section insurance-band reveal-on-scroll">
      <div class="container insurance-band__inner">
        <div>
          <p class="eyebrow">{insurance.eyebrow}</p>
          <h2>{insurance.h2}</h2>
          <p class="lead">{insurance.body}</p>
          <p class="insurance-band__exclusion">{insurance.exclusion}</p>
          <Button href={insurance.cta.href}>{insurance.cta.label}</Button>
        </div>
        <ul class="insurance-band__logos">
          {trust.insurers.map((i) => (
            <li><img src={i.src} alt={i.name} loading="lazy" /></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ─────────────  LOCATION  ───────────── -->
    <section class="section location reveal-on-scroll">
      <div class="container">
        <p class="eyebrow">{location.eyebrow}</p>
        <h2>{location.h2}</h2>
        <p class="lead">{location.body}</p>
        <div class="location__grid">
          <div class="location__card">
            <h3><Icon name="mapPin" size={18} /> {location.office.label}</h3>
            {location.office.lines.map((l) => <p>{l}</p>)}
          </div>
          <div class="location__card">
            <h3><Icon name="lock" size={18} /> Residential campus</h3>
            <p>{location.campusNote}</p>
          </div>
          <div class="location__card">
            <h3><Icon name="plane" size={18} /> Arriving from out of state</h3>
            <p>{location.travelNote}</p>
          </div>
        </div>
        <p class="location__areas">
          Serving clients from {location.areasServed.join(", ")} and greater Los Angeles.
        </p>
      </div>
    </section>

    <!-- ─────────────  FAQ  ───────────── -->
    <section class="section faq reveal-on-scroll">
      <div class="container">
        <p class="eyebrow">{faq.eyebrow}</p>
        <h2>{faq.h2}</h2>
        <div class="faq__groups">
          {faq.groups.map((g) => (
            <div class="faq__group">
              <h3 class="faq__gh">{g.heading}</h3>
              <dl>
                {g.items.map((it) => (
                  <div class="faq__qa">
                    <dt>{it.q}</dt>
                    <dd>{it.a}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─────────────  FINAL CTA  ───────────── -->
    <section class="final-cta on-ink">
      <div class="container final-cta__inner">
        <h2>{finalCta.h2}</h2>
        <p>{finalCta.body}</p>
        <div class="final-cta__actions">
          <Button href={site.phoneHref}>
            <Icon name="phone" size={18} /> Call 24/7 · {site.phoneDisplay}
          </Button>
          <Button href="/contact-us/" variant="secondary">Send us a message</Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Schema />
</Layout>

<style>
  /* Keep clear of the persistent mobile contact bar (navigation.md §2) */
  @media (max-width: 767px) {
    #main { padding-bottom: 4rem; }
  }

  h2 { font-size: var(--text-3xl); margin-top: var(--space-3); }
  h3 { font-size: var(--text-lg); }
  .lead { font-size: var(--text-lg); color: var(--color-text-muted); max-width: 62ch; margin-top: var(--space-4); }
  .lead--ink { color: var(--color-on-ink-muted); }
  .eyebrow--ink { color: var(--color-on-ink-muted); }
  .on-ink { background: var(--color-surface-ink); color: var(--color-on-ink); }
  .on-ink h2, .on-ink h3 { color: #fff; }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-top: var(--space-4);
  }
  .card__link:hover { color: var(--color-accent-hover); text-decoration: underline; }

  /* ---- HERO ---- */
  .hero {
    background: linear-gradient(180deg, var(--color-surface-warm), var(--color-surface));
    padding-block: var(--space-16) var(--space-24);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-16);
    align-items: start;
  }
  .hero h1 { font-size: var(--text-4xl); margin-top: var(--space-4); }
  .hero__sub { font-size: var(--text-xl); color: var(--color-text-muted); margin-top: var(--space-6); max-width: 34ch; }
  .hero__points { list-style: none; margin-top: var(--space-8); display: flex; flex-direction: column; gap: var(--space-4); }
  .hero__points li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; }
  .hero__points :global(svg) { color: var(--color-success); margin-top: 0.2rem; }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-top: var(--space-8); }
  .hero__call { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--color-accent); }
  .hero__call:hover { text-decoration: underline; }

  .hero__form {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8);
  }
  .hero__form-title { font-size: var(--text-2xl); }
  .hero__form-sub { color: var(--color-text-soft); font-size: var(--text-sm); margin: var(--space-3) 0 var(--space-6); }

  /* ---- TRUST BAR ---- */
  .trustbar { background: var(--color-surface-alt); border-block: 1px solid var(--color-border); }
  .trustbar__inner { padding-block: var(--space-8); text-align: center; }
  .trustbar__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-soft);
    margin-bottom: var(--space-4);
  }
  .trustbar__logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
  }
  .trustbar__logos img { height: 30px; width: auto; opacity: 0.75; }
  .trustbar__accred { margin-top: var(--space-6); font-size: var(--text-sm); color: var(--color-text-soft); }

  /* ---- FACILITY ---- */
  .facility__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .facility__ph { border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 4 / 3; }
  .facility__ph img { width: 100%; height: 100%; object-fit: cover; }
  .facility__ph--lead { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }

  /* ---- BELONGING ---- */
  .belonging { background: var(--color-surface-warm); }
  .belonging__inner { max-width: 62ch; }
  .belonging__inner p { margin-top: var(--space-4); font-size: var(--text-lg); color: var(--color-text-muted); }
  .belonging__inner p:first-of-type { color: var(--color-text); font-family: var(--font-display); font-size: var(--text-xl); line-height: var(--leading-snug); }

  /* ---- WHAT WE TREAT ---- */
  .treat__cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); margin-top: var(--space-8); }
  .treat__h3 { margin-bottom: var(--space-4); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .chips a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .chips a:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-tint); }
  .treat__note { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--color-text-soft); max-width: 40ch; }

  /* ---- CARD GRID (levels) ---- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .card {
    position: relative;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .card h3 { margin-bottom: var(--space-3); }
  .card h3 a::after { content: ""; position: absolute; inset: 0; }
  .card p { font-size: var(--text-sm); color: var(--color-text-muted); }
  .card__flag {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: 0.2rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-hover);
    background: var(--color-accent-tint);
    border-radius: var(--radius-sm);
  }

  /* ---- SIGNATURE ---- */
  .sig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); margin-top: var(--space-8); }
  .sig {
    padding: var(--space-8) var(--space-6);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
  }
  .sig h3 { margin-bottom: var(--space-4); font-size: var(--text-xl); }
  .sig p { color: var(--color-on-ink-muted); font-size: var(--text-sm); }
  .sig__link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: var(--space-6); font-weight: 600; font-size: var(--text-sm); color: var(--color-seaglass); }

  /* ---- WHY ---- */
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8) var(--space-6); margin-top: var(--space-8); }
  .why__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-accent-tint);
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
  .why__item h3 { margin-bottom: var(--space-2); }
  .why__item p { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ---- TEAM ---- */
  .team { background: var(--color-surface-warm); }
  .team__inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-12); align-items: start; }
  .team__list { list-style: none; display: flex; flex-direction: column; gap: var(--space-6); }
  .person { display: grid; grid-template-columns: 96px 1fr; gap: var(--space-6); align-items: start; }
  .person img { border-radius: var(--radius-md); object-fit: cover; }
  .person__name { font-family: var(--font-display); font-weight: 700; }
  .person__name span { font-family: var(--font-sans); font-weight: 500; font-size: var(--text-sm); color: var(--color-text-soft); }
  .person__role { font-size: var(--text-sm); color: var(--color-accent); font-weight: 600; margin: 0.15rem 0 0.5rem; }
  .person__bio { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ---- STEPS ---- */
  .steps__list { list-style: none; counter-reset: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); margin-top: var(--space-8); }
  .steps__n { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 800; color: var(--color-gold); }
  .steps__list h3 { margin: var(--space-3) 0 var(--space-2); }
  .steps__list p { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ---- REVIEWS ---- */
  .reviews__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-4); }
  .reviews__rating { display: flex; flex-direction: column; gap: 0.25rem; font-size: var(--text-sm); color: var(--color-text-soft); }
  .reviews__stars, .review__stars { color: var(--color-google-star); display: inline-flex; gap: 2px; }
  .reviews__grid { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); margin-top: var(--space-8); }
  .review { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .review blockquote { margin: var(--space-3) 0; color: var(--color-text-muted); }
  .review cite { font-style: normal; font-weight: 600; font-size: var(--text-sm); }
  .review cite span { font-weight: 400; color: var(--color-text-soft); }
  .reviews__disclaimer { margin-top: var(--space-6); font-size: var(--text-xs); color: var(--color-text-soft); }

  /* ---- INSURANCE BAND ---- */
  .insurance-band { background: var(--color-surface-warm); }
  .insurance-band__inner { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: var(--space-12); align-items: center; }
  .insurance-band__exclusion {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    border-left: 3px solid var(--color-seaglass);
    background: var(--color-surface);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .insurance-band__logos { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); align-items: center; }
  .insurance-band__logos img { height: 34px; width: auto; margin: 0 auto; opacity: 0.8; }

  /* ---- LOCATION ---- */
