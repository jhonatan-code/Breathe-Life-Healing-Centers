          </div>
          <div>
            <div style="font-family:'Instrument Sans',sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.012em;color:#FFFFFF;margin-bottom:12px;">Follow Us</div>
            <div style="display:grid;grid-template-columns:repeat(4,38px);gap:10px;justify-content:start;">
              {socials.map((s) => (
                <a class="social-btn" href="#footer" aria-label={s.label} title={s.label} style="display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:#16293D;color:#DCE6EF;">
                  <Icon name={s.icon} size={16} />
