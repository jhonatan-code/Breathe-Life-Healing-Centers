          <div>
            <div style="font-family:'Instrument Sans',sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.012em;color:#FFFFFF;margin-bottom:12px;">Legal</div>
            <div style="display:grid;gap:7px;font-size:14px;margin-bottom:14px;">
              <a class="footer-link" href="/privacy-policy/" style="color:#DCE6EF;">Privacy Policy</a>
              <a class="footer-link" href="/terms-of-use/" style="color:#DCE6EF;">Terms of Use</a>
