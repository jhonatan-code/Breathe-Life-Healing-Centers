---
import "../styles/global.css";
import { site } from "../config/site";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
}
const { title, description, path = "/", ogImage = "/og-default.jpg" } = Astro.props;
const canonical = new URL(path, site.domain).href;
// Share images load from the host that actually serves this build: Vercel's production domain (the .vercel.app alias
// until the real domain is attached). site.domain is still the live WordPress site, where these files 404
const prodHost = process.env.VERCEL_PROJECT_PRODUCTION_URL;
const ogImageUrl = new URL(ogImage, prodHost ? `https://${prodHost}` : site.domain).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pool and waterfall grotto at the Breathe Life Healing Centers campus in Laurel Canyon" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Montserrat:wght@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />

    <!-- Consent Mode v2 defaults (denied) must run before GTM -->
    <CookieConsent part="head" prefix="breathe" />

    <!-- Google Tag Manager -->
    <script define:vars={{ gtmId: site.gtmContainerId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", gtmId);
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtmContainerId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <CookieConsent
      prefix="breathe"
      privacyHref="/notice-of-privacy-practices/"
      privacyLabel="Notice of Privacy Practices"
      primary="#33679c"
      primaryDark="#16293d"
      text="#16293d"
      tint="#e6edf4"
      titleFont="'Instrument Sans', sans-serif"
    />
  </body>
</html>
