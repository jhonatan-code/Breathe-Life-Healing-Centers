---
import { msymChar } from "../lib/icons";
/**
 * Shell for a real /blog/{slug}/ post. Banner intentionally carries no
 * feature image or stock photo (client instruction) — the wave motif below
 * is the "distinctive" substitute approved in the Artifact preview. TOC is
 * built client-side from the real H2 headings passed in via `headings`
 * (H2 only, per client instruction — H3s are real content structure but
 * don't clutter the table of contents).
 */
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteFinalCTA from '../components/SiteFinalCTA.astro';
import BlogSidebar from '../components/blog/BlogSidebar.astro';
import BlogMobileTools from '../components/blog/BlogMobileTools.astro';
import ShareButtons from '../components/blog/ShareButtons.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import { CATEGORY_LABELS, CATEGORY_PHOTOS, getAuthor, type BlogEntry } from '../lib/blog';
import type { MarkdownHeading } from 'astro';
import { site } from '../config/site';

interface Props {
  post: BlogEntry;
  headings: MarkdownHeading[];
  related: BlogEntry[];
  minutes: number;
  canonicalUrl: string;
}
const { post, headings, related, minutes, canonicalUrl } = Astro.props;
const { data } = post;
const h2s = headings.filter((h) => h.depth === 2);
const author = getAuthor(data.author);
const categoryLabel = CATEGORY_LABELS[data.category];
const bannerPhoto = CATEGORY_PHOTOS[data.category];

// timeZone: 'UTC' matters here — z.coerce.date() parses a plain "YYYY-MM-DD"
// frontmatter value as UTC midnight, so formatting in the viewer's local
// zone can silently roll it back a day west of UTC.
const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

// BlogPosting schema. No blog post previously carried any structured data.
// publishDate/updatedDate are only included when the post's frontmatter
// actually has them (most legacy posts don't) — never fabricated.
const orgId = new URL('/#organization', site.domain).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: data.title.replace(/\s*\|\s*Breathe$/, ''),
      description: data.description,
      image: new URL(bannerPhoto, site.domain).href,
      url: canonicalUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      ...(data.publishDate ? { datePublished: data.publishDate.toISOString() } : {}),
      ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
      author: author
        ? { '@type': 'Person', name: author.name, ...(author.slug ? { url: new URL(`/about/our-team/${author.slug}/`, site.domain).href } : {}) }
        : { '@id': orgId },
      publisher: { '@id': orgId },
    },
    { '@type': 'Organization', '@id': orgId, name: site.name, url: site.domain },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.domain + '/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site.domain).href },
        { '@type': 'ListItem', position: 3, name: data.title.replace(/\s*\|\s*Breathe$/, ''), item: canonicalUrl },
      ],
    },
  ],
};
---

<Layout title={data.title} description={data.description} path={`/blog/${post.id}/`}>
  <a class="skip-link" href="#main">Skip to content</a>

  <div style="background:#F7F5F1;color:#14181C;font-family:'Instrument Sans',Helvetica,sans-serif;font-size:16px;line-height:1.5;text-wrap:pretty;">
    <SiteHeader />

    <main id="main">
      <section class="post-banner" data-screen-label="Post banner">
        <img class="banner-photo" src={bannerPhoto} alt="" />
        <div class="banner-overlay"></div>
        <div class="inner">
          <div class="banner-col">
            <nav class="crumbs" aria-label="Breadcrumb">
              <a href="/">Home</a> &rsaquo; <a href="/blog/">Blog</a> &rsaquo; <a href={`/blog/category/${data.category}/`}>{categoryLabel}</a>
            </nav>
            <span class="post-cat">{categoryLabel}</span>
            <h1>{data.title.replace(/\s*\|\s*Breathe$/, '')}</h1>
            <div class="post-byline">
              {author ? (
                <div class="author-chip">
                  <a href={`/about/our-team/${author.slug}/`} class="author-chip-top">
                    <img src={author.photo} alt={author.name} loading="lazy" />
                    <span><span class="name">{author.name}</span><br /><span class="cred">{author.role}</span></span>
                  </a>
                  {(author.authorBio || author.bio) && <p class="author-chip-bio">{author.authorBio || author.bio}</p>}
                  <a href={`/about/our-team/${author.slug}/`} class="author-chip-more">Learn more about {author.name.split(' ')[0]} &rarr;</a>
                </div>
              ) : (
                <a class="author-chip" href="/blog/"><span class="name">Breathe Team</span></a>
              )}
              <span class="byline-meta">
                {data.publishDate && <><span class="dot" aria-hidden="true">&middot;</span><span>Published {dateFmt(data.publishDate)}</span></>}
                {data.updatedDate && <><span class="dot" aria-hidden="true">&middot;</span><span>Updated {dateFmt(data.updatedDate)}</span></>}
                <span class="dot" aria-hidden="true">&middot;</span>
                <span>{minutes} min read</span>
              </span>
            </div>
            <div class="share-wrap">
              <div class="share-label">Share on</div>
              <ShareButtons url={canonicalUrl} title={data.title.replace(/\s*\|\s*Breathe$/, '')} variant="dark" />
            </div>
            <div class="mobile-toc">
              <button class="mobile-toc-toggle" id="mobile-toc-toggle" type="button" aria-expanded="false" aria-controls="toc-list-banner">
                <span class="msym" aria-hidden="true">{msymChar("list")}</span> Table of Contents
              </button>
              <div class="mobile-toc-popup" id="mobile-toc-popup">
                <ul class="toc-list" id="toc-list-banner"></ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="post-layout">
        <article class="post-content" id="post-body">
          <slot />
          <div class="post-foot-share">
            <ShareButtons url={canonicalUrl} title={data.title.replace(/\s*\|\s*Breathe$/, '')} variant="light" />
          </div>
        </article>

        <BlogSidebar related={related} />
      </div>

      <BlogMobileTools />

      {related.length > 0 && (
        <section class="related-section">
          <h2 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Related reading</h2>
          <div class="eyebrow" aria-hidden="true">Related reading</div>
          <div class="related-grid">
            {related.map((p) => <BlogCard post={p} />)}
          </div>
        </section>
      )}

      <SiteFinalCTA
        heading="Ready to talk it through?"
        subhead="Call 24/7 and talk to a real person about what you're dealing with. No pressure, no obligation."
        secondary={{ label: 'Send Us a Message', href: '/contact-us/' }}
      />
    </main>

    <SiteFooter />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </div>
</Layout>

<script define:vars={{ headingIds: h2s.map((h) => h.slug) }}>
  function buildTOC(targetId) {
    const target = document.getElementById(targetId);
    if (!target) return;
    target.innerHTML = headingIds
      .map((slug) => {
        const el = document.getElementById(slug);
        const text = el ? el.textContent : slug;
        return `<li><a href="#${slug}" data-target="${slug}">${text}</a></li>`;
      })
      .join('');
  }
  buildTOC('toc-list');
  buildTOC('toc-list-mobile');
  buildTOC('toc-list-banner');

  document.querySelectorAll('.toc-list a').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const target = a.getAttribute('data-target');
      const el = target ? document.getElementById(target) : null;
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.getElementById('tools-sheet')?.classList.remove('open');
      document.getElementById('mobile-toc-popup')?.classList.remove('open');
      document.getElementById('mobile-toc-toggle')?.setAttribute('aria-expanded', 'false');
    });
  });

  // Mobile-only "Table of Contents" toggle under the share icons, separate
  // from the persistent bottom "Article tools" sheet — a lighter-weight,
  // collapsed-by-default popup for readers who want the outline immediately.
  const mobileTocToggle = document.getElementById('mobile-toc-toggle');
  const mobileTocPopup = document.getElementById('mobile-toc-popup');
  mobileTocToggle?.addEventListener('click', () => {
    const open = mobileTocPopup?.classList.toggle('open');
    mobileTocToggle.setAttribute('aria-expanded', String(!!open));
  });

  // Mini insurance-logo marquees (sidebar + mobile sheet Coverage cards) —
  // same auto-scroll/pause-on-hover technique as SiteInsurance.astro's
  // sitewide marquee, just narrower tracks.
  if (!window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.mini-ins-wrap').forEach((wrap) => {
      const track = wrap.querySelector('.mini-ins-track');
      if (!track) return;
      const SPEED = 0.02;
      let last = 0, pos = null, paused = false;
      wrap.addEventListener('mouseenter', () => (paused = true));
      wrap.addEventListener('mouseleave', () => (paused = false));
      wrap.addEventListener('focusin', () => (paused = true));
      wrap.addEventListener('focusout', () => (paused = false));
      const step = (t) => {
        const half = track.scrollWidth / 2;
        if (last && !paused && half > 0) {
          if (pos == null) pos = track.scrollLeft;
          pos += (t - last) * SPEED;
          if (pos >= half) pos -= half;
          track.scrollLeft = pos;
        }
        last = t;
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  function onScroll() {
    let current = null;
    headingIds.forEach((slug) => {
      const el = document.getElementById(slug);
      if (el && el.getBoundingClientRect().top < 140) current = slug;
    });
    document.querySelectorAll('.toc-list a').forEach((a) => {
      a.classList.toggle('active', a.getAttribute('data-target') === current);
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .post-banner { background: #16293D; color: #fff; position: relative; overflow: hidden; padding: 54px 37px 60px; }
  .post-banner .banner-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
  .post-banner .banner-overlay { position: absolute; inset: 0; background: linear-gradient(98deg,rgba(22,41,61,0.94) 0%,rgba(22,41,61,0.82) 48%,rgba(22,41,61,0.55) 100%); }
  .post-banner .inner { position: relative; max-width: 1440px; margin: 0 auto; }
  /* No max-width cap here on purpose: the meta row (category badge, date,
     share icons) needs to reach the same full edge as every other section
     on the site, not sit confined to a narrower reading-width block. The
     headline still reads comfortably because .post-banner h1 caps its own
     width below. */
  .crumbs { font-family: 'Instrument Sans', sans-serif; font-size: 12px; color: #9DB2C2; margin-bottom: 18px; }
  .crumbs a { color: #9DB2C2; text-decoration: none; }
  .crumbs a:hover { color: #fff; }
  .post-cat { display: inline-block; font-family: 'Instrument Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #16293D; background: #7FB3BC; padding: 6px 12px; border-radius: 999px; margin-bottom: 18px; }
  .post-banner h1 { font-size: clamp(30px,4vw,46px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 600; margin: 0 0 22px; max-width: 850px; text-wrap: balance; }
  .post-byline { display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap; font-family: 'Montserrat', sans-serif; font-size: 14px; color: #C7D4DE; }
  .author-chip { display: flex; flex-direction: column; gap: 10px; max-width: 900px; text-decoration: none; }
  .author-chip:hover .name { text-decoration: underline; }
  .author-chip-top { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .author-chip-top:hover .name { text-decoration: underline; }
  .author-chip-top img { width: 44px; height: 44px; border-radius: 999px; object-fit: cover; flex: 0 0 auto; border: 1px solid #7FB3BC; }
  .author-chip .name { color: #fff; font-weight: 600; }
  .author-chip .cred { color: #9DB2C2; font-size: 12px; }
  .author-chip-bio {
    font-family: 'Montserrat', sans-serif; font-size: 13.5px; line-height: 1.55; color: #C7D4DE; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .author-chip-more { font-family: 'Instrument Sans', sans-serif; font-size: 12.5px; font-weight: 600; color: #7FB3BC; text-decoration: none; }
  .author-chip-more:hover { text-decoration: underline; }
  .byline-meta { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .dot { opacity: .5; }
  .share-wrap { margin-top: 24px; }
  .share-label { font-family: 'Instrument Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #9DB2C2; text-align: right; margin-bottom: 8px; }
  .mobile-toc { display: none; }

  /* Desktop-only byline split: author left (fixed width, now that it
     carries a 3+ line bio), category/date/share stacked right, stretched
     to the banner's full width. .post-byline dissolves via display:contents
     so its two children (author-chip, byline-meta) become direct grid
     items alongside .post-cat and .share-wrap, which otherwise live outside
     it in the DOM — grid-area placement is what lets all four reflow into
     one banner-col grid without re-ordering markup. Below 981px none of
     this applies; .post-byline stays a plain flex row exactly as before. */
  @media (min-width: 981px) {
    .banner-col {
      display: grid;
      grid-template-columns: minmax(0, 900px) 1fr;
      column-gap: 48px;
      row-gap: 10px;
      align-items: start;
      grid-template-areas:
        "crumbs crumbs"
        "h1     h1"
        "author cat"
        "author meta"
        "author share";
    }
    .crumbs { grid-area: crumbs; }
    .post-banner h1 { grid-area: h1; }
    .post-byline { display: contents; }
    .author-chip { grid-area: author; }
    .byline-meta { grid-area: meta; justify-self: end; text-align: right; }
    .byline-meta .dot:first-child { display: none; }
    .post-cat { grid-area: cat; justify-self: end; margin-bottom: 0; }
    .share-wrap { grid-area: share; justify-self: end; margin-top: 0; }
  }

  /* Content column is 1fr (fills whatever space is left after the fixed
     320px sidebar), not a fixed/capped width -- capping it at 720px kept
     it from ever exceeding a "readable" width, but also meant the
     content+sidebar block stopped short of the container's full 1440px
     on wide viewports, leaving dead space to the right of the sidebar.
     .post-content has no max-width of its own (below), so the white card
     fills this track exactly -- the sidebar still sits only the `gap`
     away from it, just at whatever width the track actually is. */
  .post-layout { max-width: 1440px; margin: 0 auto; padding: 48px 37px 0; display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; align-items: start; }
  @media (min-width: 981px) {
    .post-layout { padding-bottom: 60px; }
  }
  .post-content { font-family: 'Montserrat', sans-serif; font-size: 17px; line-height: 1.75; color: #3A444D; background: #FFFFFF; border: 1px solid #E5E1D8; border-radius: 16px; padding: 40px; }
  .post-content :global(h2) { font-family: 'Instrument Sans', sans-serif; font-size: clamp(22px,2.6vw,28px); line-height: 1.25; font-weight: 600; letter-spacing: -0.02em; color: #14181C; margin: 36px 0 14px; scroll-margin-top: 100px; }
  .post-content :global(h2:first-child) { margin-top: 0; }
  .post-content :global(h3) { font-family: 'Instrument Sans', sans-serif; font-size: 19px; line-height: 1.3; font-weight: 600; color: #14181C; margin: 28px 0 12px; scroll-margin-top: 100px; }
  .post-content :global(p) { margin: 0 0 16px; }
  .post-content :global(ul), .post-content :global(ol) { margin: 0 0 16px; padding-left: 20px; }
  .post-content :global(li) { margin-bottom: 6px; }
  .post-content :global(a) { color: #33679C; font-weight: 600; }
  .post-content :global(strong) { color: #14181C; font-weight: 600; }
  .post-content :global(blockquote) {
    margin: 24px 0; padding: 4px 0 4px 22px; border-left: 3px solid #7FB3BC;
    font-style: italic; color: #14181C;
  }
  .post-content :global(blockquote p) { margin: 0 0 6px; }
  .post-content :global(blockquote p:last-child) { margin-bottom: 0; font-style: normal; font-family: 'Instrument Sans', sans-serif; font-size: 14px; color: #646D76; }
  .post-content :global(table) {
    width: 100%; border-collapse: collapse; margin: 8px 0 24px; font-size: 15px;
  }
  .post-content :global(th), .post-content :global(td) {
    text-align: left; vertical-align: top; padding: 10px 14px; border-bottom: 1px solid #E5E1D8;
  }
  .post-content :global(th) { font-family: 'Instrument Sans', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #2C5A64; border-bottom: 2px solid #E5E1D8; }
  .post-content :global(table) { display: block; overflow-x: auto; }
  .post-foot-share { margin: 40px 0 0; }

  /* Same 3-up card grid as /blog/'s own listing (src/pages/blog/[...page].astro
     .grid), reusing the identical BlogCard component so a related post
     looks exactly like it does everywhere else on the site. */
  .related-section { max-width: 1180px; margin: 60px auto 0; padding: 0 37px 20px; }
  .related-section .eyebrow { font-family: 'Instrument Sans', sans-serif; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #2C5A64; margin-bottom: 18px; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 900px) { .related-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .related-grid { grid-template-columns: 1fr; } }

  /* Mobile-only "Table of Contents" popup under the share icons — distinct
     from BlogMobileTools.astro's persistent bottom "Article tools" sheet,
     which still holds the full TOC/Coverage/reviews set unchanged. */
  @media (max-width: 980px) {
    .mobile-toc { display: block; margin-top: 16px; }
    .mobile-toc-toggle {
      display: inline-flex; align-items: center; gap: 6px; background: none;
      border: 1px solid rgba(255,255,255,.25); color: #C7D4DE;
      font-family: 'Instrument Sans', sans-serif; font-size: 12.5px; font-weight: 600;
      padding: 7px 14px; border-radius: 999px; cursor: pointer;
    }
    .mobile-toc-toggle .msym { font-size: 16px; }
    .mobile-toc-popup { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
    .mobile-toc-popup.open { max-height: 260px; margin-top: 10px; }
    .mobile-toc-popup .toc-list {
      list-style: none; margin: 0; padding: 14px 16px; background: rgba(255,255,255,.06);
      border-radius: 10px; display: flex; flex-direction: column; gap: 9px;
      font-family: 'Montserrat', sans-serif; font-size: 14px;
    }
    .mobile-toc-popup .toc-list a { text-decoration: none; color: #C7D4DE; display: block; padding: 2px 0 2px 12px; border-left: 2px solid rgba(255,255,255,.2); }
    .mobile-toc-popup .toc-list a.active { color: #fff; font-weight: 600; border-left-color: #7FB3BC; }
  }

  @media (max-width: 980px) {
    .post-layout { grid-template-columns: 1fr; padding-bottom: 30px; }
  }
  @media (max-width: 640px) {
    .post-layout { padding-inline: 20px; }
    .post-content { padding: 24px; }
    .related-section { padding-inline: 20px; }
  }
</style>
